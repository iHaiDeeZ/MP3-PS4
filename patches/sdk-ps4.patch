diff --git a/include/rex/system/wait_report.h b/include/rex/system/wait_report.h
new file mode 100644
index 0000000..c61133d
--- /dev/null
+++ b/include/rex/system/wait_report.h
@@ -0,0 +1,58 @@
+/**
+ * @file        rex/system/wait_report.h
+ * @brief       The guest threads' current waits, reported in the log when they last
+ *
+ * mgr-ps4 (2026-11-04): Metal Gear Rising stops at the start of a cutscene with every guest thread asleep; a sampling
+ * profile names only the host side of those waits. Each guest wait (XObject::Wait, WaitMultiple, SignalAndWait,
+ * XThread::Delay) records here what it waits on and who called it: the kernel export's caller, whose host return
+ * address REX_HOOK stores (a code address in the generated guest function: symbolize it with the build's ELF, address
+ * minus the eboot's text start), and the guest link register. Every kernel_wait_report_s seconds a "[waits]" block
+ * lists each guest thread waiting for 2 s or more (kernel_wait_report, off: nothing recorded).
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace rex::system {
+
+class XObject;
+
+namespace wait_report {
+
+enum class Kind : uint32_t { kNone, kWait, kWaitAny, kWaitAll, kSignalAndWait, kDelay };
+
+constexpr uint32_t kMaxObjects = 4;
+
+// One guest thread's current wait (XThread::wait_record): written by the thread, read by the report.
+struct Record {
+  std::atomic<uint64_t> since_ns{0};  // 0: not waiting
+  std::atomic<uint32_t> kind{0};
+  std::atomic<uint32_t> count{0};
+  std::atomic<uint32_t> handles[kMaxObjects] = {};
+  std::atomic<uint32_t> types[kMaxObjects] = {};
+  std::atomic<uint64_t> host_caller{0};
+  std::atomic<uint32_t> guest_lr{0};
+  std::atomic<uint32_t> alertable{0};
+  std::atomic<int64_t> timeout_ms{-1};
+};
+
+// The host return address of the current kernel export's caller, stored by REX_HOOK. GNU __thread, not thread_local:
+// an extern thread_local gets a weak reference to its TLS init function, which create-fself refuses as an import.
+extern __thread const void* g_export_caller;
+
+// The current guest thread's wait begins / ends.
+void Begin(Kind kind, XObject* const* objects, uint32_t count, bool alertable, int64_t timeout_ms);
+void End();
+
+// The "[waits]" block now: every guest thread in a wait of at least min_ms.
+void Report(uint64_t min_ms);
+
+}  // namespace wait_report
+}  // namespace rex::system
+
+#define REX_WAIT_REPORT_CALLER() (::rex::system::wait_report::g_export_caller = __builtin_return_address(0))
