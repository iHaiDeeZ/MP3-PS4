+  if (copia.modos.x == 1) {
+    return vec4(lessThanEqual(abs(t), tope)) * t;  // NaN compares false: 0
+  }
+  return vec4(greaterThan(t, vec4(0.0))) * min(t, tope);  // NaN compares false: 0
+}
