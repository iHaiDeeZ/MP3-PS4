new file mode 100644
index 0000000..db9a175
--- /dev/null
+++ b/src/core/dynlib_ps4.cpp
@@ -0,0 +1,46 @@
+/**
+ * @file        rex/core/dynlib_ps4.cpp
+ * @brief       rex::platform::DynamicLibrary on the PS4: everything is linked into the eboot
+ *
+ * Homebrew has no dlopen for its own libraries (sceKernelLoadStartModule takes signed .sprx
+ * modules only), and the PS4 build links the GPU back end and the runtime statically, so every
+ * Load fails cleanly and callers take their built-in path.
+ */
+
+#include <rex/platform.h>
+#include <rex/platform/dynlib.h>
+
+static_assert(REX_PLATFORM_PS4, "This file is PS4-only");
+
+namespace rex::platform {
+
+DynamicLibrary::~DynamicLibrary() { Close(); }
+
+DynamicLibrary::DynamicLibrary(DynamicLibrary&& other) noexcept : handle_(other.handle_) {
+  other.handle_ = nullptr;
+}
+
+DynamicLibrary& DynamicLibrary::operator=(DynamicLibrary&& other) noexcept {
+  if (this != &other) {
+    Close();
+    handle_ = other.handle_;
+    other.handle_ = nullptr;
+  }
+  return *this;
+}
+
+bool DynamicLibrary::Load(const std::filesystem::path& path, SymbolResolution mode) {
+  (void)path;
+  (void)mode;
+  Close();
+  return false;
+}
+
+void DynamicLibrary::Close() { handle_ = nullptr; }
+
+void* DynamicLibrary::GetRawSymbol(const char* name) const {
+  (void)name;
+  return nullptr;
+}
+
+}  // namespace rex::platform
diff --git a/src/core/exception_handler_ps4.cpp b/src/core/exception_handler_ps4.cpp
new file mode 100644
index 0000000..e86b30d
--- /dev/null
+++ b/src/core/exception_handler_ps4.cpp
@@ -0,0 +1,270 @@
+/**
+ * @file        rex/core/exception_handler_ps4.cpp
+ * @brief       Host exception handler for the PS4 (FreeBSD signal context, x86-64)
+ *
+ * Same contract as exception_handler_posix.cpp: SIGSEGV/SIGBUS/SIGILL are turned into an
+ * Exception and offered to the installed handlers (the MMIO handler, the write watches). Three
+ * things differ:
+ *
+ *   - The context is FreeBSD's mcontext (mc_rip, mc_err, ...), as laid out by the kit's libc
+ *     overlay; the XMM registers are in the FXSAVE area in mc_fpstate.
+ *   - Guest permissions are per 4 KiB page but the kernel's are per 16 KiB (guest_memory_ps4.h).
+ *     A fault that the 4 KiB page's own permission allows is a sibling fault: its 16 KiB page is
+ *     opened for one instruction (trap flag) and closed again in SIGTRAP. Xenia's handlers never
+ *     see these faults.
+ *   - A fault nobody handles goes to the handler that was installed before (the kit's crash log),
+ *     instead of returning and faulting again forever.
+ */
+
+#include <rex/exception_handler.h>
+
+#if REX_PLATFORM_PS4
+
+#include <signal.h>
+
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+
+#include <rex/assert.h>
+#include <rex/logging.h>
+#include <rex/math.h>
+#include <rex/platform.h>
+
+#include "guest_memory_ps4.h"
+
+namespace rex::arch {
+
+namespace {
+
+bool signal_handlers_installed_ = false;
+struct sigaction original_sigill_handler_;
+struct sigaction original_sigsegv_handler_;
+struct sigaction original_sigbus_handler_;
+struct sigaction original_sigtrap_handler_;
+
+constexpr size_t kMaxHandlerCount = 8;
+std::pair<ExceptionHandler::Handler, void*> handlers_[kMaxHandlerCount];
+
+constexpr uint64_t kTrapFlag = 0x100;
+constexpr uint64_t kPageFaultWrite = 1u << 1;  // x86 page fault error code: W/R
+constexpr size_t kFxsaveXmmOffset = 160;       // XMM0 in the FXSAVE layout
+
+// Pages opened for the instruction this thread is single-stepping (an unaligned access may touch
+// two).
+struct SteppedPages {
+  uint64_t page[2];
+  int count;
+};
+thread_local SteppedPages t_stepped{};
+
+constexpr uint64_t kHwPageSize = 0x4000;  // the PS4 kernel's page (guest_memory_ps4.cpp's kHwPage)
+SiblingWatchHandler g_sibling_watch_fn = nullptr;
+void* g_sibling_watch_data = nullptr;
+std::atomic<uint64_t> g_sibling_steps{0};
+std::atomic<uint64_t> g_sibling_opens{0};
+std::atomic<uint64_t> g_handled_faults{0};
+
+void ChainOriginal(const struct sigaction& original, int signal_number, siginfo_t* info,
+                   void* context) {
+  if ((original.sa_flags & SA_SIGINFO) && original.sa_sigaction) {
+    original.sa_sigaction(signal_number, info, context);
+    return;
+  }
+  if (original.sa_handler != SIG_IGN && original.sa_handler != SIG_DFL && original.sa_handler) {
+    original.sa_handler(signal_number);
+    return;
+  }
+  // Default action: put it back and let the fault happen again.
+  sigaction(signal_number, &original, nullptr);
+}
+
+const struct sigaction& OriginalFor(int signal_number) {
+  switch (signal_number) {
+    case SIGILL:
+      return original_sigill_handler_;
+    case SIGBUS:
+      return original_sigbus_handler_;
+    case SIGTRAP:
+      return original_sigtrap_handler_;
+    default:
+      return original_sigsegv_handler_;
+  }
+}
+
+uint8_t* XmmArea(mcontext_t& mc) {
+  return reinterpret_cast<uint8_t*>(mc.mc_fpstate) + kFxsaveXmmOffset;
+}
+
+// The end of a single step: close what was opened.
+bool FinishStep(mcontext_t& mc) {
+  if (t_stepped.count == 0) return false;
+  for (int i = 0; i < t_stepped.count; ++i) {
+    RexGmSetHardware(t_stepped.page[i], RexGmHardwareAt(t_stepped.page[i]));
+  }
+  t_stepped.count = 0;
+  mc.mc_rflags &= ~kTrapFlag;
+  return true;
+}
+
+bool TrySiblingFault(mcontext_t& mc, uint64_t address, bool is_write) {
+  uint64_t page = 0;
+  RexGmAccess restore = REX_GM_NONE;
+  if (t_stepped.count == 2 || !RexGmSiblingFault(address, is_write, &page, &restore)) {
+    return false;
+  }
+  (void)restore;  // recomputed when the step ends, in case the permissions changed meanwhile
+  // A neighbour closed by a write watch: fire the watches of the whole 16 KiB page and run the store again on the
+  // open page (exception_handler.h). Not while stepping (the page this thread opened is closed when the step ends).
+  if (is_write && t_stepped.count == 0 && g_sibling_watch_fn &&
+      g_sibling_watch_fn(g_sibling_watch_data, reinterpret_cast<void*>(address & ~(kHwPageSize - 1)), kHwPageSize) &&
+      RexGmHardwareAt(address) == REX_GM_WRITE) {
+    g_sibling_opens.fetch_add(1, std::memory_order_relaxed);
+    return true;
+  }
+  if (!RexGmSetHardware(page, is_write ? REX_GM_WRITE : REX_GM_READ)) return false;
+  t_stepped.page[t_stepped.count++] = page;
+  mc.mc_rflags |= kTrapFlag;
+  g_sibling_steps.fetch_add(1, std::memory_order_relaxed);
+  return true;
+}
+
+void ExceptionHandlerCallback(int signal_number, siginfo_t* signal_info, void* signal_context) {
+  mcontext_t& mc = reinterpret_cast<ucontext_t*>(signal_context)->uc_mcontext;
+
+  if (signal_number == SIGTRAP) {
+    if (!FinishStep(mc)) ChainOriginal(original_sigtrap_handler_, signal_number, signal_info,
+                                       signal_context);
+    return;
+  }
+
+  uint64_t fault_address = reinterpret_cast<uint64_t>(signal_info->si_addr);
+  if (!fault_address) fault_address = static_cast<uint64_t>(mc.mc_addr);
+  const bool is_write = (static_cast<uint64_t>(mc.mc_err) & kPageFaultWrite) != 0;
+
+  if ((signal_number == SIGSEGV || signal_number == SIGBUS) &&
+      TrySiblingFault(mc, fault_address, is_write)) {
+    return;
+  }
+
+  HostThreadContext thread_context;
+  thread_context.rip = uint64_t(mc.mc_rip);
+  thread_context.eflags = uint32_t(mc.mc_rflags);
+  thread_context.rax = uint64_t(mc.mc_rax);
+  thread_context.rcx = uint64_t(mc.mc_rcx);
+  thread_context.rdx = uint64_t(mc.mc_rdx);
+  thread_context.rbx = uint64_t(mc.mc_rbx);
+  thread_context.rsp = uint64_t(mc.mc_rsp);
+  thread_context.rbp = uint64_t(mc.mc_rbp);
+  thread_context.rsi = uint64_t(mc.mc_rsi);
+  thread_context.rdi = uint64_t(mc.mc_rdi);
+  thread_context.r8 = uint64_t(mc.mc_r8);
+  thread_context.r9 = uint64_t(mc.mc_r9);
+  thread_context.r10 = uint64_t(mc.mc_r10);
+  thread_context.r11 = uint64_t(mc.mc_r11);
+  thread_context.r12 = uint64_t(mc.mc_r12);
+  thread_context.r13 = uint64_t(mc.mc_r13);
+  thread_context.r14 = uint64_t(mc.mc_r14);
+  thread_context.r15 = uint64_t(mc.mc_r15);
+  std::memcpy(thread_context.xmm_registers, XmmArea(mc), sizeof(thread_context.xmm_registers));
+
+  Exception ex;
+  if (signal_number == SIGILL) {
+    ex.InitializeIllegalInstruction(&thread_context);
+  } else {
+    ex.InitializeAccessViolation(&thread_context, fault_address,
+                                 is_write ? Exception::AccessViolationOperation::kWrite
+                                          : Exception::AccessViolationOperation::kRead);
+  }
+
+  for (size_t i = 0; i < rex::countof(handlers_) && handlers_[i].first; ++i) {
+    if (!handlers_[i].first(&ex, handlers_[i].second)) continue;
+    g_handled_faults.fetch_add(1, std::memory_order_relaxed);
+    mc.mc_rip = static_cast<long>(thread_context.rip);
+    mc.mc_rflags = static_cast<long>(thread_context.eflags);
+    // The order matches X64Register.
+    long* const int_registers[] = {
+        &mc.mc_rax, &mc.mc_rcx, &mc.mc_rdx, &mc.mc_rbx, &mc.mc_rsp, &mc.mc_rbp,
+        &mc.mc_rsi, &mc.mc_rdi, &mc.mc_r8,  &mc.mc_r9,  &mc.mc_r10, &mc.mc_r11,
+        &mc.mc_r12, &mc.mc_r13, &mc.mc_r14, &mc.mc_r15,
+    };
+    uint32_t index;
+    uint16_t ints = ex.modified_int_registers();
+    while (rex::bit_scan_forward(ints, &index)) {
+      ints &= ~(UINT16_C(1) << index);
+      *int_registers[index] = static_cast<long>(thread_context.int_registers[index]);
+    }
+    uint16_t xmms = ex.modified_xmm_registers();
+    while (rex::bit_scan_forward(xmms, &index)) {
+      xmms &= ~(UINT16_C(1) << index);
+      std::memcpy(XmmArea(mc) + index * sizeof(vec128_t), &thread_context.xmm_registers[index],
+                  sizeof(vec128_t));
+    }
+    return;
+  }
+
+  ChainOriginal(OriginalFor(signal_number), signal_number, signal_info, signal_context);
+}
+
+}  // namespace
+
+void SetSiblingWatchHandler(SiblingWatchHandler fn, void* data) {
+  g_sibling_watch_data = data;
+  g_sibling_watch_fn = fn;
+}
+
+FaultCounts GetFaultCounts() {
+  return {g_sibling_steps.load(std::memory_order_relaxed), g_sibling_opens.load(std::memory_order_relaxed),
+          g_handled_faults.load(std::memory_order_relaxed)};
+}
+
+void ExceptionHandler::Install(Handler fn, void* data) {
+  if (!signal_handlers_installed_) {
+    struct sigaction signal_handler;
+    std::memset(&signal_handler, 0, sizeof(signal_handler));
+    signal_handler.sa_sigaction = ExceptionHandlerCallback;
+    signal_handler.sa_flags = SA_SIGINFO;
+    sigemptyset(&signal_handler.sa_mask);
+    if (sigaction(SIGILL, &signal_handler, &original_sigill_handler_) != 0) {
+      assert_always("Failed to install new SIGILL handler");
+    }
+    if (sigaction(SIGSEGV, &signal_handler, &original_sigsegv_handler_) != 0) {
+      assert_always("Failed to install new SIGSEGV handler");
+    }
+    // FreeBSD raises SIGBUS for some protection faults on mapped pages.
+    if (sigaction(SIGBUS, &signal_handler, &original_sigbus_handler_) != 0) {
+      assert_always("Failed to install new SIGBUS handler");
+    }
+    if (sigaction(SIGTRAP, &signal_handler, &original_sigtrap_handler_) != 0) {
+      assert_always("Failed to install new SIGTRAP handler");
+    }
+    signal_handlers_installed_ = true;
+  }
+
+  for (size_t i = 0; i < rex::countof(handlers_); ++i) {
+    if (!handlers_[i].first) {
+      handlers_[i].first = fn;
+      handlers_[i].second = data;
+      return;
+    }
+  }
+  assert_always("Too many exception handlers installed");
+}
+
+void ExceptionHandler::Uninstall(Handler fn, void* data) {
+  for (size_t i = 0; i < rex::countof(handlers_); ++i) {
+    if (handlers_[i].first == fn && handlers_[i].second == data) {
+      for (; i < rex::countof(handlers_) - 1; ++i) {
+        handlers_[i] = handlers_[i + 1];
+      }
+      handlers_[i].first = nullptr;
+      handlers_[i].second = nullptr;
+      break;
+    }
+  }
+  // The handlers stay installed: sibling faults are handled even when Xenia's are gone.
+}
+
+}  // namespace rex::arch
+
+#endif  // REX_PLATFORM_PS4
diff --git a/src/core/fiber_ps4.cpp b/src/core/fiber_ps4.cpp
new file mode 100644
index 0000000..b93d78a
--- /dev/null
+++ b/src/core/fiber_ps4.cpp
@@ -0,0 +1,117 @@
+/**
+ * @file        rex/core/fiber_ps4.cpp
+ * @brief       PS4 backend for rex::thread::Fiber: an x86-64 System V context switch
+ *
+ * libkernel has getcontext/swapcontext but no makecontext, so fibers switch stacks here. A switch
+ * is a call: the caller-saved registers are already saved by the compiler, and the callee-saved
+ * ones (rbx, rbp, r12-r15, MXCSR, the x87 control word) are pushed on the fiber's own stack. The
+ * Fiber keeps only its stack pointer.
+ *
+ * A new fiber's stack is laid out as if it had switched away just before calling
+ * rex_ps4_fiber_entry, from the top (16-byte aligned) down:
+ *
+ *   top-8    0                       fake return address of rex_ps4_fiber_entry
+ *   top-16   rex_ps4_fiber_entry     where the switch's ret goes
+ *   top-24   rbp = 0
+ *   top-32   rbx, r12, r13, r14, r15 = 0
+ *   top-72   MXCSR 0x1F80 | x87 control word 0x037F << 32
+ *
+ * After the ret, rsp = top-8, which is what a called function expects (rsp % 16 == 8).
+ */
+
+#include <rex/platform.h>
+#if REX_PLATFORM_PS4
+
+#include <rex/thread/fiber.h>
+
+#include <cassert>
+#include <cstdlib>
+
+// rex_ps4_fiber_switch(uint64_t* save_rsp, uint64_t load_rsp)
+asm(R"(
+    .text
+    .globl rex_ps4_fiber_switch
+    .type rex_ps4_fiber_switch, @function
+    .p2align 4
+rex_ps4_fiber_switch:
+    pushq %rbp
+    pushq %rbx
+    pushq %r12
+    pushq %r13
+    pushq %r14
+    pushq %r15
+    subq $8, %rsp
+    stmxcsr (%rsp)
+    fnstcw 4(%rsp)
+    movq %rsp, (%rdi)
+    movq %rsi, %rsp
+    ldmxcsr (%rsp)
+    fldcw 4(%rsp)
+    addq $8, %rsp
+    popq %r15
+    popq %r14
+    popq %r13
+    popq %r12
+    popq %rbx
+    popq %rbp
+    ret
+    .size rex_ps4_fiber_switch, . - rex_ps4_fiber_switch
+)");
+
+extern "C" void rex_ps4_fiber_switch(uint64_t* save_rsp, uint64_t load_rsp);
+
+extern "C" [[noreturn]] void rex_ps4_fiber_entry(void) {
+  // SwitchTo set tls_current_ before switching here.
+  rex::thread::Fiber* f = rex::thread::Fiber::tls_current_;
+  f->entry_(f->arg_);
+  // A guest fiber's entry never returns (it switches away for good); if it does, nothing could
+  // be resumed from here.
+  std::abort();
+}
+
+namespace rex::thread {
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+Fiber* Fiber::ConvertCurrentThread() {
+  auto* f = new Fiber();
+  f->is_thread_fiber_ = true;
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  f->stack_.resize(stack_size);
+
+  const uintptr_t top =
+      (reinterpret_cast<uintptr_t>(f->stack_.data()) + f->stack_.size()) & ~uintptr_t(15);
+  uint64_t* sp = reinterpret_cast<uint64_t*>(top);
+  *--sp = 0;                                               // fake return address
+  *--sp = reinterpret_cast<uint64_t>(&rex_ps4_fiber_entry); // ret target
+  for (int i = 0; i < 6; ++i) *--sp = 0;                   // rbp, rbx, r12-r15
+  *--sp = 0x1F80ull | (0x037Full << 32);                   // MXCSR, x87 control word
+  f->rsp_ = reinterpret_cast<uint64_t>(sp);
+  return f;
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  Fiber* from = tls_current_;
+  tls_current_ = target;
+  rex_ps4_fiber_switch(&from->rsp_, target->rsp_);
+}
+
+void Fiber::Destroy() {
+  if (is_thread_fiber_) {
+    tls_current_ = nullptr;
+  } else {
+    assert(this != tls_current_ && "Destroy called on the currently running fiber");
+  }
+  delete this;
+}
+
+}  // namespace rex::thread
+
+#endif  // REX_PLATFORM_PS4
