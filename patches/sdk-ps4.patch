+namespace {
+// rex_archivos_ocultos: does the path contain one of the listed pieces (case-insensitive)?
+bool RutaOculta(std::string_view ruta) {
+  const std::string lista = REXCVAR_GET(rex_archivos_ocultos);
+  if (lista.empty()) return false;
+  std::string baja(ruta);
+  for (char& c : baja) c = char(std::tolower(static_cast<unsigned char>(c)));
+  size_t inicio = 0;
+  while (inicio <= lista.size()) {
+    size_t fin = lista.find(',', inicio);
+    if (fin == std::string::npos) fin = lista.size();
+    std::string pieza = lista.substr(inicio, fin - inicio);
+    for (char& c : pieza) c = char(std::tolower(static_cast<unsigned char>(c)));
+    if (!pieza.empty() && baja.find(pieza) != std::string::npos) return true;
+    inicio = fin + 1;
+  }
+  return false;
+}
