diff --git a/src/core/guest_memory_ps4.cpp b/src/core/guest_memory_ps4.cpp
new file mode 100644
index 0000000..7644b74
--- /dev/null
+++ b/src/core/guest_memory_ps4.cpp
@@ -0,0 +1,390 @@
+/*
+ * Guest memory on the PS4. The design is in guest_memory_ps4.h.
+ */
+
+#include "guest_memory_ps4.h"
+
+#if defined(__PS4__)
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#include <pthread.h>
+#include <sys/types.h>
+
+// Declared by hand: several OpenOrbis prototypes are wrong (same list as DolphinPS4's MemArenaPS4).
+extern "C" {
+size_t sceKernelGetDirectMemorySize();
+int32_t sceKernelAllocateDirectMemory(off_t search_start, off_t search_end, size_t length,
+                                      size_t alignment, int32_t memory_type, off_t* physical_out);
+int32_t sceKernelReleaseDirectMemory(off_t start, size_t length);
+int32_t sceKernelMapDirectMemory(void** address, size_t length, int32_t protection, int32_t flags,
+                                 off_t direct_memory_start, size_t alignment);
+int32_t sceKernelReserveVirtualRange(void** address, size_t length, int32_t flags,
+                                     size_t alignment);
+int32_t sceKernelMunmap(void* address, size_t length);
+int32_t sceKernelMprotect(const void* address, size_t length, int32_t protection);
+int32_t sceKernelEnableDmemAliasing();
+int32_t sceKernelEnableDmemAliasing2();
+}
+
+namespace {
+
+constexpr size_t kPage = 0x1000;     // Xenia's page: logical permissions
+constexpr size_t kHwPage = 0x4000;   // the PS4 kernel's page: real permissions
+constexpr size_t kChunk = 0x10000;   // unit of backing (direct memory allocation alignment)
+constexpr size_t kSubPages = kHwPage / kPage;
+constexpr int32_t kWbOnion = 0;
+constexpr int32_t kMapFixed = 0x10;
+constexpr int32_t kProtNone = 0;
+constexpr int32_t kProtRead = 0x1;
+constexpr int32_t kProtRw = 0x3;
+constexpr size_t kMaxViews = 16;
+
+struct View {
+  size_t window_offset;  // where it starts, from the window base
+  size_t backing_offset; // what it shows
+  size_t length;
+};
+
+uint8_t* g_base = nullptr;
+size_t g_size = 0;
+off_t* g_chunk_phys = nullptr;           // backing chunk -> direct memory, -1 if not committed
+std::atomic<uint8_t>* g_access = nullptr; // window 4 KiB page -> RexGmAccess
+View g_views[kMaxViews];
+std::atomic<size_t> g_view_count{0};
+pthread_mutex_t g_lock = PTHREAD_MUTEX_INITIALIZER;
+std::atomic<size_t> g_committed{0};
+std::atomic<size_t> g_sibling_faults{0};
+std::atomic<uint32_t> g_last_result{0};
+
+int32_t ToProt(RexGmAccess a) {
+  return a == REX_GM_WRITE ? kProtRw : a == REX_GM_READ ? kProtRead : kProtNone;
+}
+
+// The permission a 16 KiB page can have: the most restrictive of its 4 KiB pages, ignoring the
+// ones with no access (an unallocated neighbour must not make a whole page fault).
+RexGmAccess HardwareAccess(size_t window_offset) {
+  const size_t first = (window_offset & ~(kHwPage - 1)) / kPage;
+  int result = REX_GM_WRITE;
+  bool any = false;
+  for (size_t i = 0; i < kSubPages; ++i) {
+    const int a = g_access[first + i].load(std::memory_order_relaxed);
+    if (a == REX_GM_NONE) continue;
+    any = true;
+    if (a < result) result = a;
+  }
+  return any ? static_cast<RexGmAccess>(result) : REX_GM_NONE;
+}
+
+int FindView(size_t window_offset) {
+  const size_t n = g_view_count.load(std::memory_order_acquire);
+  for (size_t i = 0; i < n; ++i) {
+    const View& v = g_views[i];
+    if (window_offset >= v.window_offset && window_offset - v.window_offset < v.length) {
+      return static_cast<int>(i);
+    }
+  }
+  return -1;
+}
+
+bool ToBacking(size_t window_offset, size_t* backing) {
+  const int i = FindView(window_offset);
+  if (i < 0) return false;
+  *backing = g_views[i].backing_offset + (window_offset - g_views[i].window_offset);
+  return true;
+}
+
+bool Committed(size_t backing_offset) {
+  return backing_offset < g_size && g_chunk_phys[backing_offset / kChunk] >= 0;
+}
+
+// Real permissions for the mapped pages of [w0, w1) (window offsets, 16 KiB aligned), merging
+// runs of the same permission into one call.
+void ApplyHardware(size_t w0, size_t w1) {
+  size_t run_start = 0, run_end = 0;
+  int32_t run_prot = -1;
+  auto flush = [&]() {
+    if (run_prot >= 0 && run_end > run_start) {
+      const int32_t r = sceKernelMprotect(g_base + run_start, run_end - run_start, run_prot);
+      if (r != 0) g_last_result = static_cast<uint32_t>(r);
+    }
+    run_prot = -1;
+  };
+  for (size_t w = w0; w < w1; w += kHwPage) {
+    size_t backing = 0;
+    if (!ToBacking(w, &backing) || !Committed(backing)) {
+      flush();
+      continue;
+    }
+    const int32_t prot = ToProt(HardwareAccess(w));
+    if (prot != run_prot || w != run_end) {
+      flush();
+      run_start = w;
+      run_prot = prot;
+    }
+    run_end = w + kHwPage;
+  }
+  flush();
+}
+
+// Maps the committed chunks of backing [b0, b1) (chunk aligned) into view i, merging chunks whose
+// direct memory is contiguous, then applies the view's permissions.
+bool MapIntoView(size_t i, size_t b0, size_t b1) {
+  const View& v = g_views[i];
+  const size_t lo = b0 > v.backing_offset ? b0 : v.backing_offset;
+  const size_t hi = b1 < v.backing_offset + v.length ? b1 : v.backing_offset + v.length;
+  if (lo >= hi) return true;
+  bool ok = true;
+  size_t c = lo / kChunk;
+  const size_t c_end = (hi + kChunk - 1) / kChunk;
+  while (c < c_end) {
+    if (g_chunk_phys[c] < 0) {
+      ++c;
+      continue;
+    }
+    size_t n = 1;
+    while (c + n < c_end && g_chunk_phys[c + n] == g_chunk_phys[c] + off_t(n * kChunk)) ++n;
+    void* addr = g_base + v.window_offset + (c * kChunk - v.backing_offset);
+    const int32_t r =
+        sceKernelMapDirectMemory(&addr, n * kChunk, kProtNone, kMapFixed, g_chunk_phys[c], kChunk);
+    if (r != 0) {
+      g_last_result = static_cast<uint32_t>(r);
+      ok = false;
+    }
+    c += n;
+  }
+  const size_t w0 = v.window_offset + (lo - v.backing_offset);
+  const size_t w1 = v.window_offset + (hi - v.backing_offset);
+  ApplyHardware(w0 & ~(kHwPage - 1), (w1 + kHwPage - 1) & ~(kHwPage - 1));
+  return ok;
+}
+
+// New direct memory, zeroed through a private mapping before any view can see it.
+bool AllocateZeroed(size_t length, off_t* phys) {
+  const int32_t r = sceKernelAllocateDirectMemory(
+      0, static_cast<off_t>(sceKernelGetDirectMemorySize()), length, kChunk, kWbOnion, phys);
+  if (r != 0) {
+    g_last_result = static_cast<uint32_t>(r);
+    return false;
+  }
+  void* scratch = nullptr;
+  const int32_t m = sceKernelMapDirectMemory(&scratch, length, kProtRw, 0, *phys, kChunk);
+  if (m != 0) {
+    g_last_result = static_cast<uint32_t>(m);
+    sceKernelReleaseDirectMemory(*phys, length);
+    return false;
+  }
+  std::memset(scratch, 0, length);
+  sceKernelMunmap(scratch, length);
+  return true;
+}
+
+}  // namespace
+
+extern "C" {
+
+uint8_t* RexGmInit(size_t size) {
+  if (g_base) return g_base;
+  size = (size + kChunk - 1) & ~(kChunk - 1);
+  // Without this the kernel refuses a second mapping of the same direct memory (EBUSY).
+  const int32_t a1 = sceKernelEnableDmemAliasing();
+  const int32_t a2 = a1 == 0 ? 0 : sceKernelEnableDmemAliasing2();
+  void* base = nullptr;
+  const int32_t r = sceKernelReserveVirtualRange(&base, size, 0, kChunk);
+  std::fprintf(stderr, "[gm] aliasing %#x/%#x, reserve %#zx bytes: %#x at %p\n",
+               static_cast<uint32_t>(a1), static_cast<uint32_t>(a2), size,
+               static_cast<uint32_t>(r), base);
+  if (r != 0) {
+    g_last_result = static_cast<uint32_t>(r);
+    return nullptr;
+  }
+  const size_t chunks = size / kChunk;
+  const size_t pages = size / kPage;
+  g_chunk_phys = static_cast<off_t*>(std::malloc(chunks * sizeof(off_t)));
+  g_access = static_cast<std::atomic<uint8_t>*>(std::calloc(pages, 1));
+  if (!g_chunk_phys || !g_access) {
+    std::free(g_chunk_phys);
+    std::free(g_access);
+    g_chunk_phys = nullptr;
+    g_access = nullptr;
+    sceKernelMunmap(base, size);
+    return nullptr;
+  }
+  for (size_t i = 0; i < chunks; ++i) g_chunk_phys[i] = -1;
+  g_size = size;
+  g_base = static_cast<uint8_t*>(base);
+  return g_base;
+}
+
+void RexGmShutdown(void) {
+  if (!g_base) return;
+  pthread_mutex_lock(&g_lock);
+  sceKernelMunmap(g_base, g_size);
+  for (size_t c = 0; c < g_size / kChunk; ++c) {
+    if (g_chunk_phys[c] >= 0) sceKernelReleaseDirectMemory(g_chunk_phys[c], kChunk);
+  }
+  std::free(g_chunk_phys);
+  std::free(g_access);
+  g_chunk_phys = nullptr;
+  g_access = nullptr;
+  g_base = nullptr;
+  g_size = 0;
+  g_view_count = 0;
+  g_committed = 0;
+  pthread_mutex_unlock(&g_lock);
+}
+
+uint8_t* RexGmBase(void) { return g_base; }
+size_t RexGmSize(void) { return g_size; }
+
+bool RexGmWindowToOffset(uint64_t window_address, size_t* offset_out) {
+  const uint64_t base = reinterpret_cast<uint64_t>(g_base);
+  if (!g_base || window_address < base || window_address - base >= g_size) return false;
+  return ToBacking(window_address - base, offset_out);
+}
+
+bool RexGmAddView(uint8_t* base, size_t offset, size_t length, RexGmAccess access) {
+  if (!g_base || base < g_base || base + length > g_base + g_size || offset + length > g_size ||
+      ((base - g_base) % kChunk) != 0 || (offset % kChunk) != 0) {
+    g_last_result = REX_GM_ERR_RANGE;
+    return false;
+  }
+  pthread_mutex_lock(&g_lock);
+  const size_t n = g_view_count.load(std::memory_order_relaxed);
+  if (n == kMaxViews) {
+    pthread_mutex_unlock(&g_lock);
+    g_last_result = REX_GM_ERR_NOVIEW;
+    return false;
+  }
+  g_views[n] = View{static_cast<size_t>(base - g_base), offset, length};
+  // v00.01 started every view at no access and opened only what was allocated through that view: Renut's
+  // RegisterGuestShader then faulted (SEGV_ACCERR) copying a shader the game had put in physical memory
+  // through another window.
+  const size_t w0 = static_cast<size_t>(base - g_base);
+  for (size_t p = w0 / kPage; p < (w0 + length) / kPage; ++p) {
+    g_access[p].store(static_cast<uint8_t>(access), std::memory_order_relaxed);
+  }
+  g_view_count.store(n + 1, std::memory_order_release);
+  const bool ok = MapIntoView(n, offset, offset + length);
+  pthread_mutex_unlock(&g_lock);
+  return ok;
+}
+
+bool RexGmCommit(size_t offset, size_t length) {
+  if (!g_base || length == 0 || offset + length > g_size) {
+    g_last_result = REX_GM_ERR_RANGE;
+    return false;
+  }
+  const size_t c0 = offset / kChunk;
+  const size_t c1 = (offset + length + kChunk - 1) / kChunk;
+  pthread_mutex_lock(&g_lock);
+  bool ok = true;
+  size_t new_lo = SIZE_MAX, new_hi = 0;
+  for (size_t c = c0; c < c1;) {
+    if (g_chunk_phys[c] >= 0) {
+      ++c;
+      continue;
+    }
+    size_t n = 1;
+    while (c + n < c1 && g_chunk_phys[c + n] < 0) ++n;
+    // One block for the whole run; chunk by chunk if direct memory is too fragmented for it.
+    off_t phys = -1;
+    if (AllocateZeroed(n * kChunk, &phys)) {
+      for (size_t k = 0; k < n; ++k) g_chunk_phys[c + k] = phys + off_t(k * kChunk);
+    } else {
+      for (size_t k = 0; k < n; ++k) {
+        if (!AllocateZeroed(kChunk, &phys)) {
+          ok = false;
+          break;
+        }
+        g_chunk_phys[c + k] = phys;
+      }
+    }
+    for (size_t k = 0; k < n && g_chunk_phys[c + k] >= 0; ++k) g_committed += kChunk;
+    if (c * kChunk < new_lo) new_lo = c * kChunk;
+    new_hi = (c + n) * kChunk;
+    if (!ok) break;
+    c += n;
+  }
+  if (new_hi > new_lo) {
+    const size_t views = g_view_count.load(std::memory_order_relaxed);
+    for (size_t i = 0; i < views; ++i) {
+      if (!MapIntoView(i, new_lo, new_hi)) ok = false;
+    }
+  }
+  pthread_mutex_unlock(&g_lock);
+  return ok;
+}
+
+bool RexGmProtect(uint8_t* address, size_t length, RexGmAccess access, RexGmAccess* out_old) {
+  if (!g_base || address < g_base || address + length > g_base + g_size || length == 0) {
+    g_last_result = REX_GM_ERR_RANGE;
+    return false;
+  }
+  const size_t w0 = (address - g_base) & ~(kPage - 1);
+  const size_t w1 = ((address - g_base) + length + kPage - 1) & ~(kPage - 1);
+  pthread_mutex_lock(&g_lock);
+  if (out_old) *out_old = static_cast<RexGmAccess>(g_access[w0 / kPage].load());
+  for (size_t p = w0 / kPage; p < w1 / kPage; ++p) {
+    g_access[p].store(static_cast<uint8_t>(access), std::memory_order_relaxed);
+  }
+  const uint32_t before = g_last_result;
+  g_last_result = 0;
+  ApplyHardware(w0 & ~(kHwPage - 1), (w1 + kHwPage - 1) & ~(kHwPage - 1));
+  const bool ok = g_last_result == 0;
+  if (ok) g_last_result = before;
+  pthread_mutex_unlock(&g_lock);
+  return ok;
+}
+
+bool RexGmQueryProtect(uint8_t* address, size_t* length, RexGmAccess* out_access) {
+  if (!g_base || address < g_base || address >= g_base + g_size) return false;
+  const size_t p0 = (address - g_base) / kPage;
+  const uint8_t a = g_access[p0].load(std::memory_order_relaxed);
+  size_t limit = (length && *length) ? (*length + kPage - 1) / kPage : 1;
+  if (p0 + limit > g_size / kPage) limit = g_size / kPage - p0;
+  size_t n = 1;
+  while (n < limit && g_access[p0 + n].load(std::memory_order_relaxed) == a) ++n;
+  if (length) *length = n * kPage;
+  if (out_access) *out_access = static_cast<RexGmAccess>(a);
+  return true;
+}
+
+bool RexGmIsCommitted(uint64_t window_address) {
+  size_t backing = 0;
+  return RexGmWindowToOffset(window_address, &backing) && Committed(backing);
+}
+
+bool RexGmSiblingFault(uint64_t window_address, bool is_write, uint64_t* page_out,
+                       RexGmAccess* restore_out) {
+  const uint64_t base = reinterpret_cast<uint64_t>(g_base);
+  if (!g_base || window_address < base || window_address - base >= g_size) return false;
+  const size_t w = window_address - base;
+  const uint8_t a = g_access[w / kPage].load(std::memory_order_relaxed);
+  const bool allowed = is_write ? a == REX_GM_WRITE : a != REX_GM_NONE;
+  size_t backing = 0;
+  if (!allowed || !ToBacking(w, &backing) || !Committed(backing)) return false;
+  *page_out = base + (w & ~(kHwPage - 1));
+  *restore_out = HardwareAccess(w);
+  ++g_sibling_faults;
+  return true;
+}
+
+RexGmAccess RexGmHardwareAt(uint64_t window_address) {
+  return HardwareAccess(window_address - reinterpret_cast<uint64_t>(g_base));
+}
+
+bool RexGmSetHardware(uint64_t page, RexGmAccess access) {
+  return sceKernelMprotect(reinterpret_cast<void*>(page), kHwPage, ToProt(access)) == 0;
+}
+
+size_t RexGmCommittedBytes(void) { return g_committed; }
+size_t RexGmSiblingFaults(void) { return g_sibling_faults; }
+uint32_t RexGmLastResult(void) { return g_last_result; }
+
+}  // extern "C"
+
+#endif  // __PS4__
diff --git a/src/core/guest_memory_ps4.h b/src/core/guest_memory_ps4.h
new file mode 100644
index 0000000..ff8e4a5
--- /dev/null
+++ b/src/core/guest_memory_ps4.h
@@ -0,0 +1,108 @@
+/*
+ * Guest memory on the PS4: one reserved window, direct memory committed into it, real aliases
+ * for the 360 mirrors and real page permissions.
+ *
+ * What ReXGlue needs (from Xenia)
+ *   1. a contiguous reservation of 0x120000000 (4.5 GB) of virtual space
+ *   2. views: several guest windows over the same memory (0xA0000000, 0xC0000000, 0xE0000000
+ *      and the raw physical view at 0x100000000 all show physical memory)
+ *   3. page protection, for MMIO and for the GPU's write watches
+ *
+ * What the PS4 gives
+ *   - sceKernelReserveVirtualRange reserves the window (mmap(PROT_NONE) cannot reserve
+ *     gigabytes here); the kernel picks its address, like Horizon.
+ *   - Direct memory can be mapped at several addresses once sceKernelEnableDmemAliasing()
+ *     has been called (DolphinPS4's fastmem, verified on hardware). So a view is just another
+ *     mapping of the same direct memory: no shadow copies, no fault-in.
+ *   - sceKernelMprotect works on those mappings, but the kernel's page is 16 KiB and Xenia's
+ *     is 4 KiB. Permissions are kept per 4 KiB page in a table of our own; a 16 KiB page gets
+ *     the most restrictive permission of its 4 KiB pages that are not kNoAccess (see
+ *     RexGmHardwareAccess). An access that the table allows but the 16 KiB page refuses is a
+ *     "sibling fault": the exception handler lets it through (RexGmSiblingFault).
+ *
+ * Commit
+ *   The backing is the "file" of Xenia's memory map: offsets 0..size. Committing an offset
+ *   range allocates direct memory for its missing 64 KiB chunks (one block per run), zeroes it
+ *   through a private mapping first (never in place: see the lazy-memory race of the earlier
+ *   ports), then maps it into every view that covers the range. Decommit and Release only take
+ *   access away in a view; the backing stays until shutdown, as with Linux's shared memory,
+ *   because the other views still show it.
+ */
+#pragma once
+
+#if defined(__PS4__)
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Logical permissions, with the same values as rex::memory::PageAccess's read/write subset. */
+typedef enum {
+    REX_GM_NONE  = 0,
+    REX_GM_READ  = 1 << 0,
+    REX_GM_WRITE = (1 << 0) | (1 << 1), /* read + write */
+} RexGmAccess;
+
+/* Reserves the window (size is usually 0x120000000). Returns the base or NULL. */
+uint8_t* RexGmInit(size_t size);
+void RexGmShutdown(void);
+
+uint8_t* RexGmBase(void);
+size_t RexGmSize(void);
+
+/* Window address -> backing offset, through the view that holds it. */
+bool RexGmWindowToOffset(uint64_t window_address, size_t* offset_out);
+
+/* [base, base+length) of the window shows the backing from `offset` onwards. Views may share
+ * offsets: that makes the mirrors. The view's pages start with `access`, as mmap gives a whole view
+ * one protection on Linux (xmemory.cpp maps every view read-write; the heaps then protect, decommit
+ * and release ranges in it): the 360 reads the same physical memory through 0xA0000000,
+ * 0xC0000000 and 0xE0000000 whichever window allocated it. What is already committed is mapped
+ * into the view at once. */
+bool RexGmAddView(uint8_t* base, size_t offset, size_t length, RexGmAccess access);
+
+/* Commits backing for [offset, offset+length) and maps it into every view that covers it, with
+ * each view's logical permissions. Idempotent. */
+bool RexGmCommit(size_t offset, size_t length);
+
+/* Sets the logical permissions of a window range and applies them to what is mapped. */
+bool RexGmProtect(uint8_t* address, size_t length, RexGmAccess access, RexGmAccess* out_old);
+
+/* Logical permission at address; length gets the size of the uniform run (up to its input). */
+bool RexGmQueryProtect(uint8_t* address, size_t* length, RexGmAccess* out_access);
+
+/* True when the backing under window_address is committed (and so mapped in its view). */
+bool RexGmIsCommitted(uint64_t window_address);
+
+/*
+ * For the exception handler (signal context, lock-free): the fault at window_address was a
+ * sibling fault if the 4 KiB page's own logical permission allows the access. Then
+ * *page_out/*len_out get the 16 KiB page to open for one instruction and *restore_out the
+ * permission to put back afterwards (RexGmHardwareAccess at that moment).
+ */
+bool RexGmSiblingFault(uint64_t window_address, bool is_write, uint64_t* page_out,
+                       RexGmAccess* restore_out);
+
+/* The permission the 16 KiB page holding window_address should have now (lock-free). */
+RexGmAccess RexGmHardwareAt(uint64_t window_address);
+
+/* Applies a hardware permission to one 16 KiB window page (signal-safe: one system call). */
+bool RexGmSetHardware(uint64_t page, RexGmAccess access);
+
+/* Statistics for the logs. */
+size_t RexGmCommittedBytes(void);
+size_t RexGmSiblingFaults(void);
+uint32_t RexGmLastResult(void);
+
+#define REX_GM_ERR_NOVIEW 0xFFFF0001u /* the range is not inside one view */
+#define REX_GM_ERR_RANGE  0xFFFF0002u /* outside the backing */
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __PS4__ */
