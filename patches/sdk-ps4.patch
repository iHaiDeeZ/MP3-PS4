+WindowPS4::WindowPS4(WindowedAppContext& app_context, const std::string_view title,
+                     uint32_t desired_logical_width, uint32_t desired_logical_height)
+    : Window(app_context, title, desired_logical_width, desired_logical_height) {}
+
+WindowPS4::~WindowPS4() {
+  EnterDestructor();
+  if (open_) {
+    ps4_app_context().UnregisterWindow(this);
+    open_ = false;
+  }
+}
+
+PS4WindowedAppContext& WindowPS4::ps4_app_context() const {
+  return static_cast<PS4WindowedAppContext&>(app_context());
+}
+
+bool WindowPS4::OpenImpl() {
+  open_ = true;
+  ps4_app_context().RegisterWindow(this);
+  REXLOG_INFO("WindowPS4: VideoOut {}x{}", PS4VideoOutSurface::kWidth,
+              PS4VideoOutSurface::kHeight);
+  WindowDestructionReceiver destruction_receiver(this);
+  OnActualSizeUpdate(PS4VideoOutSurface::kWidth, PS4VideoOutSurface::kHeight,
+                     destruction_receiver);
+  if (destruction_receiver.IsWindowDestroyed()) {
+    return true;
+  }
+  OnFocusUpdate(true, destruction_receiver);
+  return true;
+}
+
+void WindowPS4::RequestCloseImpl() { PerformClose(); }
+
+void WindowPS4::PerformClose() {
+  WindowDestructionReceiver destruction_receiver(this);
+  OnBeforeClose(destruction_receiver);
+  if (destruction_receiver.IsWindowDestroyed()) {
+    return;
+  }
+  if (open_) {
+    ps4_app_context().UnregisterWindow(this);
+    open_ = false;
+  }
+  OnAfterClose();
+}
+
+std::unique_ptr<Surface> WindowPS4::CreateSurfaceImpl(Surface::TypeFlags allowed_types) {
+  if (!open_ || !(allowed_types & Surface::kTypeFlag_PS4VideoOut)) {
+    return nullptr;
+  }
+  return std::make_unique<PS4VideoOutSurface>();
+}
+
+void WindowPS4::RequestPaintImpl() {
+  if (paint_pending_.exchange(true, std::memory_order_acq_rel)) {
+    return;
+  }
+  ps4_app_context().WakeUILoop();
+}
+
+void WindowPS4::HandlePendingPaint() {
+  if (paint_pending_.exchange(false, std::memory_order_acq_rel)) {
+    OnPaint();
+  }
+}
+
+void WindowPS4::HandleCloseRequest() {
+  WindowDestructionReceiver destruction_receiver(this);
+  if (SendCloseRequestToListeners(destruction_receiver) &&
+      !destruction_receiver.IsWindowDestroyed()) {
+    PerformClose();
+  }
+}
+
+}  // namespace rex::ui
diff --git a/src/ui/windowed_app_context_ps4.cpp b/src/ui/windowed_app_context_ps4.cpp
new file mode 100644
index 0000000..329325e
--- /dev/null
+++ b/src/ui/windowed_app_context_ps4.cpp
@@ -0,0 +1,120 @@
+/**
+ * @file        rex/ui/windowed_app_context_ps4.cpp
+ * @brief       The UI thread's loop on the PS4
+ *
+ * The PS4 has no window events to wait on: the loop sleeps on a condition variable until a pending
+ * function or a paint wakes it (100 ms at most), runs the pending functions and the windows' paints,
+ * and carries out a quit request by closing every window first, so the app's listeners stop the
+ * guest, audio and GPU threads before the process goes.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/ui/windowed_app_context_ps4.h>
+
+#include <algorithm>
+#include <chrono>
+
+#include <rex/logging.h>
+#include <rex/ui/window_ps4.h>
+
+namespace rex::system {
+void FollowServicePriority(int32_t* applied);  // xthread.cpp (mp3-ps4 v00.33)
+}  // namespace rex::system
+
+namespace rex::ui {
+
+namespace {
+constexpr auto kWaitTimeout = std::chrono::milliseconds(100);
+}  // namespace
+
+PS4WindowedAppContext::~PS4WindowedAppContext() { ExecutePendingFunctionsFromUIThread(); }
+
+bool PS4WindowedAppContext::Initialize() { return true; }
+
+void PS4WindowedAppContext::NotifyUILoopOfPendingFunctions() {
+  {
+    std::lock_guard<std::mutex> lock(wake_mutex_);
+    woken_ = true;
+  }
+  wake_.notify_one();
+}
+
+void PS4WindowedAppContext::PlatformQuitFromUIThread() { NotifyUILoopOfPendingFunctions(); }
+
+void PS4WindowedAppContext::RequestQuit() {
+  {
+    std::lock_guard<std::mutex> lock(wake_mutex_);
+    quit_pending_ = true;
+    woken_ = true;
+  }
+  wake_.notify_one();
+}
+
+void PS4WindowedAppContext::RegisterWindow(WindowPS4* window) {
+  if (!IsRegistered(window)) {
+    windows_.push_back(window);
+  }
+}
+
+void PS4WindowedAppContext::UnregisterWindow(WindowPS4* window) {
+  windows_.erase(std::remove(windows_.begin(), windows_.end(), window), windows_.end());
+}
+
+bool PS4WindowedAppContext::IsRegistered(const WindowPS4* window) const {
+  return std::find(windows_.begin(), windows_.end(), window) != windows_.end();
+}
+
+void PS4WindowedAppContext::ProcessQuitRequest() {
+  if (quit_requested_) {
+    return;
+  }
+  quit_requested_ = true;
+  REXLOG_INFO("PS4: quit requested");
+  const std::vector<WindowPS4*> windows = windows_;
+  for (WindowPS4* window : windows) {
+    if (IsRegistered(window)) {
+      window->HandleCloseRequest();
+    }
+  }
+  if (windows_.empty() && !HasQuitFromUIThread()) {
+    QuitFromUIThread();
+  }
+}
+
+int PS4WindowedAppContext::RunMainMessageLoop() {
+  int32_t priority_applied = -1;  // mp3-ps4 (v00.33): above the game's threads (ps4_service_thread_priority)
+  while (!HasQuitFromUIThread()) {
+    rex::system::FollowServicePriority(&priority_applied);
+    bool quit = false;
+    {
+      std::unique_lock<std::mutex> lock(wake_mutex_);
+      wake_.wait_for(lock, kWaitTimeout, [this] { return woken_; });
+      woken_ = false;
+      quit = quit_pending_;
+    }
+    ExecutePendingFunctionsFromUIThread();
+    if (quit) {
+      ProcessQuitRequest();
+    }
+    // mp3-ps4 (v00.33): on the stack. The vector copy, a heap allocation at every wake, waited for the heap lock in
+    // 33 % of this thread's samples in fights, holding back the paint.
+    WindowPS4* windows[16];
+    size_t window_count = 0;
+    for (WindowPS4* window : windows_) {
+      if (window_count < 16) {
+        windows[window_count++] = window;
+      }
+    }
+    for (size_t i = 0; i < window_count; ++i) {
+      if (IsRegistered(windows[i])) {
+        windows[i]->HandlePendingPaint();
+      }
+    }
+  }
+  ExecutePendingFunctionsFromUIThread();
+  return EXIT_SUCCESS;
+}
+
+}  // namespace rex::ui
diff --git a/src/ui/windowed_app_main_ps4.cpp b/src/ui/windowed_app_main_ps4.cpp
new file mode 100644
index 0000000..1fa0675
--- /dev/null
+++ b/src/ui/windowed_app_main_ps4.cpp
@@ -0,0 +1,65 @@
+/**
+ * @file        rex/ui/windowed_app_main_ps4.cpp
+ * @brief       Entry point of a windowed app on the PS4
+ *
+ * The process leaves through exit(), which ps4-kit wraps into sceSystemServiceLoadExec("exit"):
+ * returning from main tears the process down with the GPU and VideoOut still live, which crashed
+ * on the console (kit-test v00.01).
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <memory>
+#include <string>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/ui/windowed_app.h>
+#include <rex/ui/windowed_app_context_ps4.h>
+
+namespace {
+
+[[noreturn]] void ExitProcess(int result) {
+  REXLOG_INFO("PS4: exiting process ({})", result);
+  rex::FlushLogging();
+  std::fflush(nullptr);
+  std::exit(result);
+}
+
+}  // namespace
+
+int main(int argc, char* argv[]) {
+  auto remaining = rex::cvar::Init(argc, argv);
+  rex::cvar::ApplyEnvironment();
+  rex::InitLoggingEarly();
+
+  int result;
+  {
+    rex::ui::PS4WindowedAppContext app_context;
+    if (!app_context.Initialize()) {
+      ExitProcess(EXIT_FAILURE);
+    }
+    std::unique_ptr<rex::ui::WindowedApp> app = rex::ui::GetWindowedAppCreator()(app_context);
+
+    const auto& option_names = app->GetPositionalOptions();
+    std::map<std::string, std::string> parsed;
+    const size_t count = std::min(remaining.size(), option_names.size());
+    for (size_t i = 0; i < count; ++i) {
+      parsed[option_names[i]] = remaining[i];
+    }
+    app->SetParsedArguments(std::move(parsed));
+
+    const bool initialized = app->OnInitialize();
+    if (!initialized) {
+      REXLOG_ERROR("PS4: app initialization failed");
+    }
+    result = initialized ? app_context.RunMainMessageLoop() : EXIT_FAILURE;
+    app->InvokeOnDestroy();
+  }
+  ExitProcess(result);
+}
