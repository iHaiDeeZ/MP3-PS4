+void RenderDk::VolcarResuelta(const ImagenDk& imagen, uint32_t base, uint32_t formato_guest, uint32_t alto_max) {
+  uint32_t bpp = 0;
+  switch (imagen.formato) {
+    case DkImageFormat_RGBA8_Unorm:
+    case DkImageFormat_RGB10A2_Unorm:
+    case DkImageFormat_R32_Float:
+    case DkImageFormat_RG16_Float:
+    case DkImageFormat_Z24S8:
+      bpp = 4;
+      break;
+    case DkImageFormat_RGBA16_Float:
+    case DkImageFormat_RG32_Float:
+      bpp = 8;
+      break;
+    default:
+      return;
+  }
+  const uint32_t alto = alto_max ? std::min(imagen.alto, alto_max) : imagen.alto;
+  const uint32_t bytes = imagen.ancho * alto * bpp;
+  if (volcado_.size() >= 200 || volcado_usados_ + bytes > kBytesVolcado) {
+    return;
+  }
+  AntesDeTransferir();
+  const DkImageView vista = VistaCompleta(imagen.imagen);
+  const DkImageRect rect = {0, 0, 0, imagen.ancho, alto, 1};
+  const DkCopyBuf destino = {volcado_gpu_ + volcado_usados_, imagen.ancho * bpp, bytes};
+  dkCmdBufCopyImageToBuffer(nucleo_.comandos(), &vista, &rect, &destino, 0);
+  volcado_.push_back({volcado_usados_, imagen.ancho, alto, bpp, base, formato_guest, imagen.formato});
+  volcado_usados_ += (bytes + 255) & ~255u;
+}
+
+// A resolved texture for the frame dump: copied at once (with the copy engine and its barrier, as before), or with
+// x360_volcado_en_vivo at the frame's end, as the frame left it, so the dump frame is drawn like any other (run31's
+// black quarter and empty luminance chain were not in the dumps).
+void RenderDk::SondarTexel(const ImagenDk& imagen, uint32_t x, uint32_t y, std::string que) {
+  if (sondas_texel_.size() >= 64 || x >= imagen.ancho || y >= imagen.alto) return;
+  if (!sonda_bloque_) {
+    sonda_bloque_ = nucleo_.CrearBloqueLectura(64 * 16, "sondas de un texel");
+    if (!sonda_bloque_) return;
+    sonda_cpu_ = static_cast<uint8_t*>(dkMemBlockGetCpuAddr(sonda_bloque_));
+    sonda_gpu_ = dkMemBlockGetGpuAddr(sonda_bloque_);
+  }
+  const uint32_t bpp = imagen.formato == DkImageFormat_RGBA16_Float || imagen.formato == DkImageFormat_RG32_Float ? 8
+                       : imagen.formato == DkImageFormat_RGBA32_Float                                             ? 16
+                                                                                                                  : 4;
+  AntesDeTransferir();
+  const DkImageView vista = VistaCompleta(imagen.imagen);
+  const DkImageRect rect = {x, y, 0, 1, 1, 1};
+  const DkCopyBuf destino = {sonda_gpu_ + DkGpuAddr(sondas_texel_.size()) * 16, bpp, bpp};
+  dkCmdBufCopyImageToBuffer(nucleo_.comandos(), &vista, &rect, &destino, 0);
+  sondas_texel_.push_back({std::move(que), imagen.formato});
+}
+
+void RenderDk::LeerSondasTexel() {
+  if (sondas_texel_.empty()) return;
+  CerrarTrabajo();
+  proveedor_.dispositivo().EsperarInactiva();
+  dkMemBlockFlushCpuCache(sonda_bloque_, 0, 64 * 16);
+  for (size_t i = 0; i < sondas_texel_.size(); ++i) {
+    const uint8_t* p = sonda_cpu_ + i * 16;
+    std::string v;
+    if (sondas_texel_[i].formato == DkImageFormat_R32_Float) {
+      float f;
+      std::memcpy(&f, p, 4);
+      v = fmt::format("{:g}", f);
+    } else if (sondas_texel_[i].formato == DkImageFormat_RGBA16_Float) {
+      uint16_t hs[4];
+      std::memcpy(hs, p, 8);
+      for (uint16_t hh : hs) {
+        const uint32_t e = (hh >> 10) & 0x1F, m = hh & 0x3FF;
+        const float f = (hh & 0x8000 ? -1.0f : 1.0f) *
+                        (e == 0 ? std::ldexp(float(m), -24) : e == 31 ? INFINITY : std::ldexp(float(m | 0x400), int(e) - 25));
+        v += fmt::format("{:g} ", f);
+      }
+    } else {
+      uint32_t w;
+      std::memcpy(&w, p, 4);
+      v = fmt::format("{:08X}", w);
+    }
+    REXLOG_INFO("[edram-diag] texel {}: {}", sondas_texel_[i].que, v);
+  }
+  sondas_texel_.clear();
+}
