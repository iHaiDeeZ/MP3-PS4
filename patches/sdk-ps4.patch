+    if (flotante && texels <= 640u * 360u) {
+      if (std::FILE* f = std::fopen((carpeta / (std::string(nombre) + ".f32")).string().c_str(), "wb")) {
+        std::fwrite(c.data(), sizeof(float), texels * 4, f);
+        std::fclose(f);
+      }
+    }
+    if (alfa) {
+      EscribirBmp(carpeta / (std::string(nombre) + "_alfa.bmp"), e.ancho, e.alto, a);
+    }
+  }
+  REXLOG_INFO("[deko3d] volcado: {} texturas escritas en {}", entradas.size(), carpeta.string());
+  });
+  volcado_.clear();
+}
