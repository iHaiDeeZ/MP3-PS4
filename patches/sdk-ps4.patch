+/**
+ * @file        rex/ui/surface_ps4.h
+ * @brief       The PS4's VideoOut screen as a presentation surface
+ *
+ * A Vulkan surface for it is VK_EXT_headless_surface from ps4-kit's WSI, which flips swapchain
+ * images onto VideoOut (ps4-kit/gpu/ps4_vk_wsi.h). The screen is always 1920x1080; the system scales
+ * it for a 720p TV.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <rex/ui/surface.h>
+
+namespace rex::ui {
+
+class PS4VideoOutSurface final : public Surface {
+ public:
+  static constexpr uint32_t kWidth = 1920;
+  static constexpr uint32_t kHeight = 1080;
+
+  PS4VideoOutSurface() = default;
+  TypeIndex GetType() const override { return kTypeIndex_PS4VideoOut; }
+
+ protected:
+  bool GetSizeImpl(uint32_t& width_out, uint32_t& height_out) const override {
+    width_out = kWidth;
+    height_out = kHeight;
+    return true;
+  }
+};
+
+}  // namespace rex::ui
