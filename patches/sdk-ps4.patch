diff --git a/cmake/rexglue_ps4.cmake b/cmake/rexglue_ps4.cmake
new file mode 100644
index 0000000..39b2bc8
--- /dev/null
+++ b/cmake/rexglue_ps4.cmake
@@ -0,0 +1,44 @@
+# PS4 (ps4-kit): how a title links into one eboot.
+#
+# Included by the SDK's CMakeLists.txt when REXGLUE_PLATFORM_PS4 is on. The project must have included ps4-kit.cmake
+# (ps4_kit_app, ps4_kit_link_mesa) and be configured with ps4-kit's toolchain: clang 21, libc++ 21, OpenOrbis, ld.lld
+# called directly (no -Wl,: CMake's LINKER: options reach ld.lld as plain arguments).
+
+include_guard(GLOBAL)
+
+# rexglue_ps4_configure_target(<target> [GPU_PLUGINS ...]): the PS4 entry point, ReXApp, and every object of the
+# runtime in the title. From an archive the linker would only pull members that resolve an undefined symbol, and
+# several do nothing but register themselves from a static constructor (cvars, kernel exports).
+function(rexglue_ps4_configure_target target_name)
+    cmake_parse_arguments(ARG "" "" "GPU_PLUGINS" ${ARGN})
+
+    target_sources(${target_name} PRIVATE
+        ${REXGLUE_SHARE_DIR}/windowed_app_main_ps4.cpp
+        ${REXGLUE_SHARE_DIR}/rex_app.cpp)
+    target_compile_definitions(${target_name} PRIVATE
+        REXGLUE_BUILD_CONFIG="$<CONFIG>")
+    target_compile_features(${target_name} PRIVATE cxx_std_23)
+
+    set(_whole "$<TARGET_FILE:rexruntime>")
+    set(_libs rexruntime)
+    foreach(_plugin IN LISTS ARG_GPU_PLUGINS)
+        if(NOT TARGET rexgpu-${_plugin})
+            message(FATAL_ERROR
+                "rexglue_ps4_configure_target: unknown GPU plugin '${_plugin}' (no target rexgpu-${_plugin})")
+        endif()
+        list(APPEND _whole "$<TARGET_FILE:rexgpu-${_plugin}>")
+        list(APPEND _libs rexgpu-${_plugin})
+    endforeach()
+    string(JOIN "," _whole_csv ${_whole})
+    target_link_options(${target_name} PRIVATE "LINKER:--whole-archive,${_whole_csv},--no-whole-archive")
+    set_property(TARGET ${target_name} APPEND PROPERTY LINK_DEPENDS ${_whole})
+    # Still linked normally, for the build order and their own dependencies (glslang, FFmpeg, ...).
+    target_link_libraries(${target_name} PRIVATE ${_libs})
+
+    # libScePad / libSceUserService (input), libSceAudioOut (audio): the system's stub libraries.
+    target_link_libraries(${target_name} PRIVATE -lScePad -lSceUserService -lSceAudioOut)
+
+    # rex_app.cpp includes imgui.h; rexruntime links imgui privately.
+    target_include_directories(${target_name} PRIVATE
+        $<TARGET_PROPERTY:imgui,INTERFACE_INCLUDE_DIRECTORIES>)
+endfunction()
