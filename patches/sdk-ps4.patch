+VkDescriptorSet VulkanCommandProcessor::FindTextureSet(bool is_vertex, uint32_t texture_count,
+                                                       uint32_t sampler_count,
+                                                       const VkDescriptorImageInfo* infos,
+                                                       uint64_t& hash_out) {
+  TextureDescriptorSetLayoutKey layout_key;
+  layout_key.texture_count = texture_count;
+  layout_key.sampler_count = sampler_count;
+  layout_key.is_vertex = uint32_t(is_vertex);
+  const uint32_t info_count = texture_count + sampler_count;
+  // The infos are value-initialized (zeroed, padding included) before their fields are set, so their bytes compare.
+  hash_out = XXH3_64bits_withSeed(infos, sizeof(VkDescriptorImageInfo) * info_count, layout_key.key);
+  auto it = texture_set_cache_.find(hash_out);
+  if (it == texture_set_cache_.end()) {
+    return VK_NULL_HANDLE;
+  }
+  const TextureSetCacheEntry& entry = it->second;
+  if (entry.layout_key != layout_key.key || entry.info_count != info_count ||
+      std::memcmp(texture_set_cache_infos_.data() + entry.info_offset, infos,
+                  sizeof(VkDescriptorImageInfo) * info_count)) {
+    return VK_NULL_HANDLE;
+  }
+  return entry.set;
+}
+
+void VulkanCommandProcessor::StoreTextureSet(bool is_vertex, uint32_t texture_count, uint32_t sampler_count,
+                                             const VkDescriptorImageInfo* infos, uint64_t hash,
+                                             VkDescriptorSet set) {
+  TextureDescriptorSetLayoutKey layout_key;
+  layout_key.texture_count = texture_count;
+  layout_key.sampler_count = sampler_count;
+  layout_key.is_vertex = uint32_t(is_vertex);
+  TextureSetCacheEntry entry;
+  entry.set = set;
+  entry.layout_key = layout_key.key;
+  entry.info_count = texture_count + sampler_count;
+  entry.info_offset = texture_set_cache_infos_.size();
+  texture_set_cache_infos_.insert(texture_set_cache_infos_.end(), infos, infos + entry.info_count);
+  // A hash collision with another combination replaces that one (it is written again if it comes back).
+  texture_set_cache_[hash] = entry;
+}
+
 }  // namespace rex::graphics::vulkan
