+// The last [cp] (and [mem]) lines, for an app's own report (mp3-ps4's live console): their length, at most size - 1
+// bytes copied, 0-terminated.
+// The draw tracer (see above): start for `frames` frames from the next one; the text once done ("" before).
+REX_GPU_DIAG void rex_gpu_trace_start(uint32_t address, uint32_t frames) {
+  if (g_trace_frames_left.load()) return;
+  {
+    std::lock_guard<std::mutex> lock(g_census_mutex);
+    g_trace_result.clear();
+  }
+  g_trace_address = address & ~0xFFFu;
+  g_trace_frame = g_trace_draw = g_trace_copy = 0;
+  g_trace_from = uint32_t(std::max(REXCVAR_GET(gpu_debug_trace_from), int32_t(0)));
+  g_trace_to = uint32_t(std::max(REXCVAR_GET(gpu_debug_trace_to), int32_t(0)));
+  g_trace_text.clear();
+  g_trace_shaders.clear();
+  g_trace_frames_left.store(frames ? frames : 1);
+}
+REX_GPU_DIAG size_t rex_gpu_trace_text(char* out, size_t size) {
+  std::lock_guard<std::mutex> lock(g_census_mutex);
+  const std::string& text = g_trace_frames_left.load() ? std::string() : g_trace_result;
+  if (out && size) {
+    const size_t n = std::min(size - 1, text.size());
+    std::memcpy(out, text.data(), n);
+    out[n] = 0;
+  }
+  return text.size();
+}
+
+// The resolve dump (see above): one frame's resolves into `dir` (it must exist); 0 while it runs, 1 when done.
+REX_GPU_DIAG void rex_gpu_resdump_start(const char* dir) {
+  if (g_resdump_state.load()) return;
+  g_resdump_dir = dir;
+  g_resdump_state = 1;
+}
+REX_GPU_DIAG int rex_gpu_resdump_done(void) { return g_resdump_state.load() == 0; }
+
+// The census (see above): start one for `frames` frames; the text once it is done ("" while it runs).
+REX_GPU_DIAG void rex_gpu_census_start(uint32_t frames) {
+  {
+    std::lock_guard<std::mutex> lock(g_census_mutex);
+    g_census.clear();
+    g_census_frames = g_census_draws = g_census_copies = 0;
+    g_census_text.clear();
+  }
+  g_census_frames_left.store(frames ? frames : 1);
+}
+
+REX_GPU_DIAG size_t rex_gpu_census_text(char* out, size_t size) {
+  std::lock_guard<std::mutex> lock(g_census_mutex);
+  const std::string& text = g_census_frames_left.load() ? std::string() : g_census_text;
+  if (out && size) {
+    const size_t n = std::min(size - 1, text.size());
+    std::memcpy(out, text.data(), n);
+    out[n] = 0;
+  }
+  return text.size();
+}
+
+REX_GPU_DIAG size_t rex_gpu_stats_text(char* out, size_t size) {
+  std::lock_guard<std::mutex> lock(g_cp_text_mutex);
+  if (out && size) {
+    const size_t n = std::min(size - 1, g_cp_text.size());
+    std::memcpy(out, g_cp_text.data(), n);
+    out[n] = 0;
+  }
+  return g_cp_text.size();
+}
