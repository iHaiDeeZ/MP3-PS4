index d26cd4f..14522e3 100644
--- a/include/rex/graphics/pipeline/texture/cache.h
+++ b/include/rex/graphics/pipeline/texture/cache.h
@@ -55,6 +55,16 @@ namespace rex::graphics {
 // because textures are streamed this way anyway.
 class TextureCache {
  public:
+  // mp3-ps4 (v00.19): called right before a texture's guest data is uploaded to be loaded, with its guest base
+  // address, format (xenos::TextureFormat), size, tiling and endianness (xenos::Endian), so an app can rewrite that
