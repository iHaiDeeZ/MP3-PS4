+void CpStatsOnSwap() {
+  CpStats& st = g_cp_stats;
+  ++st.swaps;
+  if (!REXCVAR_GET(gpu_stats_log)) return;
+  const auto now = std::chrono::steady_clock::now();
+  const double seconds = std::chrono::duration<double>(now - st.start).count();
+  if (seconds < double(REXCVAR_GET(gpu_stats_log_s))) return;
+  const double f = st.swaps ? double(st.swaps) : 1.0;
+  std::string text = fmt::format(
+      "[cp] {:.0f} s: {} swaps ({:.1f}/s); a frame: {:.0f} draws, {:.1f} resolves, {:.1f} occlusion queries, {:.1f} "
+      "memexport readbacks, {:.1f} submissions, {:.1f} GPU waits ({:.1f} ms blocked)",
+      seconds, st.swaps, double(st.swaps) / seconds, double(st.draws) / f, double(st.copies) / f,
+      double(st.queries) / f, double(st.memexports) / f, double(st.submissions) / f, double(st.waits) / f,
+      double(st.wait_ns) / 1e6 / f);
+  REXGPU_INFO("{}", text);
+  {
+    // mp3-ps4 (v00.15): the command processor's time by part, as shares of the wall time since the last line
+    // (rex/graphics/cp_perf.h): the ring's packets (all of it), draws, submissions, the shared memory's lock waits,
+    // uploads and watch arming, and how many requests needed the lock.
+    namespace cpp = rex::graphics::cp_perf;
+    static uint64_t last_ticks = cpp::Ticks();
+    const uint64_t now_ticks = cpp::Ticks();
+    const double wall = double(std::max<uint64_t>(now_ticks - last_ticks, 1)) / 100.0;
+    last_ticks = now_ticks;
+    auto take = [](std::atomic<uint64_t>& c) { return c.exchange(0, std::memory_order_relaxed); };
+    const uint64_t ring = take(cpp::ring_ticks), draw = take(cpp::draw_ticks), submit = take(cpp::submit_ticks);
+    const uint64_t lock = take(cpp::lock_wait_ticks), locks = take(cpp::lock_waits);
+    const uint64_t requests = take(cpp::requests), fast = take(cpp::requests_fast);
+    const uint64_t upload = take(cpp::upload_ticks), uploads = take(cpp::uploads), bytes = take(cpp::upload_bytes);
+    const uint64_t arm = take(cpp::arm_ticks), arms = take(cpp::arms);
+    const std::string timing = fmt::format(
+        "[cpt] ring {:.0f} %, draws {:.0f} %, submissions {:.0f} %; lock waits {:.1f} % ({:.0f} a frame), uploads "
+        "{:.1f} % ({:.0f} a frame, {:.0f} KB), watch arming {:.1f} % ({:.0f} a frame); requests {:.0f} a frame, "
+        "{:.0f} % without the lock",
+        double(ring) / wall, double(draw) / wall, double(submit) / wall, double(lock) / wall, double(locks) / f,
+        double(upload) / wall, double(uploads) / f, double(bytes) / 1024.0 / f, double(arm) / wall,
+        double(arms) / f, double(requests) / f, requests ? 100.0 * double(fast) / double(requests) : 0.0);
+    REXGPU_INFO("{}", timing);
+    text += '\n' + timing;
+    // v00.20: a draw's parts, and the submission thread's waits (by caller).
+    const uint64_t prim = take(cpp::prim_ticks), tex = take(cpp::tex_ticks), rt = take(cpp::rt_ticks);
+    const uint64_t pipe = take(cpp::pipe_ticks), dyn = take(cpp::dyn_ticks), sysc = take(cpp::sysc_ticks);
+    const uint64_t bind = take(cpp::bind_ticks), enter = take(cpp::enter_ticks);
+    const uint64_t shader = take(cpp::shader_ticks), loads = take(cpp::shader_loads);
+    const uint64_t await = take(cpp::await_ticks), swap_await = take(cpp::swap_await_ticks);
+    const std::string parts = fmt::format(
+        "[cpt2] in draws: primitives {:.1f} %, textures {:.1f} %, render targets {:.1f} %, pipeline {:.1f} %, "
+        "dynamic state {:.1f} %, system constants {:.1f} %, bindings {:.1f} %, render pass {:.1f} %; shader loads "
+        "{:.1f} % ({:.0f} a frame); waits for the submission thread {:.1f} % (at the swap {:.1f} %)",
+        double(prim) / wall, double(tex) / wall, double(rt) / wall, double(pipe) / wall, double(dyn) / wall,
+        double(sysc) / wall, double(bind) / wall, double(enter) / wall, double(shader) / wall, double(loads) / f,
+        double(await) / wall, double(swap_await) / wall);
+    REXGPU_INFO("{}", parts);
+    text += '\n' + parts;
+    // v00.21: the draws' descriptor sets.
+    const uint64_t tex_written = take(cpp::texture_sets_written), tex_reused = take(cpp::texture_sets_reused);
+    const uint64_t tex_kept = take(cpp::texture_sets_kept), const_written = take(cpp::constant_sets_written);
+    const std::string sets = fmt::format(
+        "[sets] a frame: texture sets {:.0f} written, {:.0f} reused ({:.0f} of them still bound); constant sets {:.0f} "
+        "written",
+        double(tex_written) / f, double(tex_reused) / f, double(tex_kept) / f, double(const_written) / f);
+    REXGPU_INFO("{}", sets);
+    text += '\n' + sets;
+    // v00.22: the rest of the draws.
+    const uint64_t analyze = take(cpp::analyze_ticks), shaders = take(cpp::shaders_ticks);
+    const uint64_t samplers = take(cpp::samplers_ticks), viewport = take(cpp::viewport_ticks);
+    const uint64_t vertex = take(cpp::vertex_ticks), record = take(cpp::record_ticks);
+    const std::string rest = fmt::format(
+        "[cpt3] in draws: shader analysis {:.1f} %, shader variants {:.1f} %, samplers {:.1f} %, viewport {:.1f} %, "
+        "vertex buffers {:.1f} %, recording {:.1f} %",
+        double(analyze) / wall, double(shaders) / wall, double(samplers) / wall, double(viewport) / wall,
+        double(vertex) / wall, double(record) / wall);
+    REXGPU_INFO("{}", rest);
+    text += '\n' + rest;
+    // v00.23: the write watches' arming, all threads.
+    uint64_t arm_calls, arm_skipped, arm_protects, arm_protect_ticks, arm_lock_ticks;
+    rex::memory::ArmStats(&arm_calls, &arm_skipped, &arm_protects, &arm_protect_ticks, &arm_lock_ticks);
+    const double ticks_per_us = std::max(wall * 100.0 / (seconds * 1e6), 1.0);
+    const std::string arm_text = fmt::format(
+        "[arm] a frame: {:.0f} views armed ({:.0f} skipped, nothing there), {:.0f} mprotects ({:.1f} % of the time, "
+        "{:.1f} us each), global lock {:.1f} %",
+        double(arm_calls) / f, double(arm_skipped) / f, double(arm_protects) / f, double(arm_protect_ticks) / wall,
+        arm_protects ? double(arm_protect_ticks) / double(arm_protects) / ticks_per_us : 0.0,
+        double(arm_lock_ticks) / wall);
+    REXGPU_INFO("{}", arm_text);
+    text += '\n' + arm_text;
+    // v00.24: kicks and hot memory.
+    const uint64_t kick_count = take(cpp::kicks), hot_made = take(cpp::hot_made), hot_cooled = take(cpp::hot_cooled);
+    const uint64_t hot_uploads = take(cpp::hot_uploads), hot_invalidations = take(cpp::hot_invalidations);
+    const std::string hot_text = fmt::format(
+        "[hot] a frame: {:.1f} kicks; hot memory {} ({} regions of 64 KB now, {} made hot and {} cold in the last "
+        "{:.0f} s), {:.0f} uploads into it, {:.1f} invalidations",
+        double(kick_count) / f, REXCVAR_GET(gpu_hot_memory) ? "on" : "off",
+        cpp::hot_regions.load(std::memory_order_relaxed), hot_made, hot_cooled, seconds, double(hot_uploads) / f,
+        double(hot_invalidations) / f);
+    REXGPU_INFO("{}", hot_text);
+    text += '\n' + hot_text;
+    // v00.25: constants re-sent with the values they had.
+    const uint64_t float_written = take(cpp::float_written), float_changed = take(cpp::float_changed);
+    const uint64_t fetch_written = take(cpp::fetch_written), fetch_changed = take(cpp::fetch_changed);
+    const std::string regs_text = fmt::format(
+        "[regs] a frame: float constants {:.0f} dwords written, {:.0f} changed; fetch constants {:.0f} written, "
+        "{:.0f} changed (unchanged ones skipped: {})",
+        double(float_written) / f, double(float_changed) / f, double(fetch_written) / f, double(fetch_changed) / f,
+        REXCVAR_GET(gpu_skip_unchanged_constants) ? "yes" : "no");
+    REXGPU_INFO("{}", regs_text);
+    text += '\n' + regs_text;
+  }
+#if REX_PLATFORM_PS4
+  // The faults behind the frame (rex/exception_handler.h): stores single-stepped next to a write-watched page, 16 KiB
+  // pages opened by firing their watches, and faults Xenia's handlers took (MMIO and write watches).
+  static rex::arch::FaultCounts last_faults{};
+  const rex::arch::FaultCounts faults = rex::arch::GetFaultCounts();
+  const std::string mem = fmt::format(
+      "[mem] a frame: {:.0f} stores single-stepped, {:.1f} pages opened by their watches, {:.1f} watch/MMIO faults",
+      double(faults.sibling_steps - last_faults.sibling_steps) / f,
+      double(faults.sibling_opens - last_faults.sibling_opens) / f, double(faults.handled - last_faults.handled) / f);
+  REXGPU_INFO("{}", mem);
+  last_faults = faults;
+  text += '\n' + mem;
+#endif
+  {
+    std::lock_guard<std::mutex> lock(g_cp_text_mutex);
+    g_cp_text = std::move(text);
+  }
+  st = CpStats();
+  st.start = now;
+}
