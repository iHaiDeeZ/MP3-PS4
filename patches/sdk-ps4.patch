+      }
+    }
+    REXLOG_INFO("[deko3d] sonda escena: PS n{} VS n{} cuenta {}:{} |{} | VS{} | flujos{}", ps->numero, p.vs->numero,
+                cuenta, t, c, cv, flujos);
+  }
+  if (novedad_pares_.insert({p.vs->numero, ps ? ps->numero : UINT32_MAX}).second || !novedad_dibujo_.empty()) {
+    std::string linea = fmt::format("VS n{} PS {} tipo {} cuenta {}{}", p.vs->numero,
+                                    ps ? fmt::format("n{}", ps->numero) : std::string("-"), tipo, cuenta,
+                                    novedad_dibujo_);
+    if (novedades_.size() < kNovedades) {
+      novedades_.emplace_back(trabajo_, std::move(linea));
+    } else {
+      novedades_[novedades_pos_++ % kNovedades] = {trabajo_, std::move(linea)};
+    }
   }
   ++dibujados_;
   cortar_etapa(5);
@@ -2024,4 +2828,17 @@ bool RenderDk::Dibujar(const PeticionDibujo& p) {
   return true;
 }
 
+// What the stuck job (and the one before it) drew for the first time: a new shader pair or texture.
+void RenderDk::VolcarNovedades(uint64_t trabajo) {
+  size_t n = 0;
+  for (size_t i = 0; i < novedades_.size(); ++i) {
+    const auto& [t, linea] = novedades_[(novedades_pos_ + i) % novedades_.size()];
+    if (t + 1 >= trabajo && t <= trabajo) {
+      REXLOG_WARN("[deko3d] GPU atascada en el trabajo {}: nuevo en el trabajo {}: {}", trabajo, t, linea);
+      ++n;
+    }
+  }
+  REXLOG_WARN("[deko3d] GPU atascada en el trabajo {}: {} dibujos con algo nuevo en el y el anterior", trabajo, n);
+}
+
