+  for (uint32_t i = 0; i < 5; ++i) {
+    const ImagenDk* imagen = imagenes_pase_[i];
+    if (!imagen || !claves_pase_previo_[i]) continue;
+    if (i == 4 && !REXCVAR_GET(nfsmw_dk_volcado_pase_z)) continue;
