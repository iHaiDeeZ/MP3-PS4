diff --git a/include/rex/exception_handler.h b/include/rex/exception_handler.h
index bcd00bf..04924ac 100644
--- a/include/rex/exception_handler.h
+++ b/include/rex/exception_handler.h
@@ -531,4 +531,25 @@ class ExceptionHandler {
   static void Uninstall(Handler fn, void* data);
 };
 
+#if REX_PLATFORM_PS4
+// The PS4 protects 16 KiB pages and Xenia 4 KiB ones (guest_memory_ps4.h): a write watch on one 4 KiB page closes its
+// three neighbours too. A write to a neighbour used to be single-stepped (SIGSEGV, open the 16 KiB page, one
+// instruction, SIGTRAP, close it) at every store, so a game writing vertices next to a watched page paid two signals and
+// two mprotect calls per store (mp3-ps4 v00.06: most of a job thread's time, 7 fps). exception_handler_ps4.cpp first asks
+// this callback to fire the watches of the whole 16 KiB page [host_page, host_page + length), as if the write had hit
+// them (the data is uploaded again when the GPU next uses it), and retries the store once the page is writable; only a
+// neighbour that is read-only for the guest itself is still single-stepped. Returns whether any watch was fired.
+using SiblingWatchHandler = bool (*)(void* data, void* host_page, size_t length);
+void SetSiblingWatchHandler(SiblingWatchHandler fn, void* data);
+
+// Counts since start: stores single-stepped, 16 KiB pages opened by firing their watches, faults Xenia's handlers took
+// (MMIO, write watches).
+struct FaultCounts {
+  uint64_t sibling_steps;
+  uint64_t sibling_opens;
+  uint64_t handled;
+};
+FaultCounts GetFaultCounts();
+#endif  // REX_PLATFORM_PS4
+
 }  // namespace rex::arch
