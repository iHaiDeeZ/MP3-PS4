+REXCVAR_DEFINE_INT32(gpu_stats_log_s, 10, "GPU", "Diagnostic: gpu_stats_log's period in seconds").range(1, 600);
+// mp3-ps4 (v00.09): Max Payne 3 sets its tonemap's exposure on the CPU from small luminance resolves it reads back
+// (a 64x64 k_32_FLOAT chain down to 8x1, mp3-nx's PORTING.md runs 13-19): without resolve readback the CPU reads 0
+// and the 3D world comes out one flat colour. Reading back every resolve (1280x720 ones too) cost 12.8 -> 8.6 fps;
+// this reads back only resolves up to this size (0 = all).
+// Frame-triggered diagnostics (mp3-ps4 v00.14; for builds without the live console, e.g. the PC one): at swap
+// gpu_debug_frame, a trace of gpu_debug_trace_address (gpu_debug_trace_frames frames), a census of gpu_debug_census
+// frames and/or one frame's resolve dump start, their text written to gpu_debug_dir (trace.txt, census.txt, resolves/).
+REXCVAR_DEFINE_INT32(gpu_debug_frame, 0, "GPU", "Diagnostic: the swap at which the GPU diagnostics below start (0 = never)");
+REXCVAR_DEFINE_STRING(gpu_debug_dir, "", "GPU", "Diagnostic: the folder the frame-triggered diagnostics write to");
+REXCVAR_DEFINE_STRING(gpu_debug_trace_address, "", "GPU", "Diagnostic: the texture address (hex) to trace, empty = none");
+REXCVAR_DEFINE_INT32(gpu_debug_trace_frames, 1, "GPU", "Diagnostic: frames to trace");
+REXCVAR_DEFINE_INT32(gpu_debug_census, 0, "GPU", "Diagnostic: frames of census (0 = none)");
+REXCVAR_DEFINE_BOOL(gpu_debug_resdump, false, "GPU", "Diagnostic: dump one frame's resolves");
+
+REXCVAR_DEFINE_INT32(readback_resolve_max_kb, 0, "GPU",
+                     "Resolve readback only for resolves of up to this many KB (0 = every resolve)")
+    .range(0, 1 << 20);
+
+namespace {
+struct CpStats {
+  uint64_t swaps = 0, draws = 0, copies = 0, queries = 0, memexports = 0, submissions = 0, waits = 0;
+  uint64_t wait_ns = 0;
+  std::chrono::steady_clock::time_point start = std::chrono::steady_clock::now();
+};
+CpStats g_cp_stats;
+
+// mp3-ps4 (v00.10): the GPU census. For a number of frames (rex_gpu_census_start, the live console's "census"), every
+// draw's render targets and textures and every resolve are counted by kind, so the formats and features the game's
+// frames use can be read while it runs and checked against what this back end does with them. Off otherwise.
+std::atomic<uint32_t> g_census_frames_left{0};
+std::mutex g_census_mutex;
+std::map<std::string, uint64_t> g_census;
+uint32_t g_census_frames = 0, g_census_draws = 0, g_census_copies = 0;
+std::string g_census_text;
+
+void CensusAdd(const std::string& key) {
+  std::lock_guard<std::mutex> lock(g_census_mutex);
+  ++g_census[key];
+}
+
+const char* TextureFormatName(uint32_t format) {
+  const rex::graphics::FormatInfo* info = rex::graphics::FormatInfo::Get(format);
+  return info && info->name ? info->name : "?";
+}
+
+void CensusTextures(const rex::graphics::RegisterFile& regs, const rex::graphics::Shader* shader, const char* stage) {
+  if (!shader) return;
+  for (const rex::graphics::Shader::TextureBinding& binding : shader->texture_bindings()) {
+    const rex::graphics::xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(binding.fetch_constant);
+    const uint32_t w = fetch.size_2d.width + 1, h = fetch.size_2d.height + 1;
+    CensusAdd(fmt::format("tex {} type{} {} {}x{} {} exp{} signs{:02X} {}", stage, uint32_t(fetch.type),
+                          TextureFormatName(uint32_t(fetch.format)), w, h, fetch.num_format ? "int" : "frac",
+                          int32_t(fetch.exp_adjust), (fetch.dword_0 >> 2) & 0xFF, fetch.tiled ? "tiled" : "linear"));
+  }
+}
+
+void CensusDraw(const rex::graphics::RegisterFile& regs, const rex::graphics::Shader* vs,
+                const rex::graphics::Shader* ps, bool memexport) {
+  using namespace rex::graphics;
+  {
+    std::lock_guard<std::mutex> lock(g_census_mutex);
+    ++g_census_draws;
+  }
+  const auto surface = regs.Get<reg::RB_SURFACE_INFO>();
+  const uint32_t mask = regs[XE_GPU_REG_RB_COLOR_MASK];
+  std::string rts;
+  for (uint32_t i = 0; i < 4; ++i) {
+    if (!((mask >> (i * 4)) & 0xF) || !ps) continue;
+    const auto info = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[i]);
+    rts += fmt::format(" c{}={}{}", i, xenos::GetColorRenderTargetFormatName(info.color_format),
+                       info.color_exp_bias ? fmt::format("(bias{})", int32_t(info.color_exp_bias)) : std::string());
+  }
+  const auto depth_control = regs.Get<reg::RB_DEPTHCONTROL>();
+  if (depth_control.z_enable || depth_control.stencil_enable) {
+    rts += fmt::format(" depth={}", xenos::GetDepthRenderTargetFormatName(regs.Get<reg::RB_DEPTH_INFO>().depth_format));
+  }
+  CensusAdd(fmt::format("draw msaa{}{}{}", 1u << uint32_t(surface.msaa_samples), rts.empty() ? " (no targets)" : rts,
+                        memexport ? " memexport" : ""));
+  CensusTextures(regs, vs, "vs");
+  CensusTextures(regs, ps, "ps");
+}
+
+void CensusCopy(const rex::graphics::RegisterFile& regs) {
+  using namespace rex::graphics;
+  {
+    std::lock_guard<std::mutex> lock(g_census_mutex);
+    ++g_census_copies;
+  }
+  const auto control = regs.Get<reg::RB_COPY_CONTROL>();
+  const auto dest = regs.Get<reg::RB_COPY_DEST_INFO>();
+  const auto pitch = regs.Get<reg::RB_COPY_DEST_PITCH>();
+  const auto surface = regs.Get<reg::RB_SURFACE_INFO>();
+  std::string source;
+  if (control.copy_src_select >= 4) {
+    source = fmt::format("depth {}", xenos::GetDepthRenderTargetFormatName(regs.Get<reg::RB_DEPTH_INFO>().depth_format));
+  } else {
+    const auto info = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[control.copy_src_select]);
+    source = fmt::format("c{} {}{}", uint32_t(control.copy_src_select),
+                         xenos::GetColorRenderTargetFormatName(info.color_format),
+                         info.color_exp_bias ? fmt::format("(bias{})", int32_t(info.color_exp_bias)) : std::string());
+  }
+  CensusAdd(fmt::format("resolve {} msaa{} -> {} number{} bias{} {}x{}{}{} at {:08X}", source,
+                        1u << uint32_t(surface.msaa_samples), TextureFormatName(uint32_t(dest.copy_dest_format)),
+                        uint32_t(dest.copy_dest_number), int32_t(dest.copy_dest_exp_bias), uint32_t(pitch.copy_dest_pitch),
+                        uint32_t(pitch.copy_dest_height), control.color_clear_enable ? " +clear color" : "",
+                        control.depth_clear_enable ? " +clear depth" : "",
+                        regs[XE_GPU_REG_RB_COPY_DEST_BASE]));
+}
+
+void CensusOnSwap() {
+  if (!g_census_frames_left.load(std::memory_order_relaxed)) return;
+  std::lock_guard<std::mutex> lock(g_census_mutex);
+  ++g_census_frames;
+  if (g_census_frames_left.fetch_sub(1) != 1) return;
+  std::vector<std::pair<uint64_t, std::string>> rows;
+  for (auto& [key, count] : g_census) rows.emplace_back(count, key);
+  std::sort(rows.begin(), rows.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+  std::string text = fmt::format("census of {} frames: {:.0f} draws, {:.1f} resolves a frame\n", g_census_frames,
+                                 double(g_census_draws) / std::max(g_census_frames, 1u),
+                                 double(g_census_copies) / std::max(g_census_frames, 1u));
+  for (const auto& [count, key] : rows) {
+    text += fmt::format("{:9.1f}/frame  {}\n", double(count) / std::max(g_census_frames, 1u), key);
+  }
+  g_census_text = std::move(text);
+  REXGPU_INFO("[census] {} frames, {} kinds", g_census_frames, rows.size());
+}
+
+// mp3-ps4 (v00.12): one frame's resolves as files (rex_gpu_resdump_start, the live console's "dumpres"). For one
+// frame resolve readback is exact (readback_resolve full, every size), and each resolve's bytes - as the guest gets
+// them in its memory: tiled, in the destination's endianness - go to <dir>/rNNN_<address>_<format>_<w>x<h>.bin with a
+// line in <dir>/index.txt (source, destination, number format, exp bias, MSAA, clears). The settings come back after.
+std::atomic<uint32_t> g_resdump_state{0};  // 0 off, 1 armed (from the next frame), 2 recording this frame
+std::string g_resdump_dir;
+std::string g_resdump_saved_mode, g_resdump_saved_max;
+uint32_t g_resdump_count = 0;
+FILE* g_resdump_index = nullptr;
+
+void ResDumpWrite(const rex::graphics::RegisterFile& regs, uint32_t address, uint32_t length, const void* data) {
+  using namespace rex::graphics;
+  const auto control = regs.Get<reg::RB_COPY_CONTROL>();
+  const auto dest = regs.Get<reg::RB_COPY_DEST_INFO>();
+  const auto pitch = regs.Get<reg::RB_COPY_DEST_PITCH>();
+  const auto surface = regs.Get<reg::RB_SURFACE_INFO>();
+  std::string source;
+  if (control.copy_src_select >= 4) {
+    source = fmt::format("depth_{}", xenos::GetDepthRenderTargetFormatName(regs.Get<reg::RB_DEPTH_INFO>().depth_format));
+  } else {
+    const auto info = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[control.copy_src_select]);
+    source = fmt::format("c{}_{}_bias{}", uint32_t(control.copy_src_select),
+                         xenos::GetColorRenderTargetFormatName(info.color_format), int32_t(info.color_exp_bias));
+  }
+  const char* format = TextureFormatName(uint32_t(dest.copy_dest_format));
+  const uint32_t n = g_resdump_count++;
+  const std::string name = fmt::format("r{:03}_{:08X}_{}_{}x{}.bin", n, address, format,
+                                       uint32_t(pitch.copy_dest_pitch), uint32_t(pitch.copy_dest_height));
+  if (FILE* f = std::fopen((g_resdump_dir + "/" + name).c_str(), "wb")) {
+    std::fwrite(data, 1, length, f);
+    std::fclose(f);
+  }
+  if (g_resdump_index) {
+    std::fprintf(g_resdump_index,
+                 "%s address=%08X length=%u format=%s format_id=%u pitch=%u height=%u endian=%u number=%u "
+                 "exp_bias=%d swap=%u source=%s msaa=%u clear_color=%u clear_depth=%u\n",
+                 name.c_str(), address, length, format, uint32_t(dest.copy_dest_format),
+                 uint32_t(pitch.copy_dest_pitch), uint32_t(pitch.copy_dest_height), uint32_t(dest.copy_dest_endian),
+                 uint32_t(dest.copy_dest_number), int32_t(dest.copy_dest_exp_bias), uint32_t(dest.copy_dest_swap),
+                 source.c_str(), 1u << uint32_t(surface.msaa_samples), uint32_t(control.color_clear_enable),
+                 uint32_t(control.depth_clear_enable));
+  }
+}
+
+void ResDumpOnSwap() {
+  const uint32_t state = g_resdump_state.load();
+  if (state == 1) {
+    g_resdump_saved_mode = rex::cvar::GetFlagByName("readback_resolve");
+    g_resdump_saved_max = rex::cvar::GetFlagByName("readback_resolve_max_kb");
+    rex::cvar::SetFlagByName("readback_resolve", "full");
+    rex::cvar::SetFlagByName("readback_resolve_max_kb", "0");
+    g_resdump_count = 0;
+    g_resdump_index = std::fopen((g_resdump_dir + "/index.txt").c_str(), "w");
+    g_resdump_state = 2;
+  } else if (state == 2) {
+    if (g_resdump_index) std::fclose(g_resdump_index);
+    g_resdump_index = nullptr;
+    rex::cvar::SetFlagByName("readback_resolve", g_resdump_saved_mode);
+    rex::cvar::SetFlagByName("readback_resolve_max_kb", g_resdump_saved_max);
+    REXGPU_INFO("[resdump] {} resolves to {}", g_resdump_count, g_resdump_dir);
+    g_resdump_state = 0;
+  }
+}
+
+// mp3-ps4 (v00.14): live switches to bisect a frame. Draws using the pixel shader gpu_debug_skip_ps (hex ucode
+// hash) are skipped, and so are the frame's draws gpu_debug_skip_from..gpu_debug_skip_to (counted from the swap, as the
+// trace's D numbers; to = 0: none). Read once a frame.
+REXCVAR_DEFINE_STRING(gpu_debug_skip_ps, "", "GPU", "Diagnostic: skip the draws with this pixel shader (hex hash)");
+REXCVAR_DEFINE_INT32(gpu_debug_skip_from, 0, "GPU", "Diagnostic: the first of the frame's draws to skip");
+REXCVAR_DEFINE_INT32(gpu_debug_skip_to, 0, "GPU", "Diagnostic: the last of the frame's draws to skip (0 = none)");
+
+uint64_t g_skip_ps = 0;
+uint32_t g_skip_from = 0, g_skip_to = 0, g_frame_draw = 0;
+
+void DebugSkipOnSwap() {
+  const std::string ps = REXCVAR_GET(gpu_debug_skip_ps);
+  g_skip_ps = ps.empty() ? 0 : std::strtoull(ps.c_str(), nullptr, 16);
+  g_skip_from = uint32_t(std::max(REXCVAR_GET(gpu_debug_skip_from), int32_t(0)));
+  g_skip_to = uint32_t(std::max(REXCVAR_GET(gpu_debug_skip_to), int32_t(0)));
+  g_frame_draw = 0;
+}
+
+bool DebugSkipDraw(const rex::graphics::Shader* ps) {
+  const uint32_t n = g_frame_draw++;
+  if (g_skip_ps && ps && ps->ucode_data_hash() == g_skip_ps) return true;
+  return g_skip_to && n >= g_skip_from && n <= g_skip_to;
+}
+
+// mp3-ps4 (v00.13): the draw tracer (rex_gpu_trace_start, the live console's "trace"). For N frames, in order: every
+// resolve (with its source's EDRAM base) and every draw that binds a texture at the traced address - its render
+// targets (EDRAM base, format, exp bias), colour mask, blend, depth, mode, scissor, viewport, shader hashes, the
+// matching fetch constant and, once per shader, the pixel shader's disassembly. To follow one texture through a frame.
+std::atomic<uint32_t> g_trace_frames_left{0};
+uint32_t g_trace_address = 0;
+uint32_t g_trace_frame = 0, g_trace_draw = 0, g_trace_copy = 0;
+// v00.14: the frame's draws gpu_debug_trace_from..gpu_debug_trace_to are traced whatever they bind (to = 0: none).
+REXCVAR_DEFINE_INT32(gpu_debug_trace_from, 0, "GPU", "Diagnostic: the first of the frame's draws the trace prints");
+REXCVAR_DEFINE_INT32(gpu_debug_trace_to, 0, "GPU", "Diagnostic: the last of the frame's draws the trace prints (0 = none)");
+uint32_t g_trace_from = 0, g_trace_to = 0;
+std::string g_trace_text, g_trace_result;
+std::set<uint64_t> g_trace_shaders;
+
+float TraceFloat(const rex::graphics::RegisterFile& regs, uint32_t index) {
+  float f;
+  const uint32_t v = regs[index];
+  std::memcpy(&f, &v, sizeof(f));
+  return f;
+}
+
+void TraceDraw(const rex::graphics::RegisterFile& regs, const rex::graphics::Shader* vs,
+               const rex::graphics::Shader* ps) {
+  using namespace rex::graphics;
+  const uint32_t n = g_trace_draw++;
+  const bool in_range = g_trace_to && n >= g_trace_from && n <= g_trace_to;
+  std::string hits;
+  for (const Shader* shader : {vs, ps}) {
+    if (!shader) continue;
+    for (const Shader::TextureBinding& b : shader->texture_bindings()) {
+      const xenos::xe_gpu_texture_fetch_t f = regs.GetTextureFetch(b.fetch_constant);
+      if (!in_range && (uint32_t(f.base_address) << 12) != g_trace_address) continue;
+      hits += fmt::format(" {}:t{}({:08X} {:08X} {:08X} {:08X} {:08X} {:08X})", shader == vs ? "vs" : "ps",
+                          b.fetch_constant, f.dword_0, f.dword_1, f.dword_2, f.dword_3, f.dword_4, f.dword_5);
+    }
+  }
+  if (hits.empty() && !in_range) return;
+  if (in_range && vs && g_trace_shaders.insert(vs->ucode_data_hash()).second) {
+    g_trace_text += fmt::format("      vs {:016X} disassembly:\n{}\n", vs->ucode_data_hash(), vs->ucode_disassembly());
+  }
+  std::string rts;
+  const uint32_t mask = regs[XE_GPU_REG_RB_COLOR_MASK];
+  for (uint32_t i = 0; i < 4; ++i) {
+    if (!((mask >> (i * 4)) & 0xF)) continue;
+    const auto info = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[i]);
+    rts += fmt::format(" c{}@{}={}(bias{})", i, uint32_t(info.color_base),
+                       xenos::GetColorRenderTargetFormatName(info.color_format), int32_t(info.color_exp_bias));
+  }
+  const auto depth = regs.Get<reg::RB_DEPTH_INFO>();
+  g_trace_text += fmt::format(
+      "  D{} binds the address:{}\n      targets{} depth@{} mask {:08X} blend0 {:08X} depthctl {:08X} mode {:08X} "
+      "surface {:08X} scissor {:08X}-{:08X} offset {:08X} vport x {:.1f}+{:.1f} y {:.1f}+{:.1f} vs {:016X} ps {:016X}\n",
+      n, hits, rts.empty() ? " (none)" : rts, uint32_t(depth.depth_base), mask, regs[XE_GPU_REG_RB_BLENDCONTROL0],
+      regs[XE_GPU_REG_RB_DEPTHCONTROL], regs[XE_GPU_REG_RB_MODECONTROL], regs[XE_GPU_REG_RB_SURFACE_INFO],
+      regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL], regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR],
+      regs[XE_GPU_REG_PA_SC_WINDOW_OFFSET], TraceFloat(regs, XE_GPU_REG_PA_CL_VPORT_XSCALE),
+      TraceFloat(regs, XE_GPU_REG_PA_CL_VPORT_XOFFSET), TraceFloat(regs, XE_GPU_REG_PA_CL_VPORT_YSCALE),
+      TraceFloat(regs, XE_GPU_REG_PA_CL_VPORT_YOFFSET), vs ? vs->ucode_data_hash() : 0,
+      ps ? ps->ucode_data_hash() : 0);
+  if (ps) {
+    // The pixel shader's float constants as this draw has them (pixel shader c<i> is register 256 + i).
+    std::string consts;
+    const auto& map = ps->constant_register_map();
+    for (uint32_t i = 0; i < 256; ++i) {
+      if (!(map.float_bitmap[i >> 6] & (uint64_t(1) << (i & 63)))) continue;
+      const uint32_t r = XE_GPU_REG_SHADER_CONSTANT_256_X + 4 * i;
+      consts += fmt::format(" c{}=({:g} {:g} {:g} {:g})", i, TraceFloat(regs, r), TraceFloat(regs, r + 1),
+                            TraceFloat(regs, r + 2), TraceFloat(regs, r + 3));
+    }
+    if (!consts.empty()) g_trace_text += "      ps constants:" + consts + "\n";
+  }
+  if (ps && g_trace_shaders.insert(ps->ucode_data_hash()).second) {
+    g_trace_text += fmt::format("      ps {:016X} disassembly:\n{}\n", ps->ucode_data_hash(), ps->ucode_disassembly());
+  }
+}
+
+void TraceCopy(const rex::graphics::RegisterFile& regs) {
+  using namespace rex::graphics;
+  const uint32_t n = g_trace_copy++;
+  const auto control = regs.Get<reg::RB_COPY_CONTROL>();
+  const auto dest = regs.Get<reg::RB_COPY_DEST_INFO>();
+  const auto pitch = regs.Get<reg::RB_COPY_DEST_PITCH>();
+  std::string source;
+  if (control.copy_src_select >= 4) {
+    const auto depth = regs.Get<reg::RB_DEPTH_INFO>();
+    source = fmt::format("depth@{} {}", uint32_t(depth.depth_base),
+                         xenos::GetDepthRenderTargetFormatName(depth.depth_format));
+  } else {
+    const auto info = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[control.copy_src_select]);
+    source = fmt::format("c{}@{} {}(bias{})", uint32_t(control.copy_src_select), uint32_t(info.color_base),
+                         xenos::GetColorRenderTargetFormatName(info.color_format), int32_t(info.color_exp_bias));
+  }
+  g_trace_text += fmt::format("  R{} after D{}: {} -> {:08X} {} {}x{} number{} bias{}{}{}\n", n, g_trace_draw, source,
+                              regs[XE_GPU_REG_RB_COPY_DEST_BASE], TextureFormatName(uint32_t(dest.copy_dest_format)),
+                              uint32_t(pitch.copy_dest_pitch), uint32_t(pitch.copy_dest_height),
+                              uint32_t(dest.copy_dest_number), int32_t(dest.copy_dest_exp_bias),
+                              control.color_clear_enable ? " +clear color" : "",
+                              control.depth_clear_enable ? " +clear depth" : "");
+}
+
+void TraceOnSwap() {
+  if (!g_trace_frames_left.load(std::memory_order_relaxed)) return;
+  g_trace_text += fmt::format("== frame {} end: {} draws, {} resolves\n", g_trace_frame, g_trace_draw, g_trace_copy);
+  ++g_trace_frame;
+  g_trace_draw = g_trace_copy = 0;
+  if (g_trace_frames_left.fetch_sub(1) == 1) {
+    std::lock_guard<std::mutex> lock(g_census_mutex);
+    g_trace_result = std::move(g_trace_text);
+    g_trace_text.clear();
+  }
+}
+
+void FrameDebugWrite(const std::string& dir, const char* name, const std::string& text) {
+  if (FILE* f = std::fopen((dir + "/" + name).c_str(), "wb")) {
+    std::fwrite(text.data(), 1, text.size(), f);
+    std::fclose(f);
+  }
+}
+
+// The diagnostics the mp3 live console calls (mp3/ps4/mp3_ps4_live.cpp): on Windows the GPU plugin is a DLL,
+// so they are exported from it and looked up by name.
+#if defined(_WIN32)
+#define REX_GPU_DIAG extern "C" __declspec(dllexport)
+#else
+#define REX_GPU_DIAG extern "C"
+#endif
+
+REX_GPU_DIAG void rex_gpu_resdump_start(const char* dir);
+REX_GPU_DIAG void rex_gpu_trace_start(uint32_t address, uint32_t frames);
+REX_GPU_DIAG void rex_gpu_census_start(uint32_t frames);
+
+void FrameDebugOnSwap() {
+  static uint32_t swaps = 0;
+  static bool trace_pending = false, census_pending = false;
+  ++swaps;
+  const int32_t at = REXCVAR_GET(gpu_debug_frame);
+  const std::string dir = REXCVAR_GET(gpu_debug_dir);
+  if (at > 0 && swaps == uint32_t(at) && !dir.empty()) {
+    std::error_code ec;
+    std::filesystem::create_directories(dir, ec);
+    const std::string trace = REXCVAR_GET(gpu_debug_trace_address);
+    if (!trace.empty()) {
+      rex_gpu_trace_start(uint32_t(std::strtoul(trace.c_str(), nullptr, 16)),
+                       uint32_t(std::max(REXCVAR_GET(gpu_debug_trace_frames), 1)));
+      trace_pending = true;
+    }
+    if (REXCVAR_GET(gpu_debug_census) > 0) {
+      rex_gpu_census_start(uint32_t(REXCVAR_GET(gpu_debug_census)));
+      census_pending = true;
+    }
