+}
+
+void VulkanCommandProcessor::QueueAsyncSubmitJob(AsyncSubmitJob&& job) {
+  {
+    std::lock_guard<std::mutex> lock(async_submit_mutex_);
+    job.sequence = async_jobs_queued_.load(std::memory_order_relaxed) + 1;
+    const bool fence_only = job.fence_only;
+    const uint64_t submission = job.submission;
+    async_submit_jobs_.push_back(std::move(job));
+    async_jobs_queued_.store(async_submit_jobs_.back().sequence, std::memory_order_release);
+    if (!fence_only) {
+      async_submit_queued_.store(submission, std::memory_order_release);
+    }
+  }
+  async_submit_cv_.notify_one();
+}
+
+void VulkanCommandProcessor::RefresherSubmitFence(void* context, VkFence fence) {
+  auto* processor = static_cast<VulkanCommandProcessor*>(context);
+  AsyncSubmitJob job;
+  job.fence = fence;
+  job.fence_only = true;
+  processor->QueueAsyncSubmitJob(std::move(job));
+}
+
+void VulkanCommandProcessor::RefresherAwaitSubmitted(void* context) {
+  // On the presenter's thread: every job queued so far (the guest output's last refresh among them) submitted.
+  auto* processor = static_cast<VulkanCommandProcessor*>(context);
+  const uint64_t target = processor->async_jobs_queued_.load(std::memory_order_acquire);
+  if (processor->async_jobs_done_.load(std::memory_order_acquire) >= target) {
+    return;
+  }
+  std::unique_lock<std::mutex> lock(processor->async_submit_mutex_);
+  processor->async_submit_done_cv_.wait(lock, [processor, target] {
+    return processor->async_jobs_done_.load(std::memory_order_acquire) >= target ||
+           processor->async_submit_failed_.load(std::memory_order_acquire);
+  });
+}
+
+void VulkanCommandProcessor::AsyncSubmitAwait(uint64_t submission) {
+  if (!async_submit_enabled_) {
+    return;
+  }
+  cp_perf::ScopeTicks cp_perf_time(cp_perf::await_ticks);
+  // mp3-ps4 (v00.17): up to ~2 ms of spinning before sleeping: the command processor has nothing else to do here.
+  {
+    const auto spin_until = std::chrono::steady_clock::now() + std::chrono::milliseconds(2);
+    for (uint32_t spins = 0; async_submitted_.load(std::memory_order_acquire) < submission &&
+                             !async_submit_failed_.load(std::memory_order_relaxed);
+         ++spins) {
+      if ((spins & 63) == 63 && std::chrono::steady_clock::now() > spin_until) {
+        break;
+      }
+      _mm_pause();
+    }
+  }
+  std::unique_lock<std::mutex> lock(async_submit_mutex_);
+  async_submit_done_cv_.wait(lock, [this, submission] {
+    return async_submitted_.load(std::memory_order_acquire) >= submission ||
+           async_submit_failed_.load(std::memory_order_acquire);
+  });
+}
+
+void VulkanCommandProcessor::AsyncSubmitStop() {
+  if (!async_submit_thread_.joinable()) {
+    return;
+  }
+  if (refresher_submit_hooks_installed_ && graphics_system_) {
+    if (auto* presenter = static_cast<ui::vulkan::VulkanPresenter*>(graphics_system_->presenter())) {
+      presenter->SetRefresherSubmitHooks(nullptr);
+    }
+    refresher_submit_hooks_installed_ = false;
+  }
+  {
+    std::lock_guard<std::mutex> lock(async_submit_mutex_);
+    async_submit_stop_ = true;
+  }
+  async_submit_cv_.notify_all();
+  async_submit_thread_.join();
+  async_submit_enabled_ = false;
+}
