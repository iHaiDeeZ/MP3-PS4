diff --git a/src/core/memory_ps4.cpp b/src/core/memory_ps4.cpp
new file mode 100644
index 0000000..15ed41c
--- /dev/null
+++ b/src/core/memory_ps4.cpp
@@ -0,0 +1,222 @@
+/**
+ * @file        rex/core/memory_ps4.cpp
+ * @brief       SDK memory API (rex::memory) on the PS4 guest memory core (guest_memory_ps4.cpp)
+ *
+ * Callers: xmemory.cpp (the guest heaps) and the MMIO handler's QueryProtect. Everything they
+ * pass lies inside the guest window, except AllocFixed(nullptr), which is plain host memory.
+ *
+ * Differences from memory_posix.cpp
+ *   - the kernel picks the window's address (GetFileMappingBase), as on Horizon;
+ *   - the "file" is the core's backing: CreateFileMappingHandle reserves the window and
+ *     AllocFixed(kCommit) commits backing under the view it is called on;
+ *   - Decommit and Release take access away in that view only. The backing stays, as with
+ *     Linux's shared memory, since the mirrors still show it.
+ */
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_PS4
+
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+
+#include <rex/logging.h>
+#include <rex/memory/utils.h>
+
+#include "guest_memory_ps4.h"
+
+namespace rex::memory {
+
+namespace {
+
+constexpr size_t kPage = 0x1000;
+constexpr FileMappingHandle kGuestMapping = 1;
+
+constexpr size_t AlignUp(size_t v, size_t a = kPage) { return (v + a - 1) & ~(a - 1); }
+
+RexGmAccess ToGm(PageAccess a) {
+  switch (a) {
+    case PageAccess::kNoAccess:
+      return REX_GM_NONE;
+    case PageAccess::kReadOnly:
+    case PageAccess::kExecuteReadOnly:
+      return REX_GM_READ;
+    case PageAccess::kReadWrite:
+    case PageAccess::kExecuteReadWrite:
+      return REX_GM_WRITE;
+  }
+  return REX_GM_NONE;
+}
+
+PageAccess FromGm(RexGmAccess a) {
+  switch (a) {
+    case REX_GM_NONE:
+      return PageAccess::kNoAccess;
+    case REX_GM_READ:
+      return PageAccess::kReadOnly;
+    case REX_GM_WRITE:
+      return PageAccess::kReadWrite;
+  }
+  return PageAccess::kNoAccess;
+}
+
+bool InWindow(const void* p, size_t len) {
+  const uint8_t* base = RexGmBase();
+  if (!base || !p) return false;
+  const uintptr_t a = reinterpret_cast<uintptr_t>(p);
+  const uintptr_t b = reinterpret_cast<uintptr_t>(base);
+  return a >= b && a + len <= b + RexGmSize();
+}
+
+}  // namespace
+
+size_t page_size() { return kPage; }
+
+// Backing is committed in 64 KiB chunks, so views start on 64 KiB offsets: like Windows, xmemory.cpp
+// then rounds the 0xE0000000 view's 4 KiB offset away and adds it back (PhysicalHostOffset).
+size_t allocation_granularity() { return 0x10000; }
+
+bool IsWritableExecutableMemorySupported() {
+  // Static recompilation: no code is generated at run time.
+  return false;
+}
+
+void* GetFileMappingBase(FileMappingHandle handle) {
+  return handle == kGuestMapping ? RexGmBase() : nullptr;
+}
+
+void* AllocFixed(void* base_address, size_t length, AllocationType allocation_type,
+                 PageAccess access) {
+  if (length == 0) return nullptr;
+
+  if (!base_address) {
+    const size_t len = AlignUp(length);
+    void* p = std::aligned_alloc(kPage, len);
+    if (p) std::memset(p, 0, len);
+    return p;
+  }
+
+  if (!InWindow(base_address, length)) {
+    REXLOG_ERROR("AllocFixed outside the guest window: 0x{:016X} (0x{:X} bytes)",
+                 reinterpret_cast<uintptr_t>(base_address), length);
+    return nullptr;
+  }
+
+  if (allocation_type == AllocationType::kReserve) {
+    // The whole window is reserved already; uncommitted pages fault like PROT_NONE.
+    return base_address;
+  }
+
+  size_t offset = 0;
+  if (!RexGmWindowToOffset(reinterpret_cast<uint64_t>(base_address), &offset)) {
+    REXLOG_ERROR("AllocFixed: 0x{:016X} is in no guest view",
+                 reinterpret_cast<uintptr_t>(base_address));
+    return nullptr;
+  }
+  // Permissions first, so the new backing is mapped with them in this view.
+  if (!RexGmProtect(static_cast<uint8_t*>(base_address), length, ToGm(access), nullptr) ||
+      !RexGmCommit(offset, length)) {
+    REXLOG_ERROR("AllocFixed: could not commit 0x{:X} bytes at 0x{:016X}: 0x{:08X}; "
+                 "{} MB committed",
+                 length, reinterpret_cast<uintptr_t>(base_address), RexGmLastResult(),
+                 RexGmCommittedBytes() >> 20);
+    return nullptr;
+  }
+  return base_address;
+}
+
+bool DeallocFixed(void* base_address, size_t length, DeallocationType deallocation_type) {
+  if (!base_address) return false;
+  if (!InWindow(base_address, length ? length : 1)) {
+    if (deallocation_type == DeallocationType::kRelease) std::free(base_address);
+    return true;
+  }
+  // Linux fails munmap(base, 0); keep that behaviour.
+  if (length == 0) return false;
+  switch (deallocation_type) {
+    case DeallocationType::kDecommit:
+    case DeallocationType::kRelease:
+      return RexGmProtect(static_cast<uint8_t*>(base_address), length, REX_GM_NONE, nullptr);
+    default:
+      return false;
+  }
+}
+
+bool Protect(void* base_address, size_t length, PageAccess access, PageAccess* out_old_access) {
+  if (out_old_access) *out_old_access = PageAccess::kNoAccess;
+  if (!InWindow(base_address, length)) {
+    REXLOG_ERROR("Protect outside the guest window: 0x{:016X} (0x{:X} bytes)",
+                 reinterpret_cast<uintptr_t>(base_address), length);
+    return false;
+  }
+  RexGmAccess old = REX_GM_NONE;
+  const bool ok = RexGmProtect(static_cast<uint8_t*>(base_address), length, ToGm(access), &old);
+  if (out_old_access) *out_old_access = FromGm(old);
+  if (!ok) {
+    REXLOG_ERROR("Protect: failure 0x{:08X} at 0x{:016X} (0x{:X} bytes)", RexGmLastResult(),
+                 reinterpret_cast<uintptr_t>(base_address), length);
+  }
+  return ok;
+}
+
+bool QueryProtect(void* base_address, size_t& length, PageAccess& access_out) {
+  access_out = PageAccess::kNoAccess;
+  if (!InWindow(base_address, 1)) {
+    length = 0;
+    return false;
+  }
+  size_t len = length;
+  RexGmAccess a = REX_GM_NONE;
+  if (!RexGmQueryProtect(static_cast<uint8_t*>(base_address), &len, &a)) {
+    length = 0;
+    return false;
+  }
+  length = len;
+  access_out = FromGm(a);
+  return true;
+}
+
+FileMappingHandle CreateFileMappingHandle(const std::filesystem::path& path, size_t length,
+                                          PageAccess access, bool commit) {
+  (void)path;
+  (void)access;
+  (void)commit;
+  if (!RexGmBase() && !RexGmInit(AlignUp(length))) {
+    REXLOG_ERROR("Could not reserve the guest window of 0x{:X} bytes: 0x{:08X}", length,
+                 RexGmLastResult());
+    return kFileMappingHandleInvalid;
+  }
+  return kGuestMapping;
+}
+
+void CloseFileMappingHandle(FileMappingHandle handle, const std::filesystem::path& path) {
+  (void)path;
+  if (handle == kGuestMapping) RexGmShutdown();
+}
+
+void* MapFileView(FileMappingHandle handle, void* base_address, size_t length, PageAccess access,
+                  size_t file_offset) {
+  if (handle != kGuestMapping || !base_address || (file_offset % kPage) != 0 ||
+      !InWindow(base_address, length)) {
+    return nullptr;
+  }
+  if (!RexGmAddView(static_cast<uint8_t*>(base_address), file_offset, length, ToGm(access))) {
+    REXLOG_ERROR("MapFileView: view 0x{:016X} (0x{:X} bytes from 0x{:X}) failed: 0x{:08X}",
+                 reinterpret_cast<uintptr_t>(base_address), length, file_offset,
+                 RexGmLastResult());
+    return nullptr;
+  }
+  return base_address;
+}
+
+bool UnmapFileView(FileMappingHandle handle, void* base_address, size_t length) {
+  (void)base_address;
+  (void)length;
+  // Views go away together in CloseFileMappingHandle; xmemory.cpp only unmaps them right before.
+  return handle == kGuestMapping;
+}
+
+}  // namespace rex::memory
+
+#endif  // REX_PLATFORM_PS4
diff --git a/src/core/seh_ps4.cpp b/src/core/seh_ps4.cpp
new file mode 100644
index 0000000..a2808e4
--- /dev/null
+++ b/src/core/seh_ps4.cpp
@@ -0,0 +1,41 @@
+/**
+ * @file        rex/core/seh_ps4.cpp
+ * @brief       SEH interface on the PS4
+ *
+ * seh_posix.cpp installs its own SIGSEGV/SIGBUS handlers and throws a C++ exception out of the
+ * signal frame. On the PS4 that would replace the guest memory handler (exception_handler_ps4.cpp:
+ * sibling faults, MMIO, write watches), and unwinding through a kernel signal frame is not
+ * something OpenOrbis's libunwind is known to do. So faults inside SEH scopes are fatal here, as on
+ * the Switch: they reach the kit's crash log through the exception handler's chain.
+ */
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_PS4
+
+#include <cstdlib>
+
+#include <rex/platform/exceptions.h>
+#include <rex/platform/seh.h>
+
+namespace rex::platform {
+
+static thread_local SehThreadState tls_seh_state;
+static thread_local bool tls_seh_active = false;
+
+SehThreadState& seh_thread_state() { return tls_seh_state; }
+
+int seh_filter(uint32_t /*code*/, void* /*exception_pointers*/) {
+  // Only used on Windows.
+  return 0;
+}
+
+[[noreturn]] void seh_rethrow() { std::abort(); }
+
+void seh_initialize() { g_seh_initialized.store(true); }
+
+bool& seh_active() { return tls_seh_active; }
+
+}  // namespace rex::platform
+
+#endif  // REX_PLATFORM_PS4
