+void RenderDk::LeerOclusionesTerminadas() {
+  while (!oclusion_pendientes_.empty()) {
+    const ConsultaDk& c = oclusion_pendientes_.front();
+    if ((nucleo_.TrabajoAbierto() && c.trabajo == trabajo_) || !nucleo_.TrabajoTerminado(c.trabajo)) {
+      break;
