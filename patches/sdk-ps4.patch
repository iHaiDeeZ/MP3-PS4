+void RenderDk::AnotarVolcado(const ImagenDk& imagen, uint32_t base, uint32_t formato_guest) {
+  if (!REXCVAR_GET(nfsmw_dk_volcado_resueltas)) return;
+  if (!REXCVAR_GET(x360_volcado_en_vivo)) {
+    VolcarResuelta(imagen, base, formato_guest);
+    return;
+  }
+  for (const auto& [b, f] : volcado_en_vivo_) {
+    if (b == base) return;
+  }
+  volcado_en_vivo_.emplace_back(base, formato_guest);
+}
+
+void RenderDk::VolcarPaseAnterior() {
+  const uint32_t pase = volcado_pases_++;
+  if (int32_t(pase) < REXCVAR_GET(nfsmw_dk_volcado_pase_desde) || int32_t(pase) > REXCVAR_GET(nfsmw_dk_volcado_pase_hasta)) {
+    return;
