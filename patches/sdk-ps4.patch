+/**
+ * @file        rex/input/ps4/ps4_input_driver.cpp
+ * @brief       Input driver for DualShock 4 pads on the PS4 through libScePad
+ *
+ * Slot i is the i-th signed-in user's pad; users who sign in (or out) later are picked up at the
+ * next enumeration. The DualShock 4's face buttons sit where the 360 pad's do (Cross = A,
+ * Circle = B, Square = X, Triangle = Y), Options is START, the touch pad click BACK, L2/R2 the
+ * analog triggers. Keystrokes (XInputGetKeystroke) follow the PC's SDL driver.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/input/ps4/ps4_input_driver.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+#include <string>
+#include <tuple>
+
+#include <rex/chrono/clock.h>
+#include <rex/logging.h>
+#include <rex/ui/virtual_key.h>
+
+#include <orbis/Pad.h>
+#include <orbis/UserService.h>
+
+namespace rex::input::ps4 {
+
+namespace {
+
+constexpr int16_t kThumbThreshold = 0x4E00;
+constexpr uint8_t kTriggerThreshold = 0x1F;
+constexpr uint32_t kRepeatDelayMs = 400;
+constexpr uint32_t kRepeatRateMs = 100;
+
+// Low byte of a DeviceId is the slot, the rest a per-run connection counter, so a pad that comes
+// back never reuses an id.
+constexpr uint64_t kDeviceIdTag = 0x503400;  // "P4"
+
+std::atomic<bool> g_menu_combo{false};
+
+struct ButtonMap {
+  uint32_t ds4;
+  uint16_t xinput;
+};
+constexpr ButtonMap kButtons[] = {
+    {ORBIS_PAD_BUTTON_CROSS, X_INPUT_GAMEPAD_A},
+    {ORBIS_PAD_BUTTON_CIRCLE, X_INPUT_GAMEPAD_B},
+    {ORBIS_PAD_BUTTON_SQUARE, X_INPUT_GAMEPAD_X},
+    {ORBIS_PAD_BUTTON_TRIANGLE, X_INPUT_GAMEPAD_Y},
+    {ORBIS_PAD_BUTTON_TOUCH_PAD, X_INPUT_GAMEPAD_BACK},
+    {ORBIS_PAD_BUTTON_OPTIONS, X_INPUT_GAMEPAD_START},
+    {ORBIS_PAD_BUTTON_L3, X_INPUT_GAMEPAD_LEFT_THUMB},
+    {ORBIS_PAD_BUTTON_R3, X_INPUT_GAMEPAD_RIGHT_THUMB},
+    {ORBIS_PAD_BUTTON_L1, X_INPUT_GAMEPAD_LEFT_SHOULDER},
+    {ORBIS_PAD_BUTTON_R1, X_INPUT_GAMEPAD_RIGHT_SHOULDER},
+    {ORBIS_PAD_BUTTON_UP, X_INPUT_GAMEPAD_DPAD_UP},
+    {ORBIS_PAD_BUTTON_DOWN, X_INPUT_GAMEPAD_DPAD_DOWN},
+    {ORBIS_PAD_BUTTON_LEFT, X_INPUT_GAMEPAD_DPAD_LEFT},
+    {ORBIS_PAD_BUTTON_RIGHT, X_INPUT_GAMEPAD_DPAD_RIGHT},
+};
+
+// The order of this list is also the order in which events are sent if several buttons change at
+// once. Same table as the SDL driver.
+constexpr std::array<rex::ui::VirtualKey, 34> kVkLookup = {
+    // 00 - True buttons from xinput button field
+    rex::ui::VirtualKey::kXInputPadDpadUp,
+    rex::ui::VirtualKey::kXInputPadDpadDown,
+    rex::ui::VirtualKey::kXInputPadDpadLeft,
+    rex::ui::VirtualKey::kXInputPadDpadRight,
+    rex::ui::VirtualKey::kXInputPadStart,
+    rex::ui::VirtualKey::kXInputPadBack,
+    rex::ui::VirtualKey::kXInputPadLThumbPress,
+    rex::ui::VirtualKey::kXInputPadRThumbPress,
+    rex::ui::VirtualKey::kXInputPadLShoulder,
+    rex::ui::VirtualKey::kXInputPadRShoulder,
+    rex::ui::VirtualKey::kNone, /* Guide has no VK */
+    rex::ui::VirtualKey::kNone, /* Unknown */
+    rex::ui::VirtualKey::kXInputPadA,
+    rex::ui::VirtualKey::kXInputPadB,
+    rex::ui::VirtualKey::kXInputPadX,
+    rex::ui::VirtualKey::kXInputPadY,
+    // 16 - Fake buttons generated from analog inputs
+    rex::ui::VirtualKey::kXInputPadLTrigger,
+    rex::ui::VirtualKey::kXInputPadRTrigger,
+    // 18
+    rex::ui::VirtualKey::kXInputPadLThumbUp,
+    rex::ui::VirtualKey::kXInputPadLThumbDown,
+    rex::ui::VirtualKey::kXInputPadLThumbRight,
+    rex::ui::VirtualKey::kXInputPadLThumbLeft,
+    rex::ui::VirtualKey::kXInputPadLThumbUpLeft,
+    rex::ui::VirtualKey::kXInputPadLThumbUpRight,
+    rex::ui::VirtualKey::kXInputPadLThumbDownRight,
+    rex::ui::VirtualKey::kXInputPadLThumbDownLeft,
+    // 26
+    rex::ui::VirtualKey::kXInputPadRThumbUp,
+    rex::ui::VirtualKey::kXInputPadRThumbDown,
+    rex::ui::VirtualKey::kXInputPadRThumbRight,
+    rex::ui::VirtualKey::kXInputPadRThumbLeft,
+    rex::ui::VirtualKey::kXInputPadRThumbUpLeft,
+    rex::ui::VirtualKey::kXInputPadRThumbUpRight,
+    rex::ui::VirtualKey::kXInputPadRThumbDownRight,
+    rex::ui::VirtualKey::kXInputPadRThumbDownLeft,
+};
+
+// 0..255 (128 the centre) to -32768..32767; XInput's +y is up, the DualShock's down.
+int16_t Axis(uint8_t v, bool flip) {
+  int a = (int(v) - 128) * 258;
+  if (flip) a = -a;
+  return static_cast<int16_t>(std::clamp(a, -32768, 32767));
+}
+
+// Analog inputs past their thresholds as button bits 16..33, as the SDL driver does.
+uint64_t AnalogToKeyfield(const X_INPUT_GAMEPAD& gamepad) {
+  uint64_t f = 0;
+  f |= static_cast<uint64_t>(gamepad.left_trigger > kTriggerThreshold) << 16;
+  f |= static_cast<uint64_t>(gamepad.right_trigger > kTriggerThreshold) << 17;
+  auto thumb_x = static_cast<int16_t>(gamepad.thumb_lx);
+  auto thumb_y = static_cast<int16_t>(gamepad.thumb_ly);
+  for (size_t i = 0; i <= 8; i = i + 8) {
+    uint64_t u = thumb_y > kThumbThreshold;
+    uint64_t d = thumb_y < ~kThumbThreshold;
+    uint64_t r = thumb_x > kThumbThreshold;
+    uint64_t l = thumb_x < ~kThumbThreshold;
+    if (u && l) {
+      u = l = 0;
+      f |= uint64_t(1) << (22 + i);
+    }
+    if (u && r) {
+      u = r = 0;
+      f |= uint64_t(1) << (23 + i);
+    }
+    if (d && r) {
+      d = r = 0;
+      f |= uint64_t(1) << (24 + i);
+    }
+    if (d && l) {
+      d = l = 0;
+      f |= uint64_t(1) << (25 + i);
+    }
+    f |= u << (18 + i);
+    f |= d << (19 + i);
+    f |= r << (20 + i);
+    f |= l << (21 + i);
+    thumb_x = static_cast<int16_t>(gamepad.thumb_rx);
+    thumb_y = static_cast<int16_t>(gamepad.thumb_ry);
+  }
+  return f;
+}
+
+}  // namespace
+
+PS4InputDriver::PS4InputDriver(rex::ui::Window* window, size_t window_z_order)
+    : InputDriver(window, window_z_order) {}
+
+PS4InputDriver::~PS4InputDriver() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  for (Slot& slot : slots_) {
+    if (slot.handle >= 0) scePadClose(slot.handle);
+    slot.handle = -1;
+  }
+}
+
+X_STATUS PS4InputDriver::Setup() {
+  sceUserServiceInitialize(nullptr);
+  const int32_t r = scePadInit();
+  if (r != 0) {
+    REXLOG_ERROR("PS4 input: scePadInit failed: {:08X}", static_cast<uint32_t>(r));
+    return X_STATUS_UNSUCCESSFUL;
+  }
+  initialized_ = true;
+  std::lock_guard<std::mutex> lock(mutex_);
+  RefreshUsers();
+  return X_STATUS_SUCCESS;
+}
+
+bool PS4InputDriver::TakeMenuCombo() { return g_menu_combo.exchange(false); }
+
+// Slot i follows the i-th signed-in user; a slot whose user changed gets its pad reopened.
+void PS4InputDriver::RefreshUsers() {
+  OrbisUserServiceLoginUserIdList list;
+  std::memset(&list, 0, sizeof(list));
+  std::array<int32_t, kSlotCount> users;
+  users.fill(-1);
+  if (sceUserServiceGetLoginUserIdList(&list) == 0) {
+    size_t n = 0;
+    for (int k = 0; k < ORBIS_USER_SERVICE_MAX_LOGIN_USERS && n < kSlotCount; ++k) {
+      if (list.userId[k] != -1) users[n++] = list.userId[k];
+    }
+  }
+  for (size_t i = 0; i < kSlotCount; ++i) {
+    Slot& slot = slots_[i];
+    if (slot.user == users[i] && (slot.handle >= 0 || slot.user == -1)) continue;
+    if (slot.handle >= 0) scePadClose(slot.handle);
+    slot = Slot{};
+    slot.user = users[i];
+    if (slot.user != -1) {
+      slot.handle = scePadOpen(slot.user, ORBIS_PAD_PORT_TYPE_STANDARD, 0, nullptr);
+      if (slot.handle < 0) {
+        REXLOG_WARN("PS4 input: scePadOpen for user {:08X} failed: {:08X}",
+                    static_cast<uint32_t>(slot.user), static_cast<uint32_t>(slot.handle));
+      }
+    }
+  }
+}
+
+void PS4InputDriver::Poll(Slot& slot) {
+  OrbisPadData d;
+  std::memset(&d, 0, sizeof(d));
+  const bool connected = slot.handle >= 0 && scePadReadState(slot.handle, &d) == 0 && d.connected;
+  if (connected && !slot.connected) {
+    const size_t index = static_cast<size_t>(&slot - slots_.data());
+    slot.id = static_cast<DeviceId>((uint64_t(++connection_counter_) << 24) | kDeviceIdTag |
+                                    index);
+    slot.key_buttons = 0;
+    slot.repeat_state = RepeatState::kIdle;
+    slot.vibration_sent = false;
+  }
+  slot.connected = connected;
+  if (!connected) return;
+
+  X_INPUT_GAMEPAD pad{};
+  uint16_t buttons = 0;
+  for (const ButtonMap& m : kButtons) {
+    if (d.buttons & m.ds4) buttons |= m.xinput;
+  }
+  pad.buttons = buttons;
+  pad.left_trigger = d.analogButtons.l2;
+  pad.right_trigger = d.analogButtons.r2;
+  pad.thumb_lx = Axis(d.leftStick.x, false);
+  pad.thumb_ly = Axis(d.leftStick.y, true);
+  pad.thumb_rx = Axis(d.rightStick.x, false);
+  pad.thumb_ry = Axis(d.rightStick.y, true);
+  if (std::memcmp(&pad, &slot.state.gamepad, sizeof(pad)) != 0) {
+    slot.state.gamepad = pad;
+    slot.state_changed = true;
+  }
+
+  constexpr uint32_t kCombo = ORBIS_PAD_BUTTON_L3 | ORBIS_PAD_BUTTON_R3;
+  const bool combo = (d.buttons & kCombo) == kCombo;
+  if (combo && !slot.combo_held) g_menu_combo = true;
+  slot.combo_held = combo;
+}
+
+PS4InputDriver::Slot* PS4InputDriver::FindSlot(DeviceId id) {
+  for (Slot& slot : slots_) {
+    if (slot.connected && slot.id == id) return &slot;
+  }
+  return nullptr;
+}
+
+void PS4InputDriver::EnumerateDevices(std::vector<DeviceInfo>& out) {
+  if (!initialized_) return;
+  std::lock_guard<std::mutex> lock(mutex_);
+  RefreshUsers();
+  for (size_t i = 0; i < kSlotCount; ++i) {
+    Slot& slot = slots_[i];
+    Poll(slot);
+    if (!slot.connected) continue;
+    DeviceInfo info;
+    info.id = slot.id;
+    info.name = "DUALSHOCK 4";
+    info.guid = "ps4-pad-" + std::to_string(i);
+    info.synthetic = false;
+    out.push_back(std::move(info));
+  }
+}
+
+X_RESULT PS4InputDriver::GetDeviceState(DeviceId id, X_INPUT_STATE* out_state) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  Slot* slot = FindSlot(id);
+  if (!slot) return X_ERROR_DEVICE_NOT_CONNECTED;
+  Poll(*slot);
+  if (!slot->connected) return X_ERROR_DEVICE_NOT_CONNECTED;
+  // packet_number moves by one per change, and when the active state changes.
+  const bool is_active = this->is_active();
+  if (is_active != slot->is_active || (is_active && slot->state_changed)) {
+    slot->state.packet_number = uint32_t(slot->state.packet_number) + 1;
+    slot->is_active = is_active;
+    slot->state_changed = false;
+  }
+  std::memcpy(out_state, &slot->state, sizeof(*out_state));
+  if (!is_active) {
+    std::memset(&out_state->gamepad, 0, sizeof(out_state->gamepad));
+  }
+  return X_ERROR_SUCCESS;
+}
+
+X_RESULT PS4InputDriver::GetDeviceCapabilities(DeviceId id, uint32_t flags,
+                                               X_INPUT_CAPABILITIES* out_caps) {
+  (void)flags;
+  if (!out_caps) return X_ERROR_BAD_ARGUMENTS;
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (!FindSlot(id)) return X_ERROR_DEVICE_NOT_CONNECTED;
+  std::memset(out_caps, 0, sizeof(*out_caps));
+  out_caps->type = 0x01;      // XINPUT_DEVTYPE_GAMEPAD
+  out_caps->sub_type = 0x01;  // XINPUT_DEVSUBTYPE_GAMEPAD
+  out_caps->flags = X_INPUT_CAPS_WIRELESS;
+  out_caps->gamepad.buttons = 0xF3FF;
+  out_caps->gamepad.left_trigger = 0xFF;
+  out_caps->gamepad.right_trigger = 0xFF;
+  out_caps->gamepad.thumb_lx = static_cast<int16_t>(0xFFFFu);
+  out_caps->gamepad.thumb_ly = static_cast<int16_t>(0xFFFFu);
+  out_caps->gamepad.thumb_rx = static_cast<int16_t>(0xFFFFu);
+  out_caps->gamepad.thumb_ry = static_cast<int16_t>(0xFFFFu);
+  out_caps->vibration.left_motor_speed = 0xFFFFu;
+  out_caps->vibration.right_motor_speed = 0xFFFFu;
+  return X_ERROR_SUCCESS;
+}
+
+X_RESULT PS4InputDriver::SetDeviceVibration(DeviceId id, X_INPUT_VIBRATION* vibration) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  Slot* slot = FindSlot(id);
+  if (!slot) return X_ERROR_DEVICE_NOT_CONNECTED;
+  const uint16_t left = uint16_t(vibration->left_motor_speed);
+  const uint16_t right = uint16_t(vibration->right_motor_speed);
+  if (slot->vibration_sent && slot->vibration_left == left && slot->vibration_right == right) {
+    return X_ERROR_SUCCESS;
+  }
+  // XInput's left motor is the heavy low-frequency one: the DualShock 4's large motor.
+  OrbisPadVibeParam vibe{uint8_t(left >> 8), uint8_t(right >> 8)};
+  if (scePadSetVibration(slot->handle, &vibe) != 0) {
+    slot->vibration_sent = false;
+    return X_ERROR_FUNCTION_FAILED;
+  }
+  slot->vibration_sent = true;
+  slot->vibration_left = left;
+  slot->vibration_right = right;
+  return X_ERROR_SUCCESS;
+}
+
+X_RESULT PS4InputDriver::GetDeviceKeystroke(DeviceId id, uint32_t flags,
+                                            X_INPUT_KEYSTROKE* out_keystroke) {
+  (void)flags;
+  if (!out_keystroke) return X_ERROR_BAD_ARGUMENTS;
+  std::lock_guard<std::mutex> lock(mutex_);
+  Slot* slot = FindSlot(id);
+  if (!slot) return X_ERROR_DEVICE_NOT_CONNECTED;
+  Poll(*slot);
+
+  // Inactive input (an overlay is open): every button reads as up, so UP events go out now and
+  // DOWN events when it comes back.
+  const bool is_active = this->is_active();
+  const uint64_t curr_butts =
+      is_active ? (static_cast<uint64_t>(static_cast<uint16_t>(slot->state.gamepad.buttons)) |
+                   AnalogToKeyfield(slot->state.gamepad))
+                : uint64_t(0);
+
+  const auto guest_now = static_cast<uint32_t>(rex::chrono::Clock::QueryGuestUptimeMillis());
+  if (slot->repeat_state == RepeatState::kWaiting &&
+      (slot->repeat_time + kRepeatDelayMs < guest_now)) {
+    slot->repeat_state = RepeatState::kRepeating;
+  }
+  if (slot->repeat_state == RepeatState::kRepeating &&
+      (slot->repeat_time + kRepeatRateMs < guest_now)) {
+    slot->repeat_time = guest_now;
+    out_keystroke->virtual_key = uint16_t(kVkLookup.at(slot->repeat_index));
+    out_keystroke->unicode = 0;
+    out_keystroke->user_index = 0;  // InputSystem stamps the guest user
+    out_keystroke->hid_code = 0;
+    out_keystroke->flags = X_INPUT_KEYSTROKE_KEYDOWN | X_INPUT_KEYSTROKE_REPEAT;
+    return X_ERROR_SUCCESS;
+  }
+
+  const uint64_t butts_changed = curr_butts ^ slot->key_buttons;
+  if (!butts_changed) return X_ERROR_EMPTY;
+
+  // Up events first, as XInput does when a stick moves between directions.
+  for (auto [clear_pass, pass] = std::tuple{true, 0}; pass < 2; clear_pass = false, pass++) {
+    for (uint8_t i = 0; i < uint8_t(std::size(kVkLookup)); i++) {
+      const uint64_t fbutton = uint64_t(1) << i;
+      if (!(butts_changed & fbutton)) continue;
+      const rex::ui::VirtualKey vk = kVkLookup.at(i);
+      if (vk == rex::ui::VirtualKey::kNone) continue;
+      out_keystroke->virtual_key = uint16_t(vk);
+      out_keystroke->unicode = 0;
+      out_keystroke->user_index = 0;
+      out_keystroke->hid_code = 0;
+      const bool is_pressed = curr_butts & fbutton;
+      if (clear_pass && !is_pressed) {
+        out_keystroke->flags = X_INPUT_KEYSTROKE_KEYUP;
+        slot->key_buttons &= ~fbutton;
+        slot->repeat_state = RepeatState::kIdle;
+        return X_ERROR_SUCCESS;
+      }
+      if (!clear_pass && is_pressed) {
+        out_keystroke->flags = X_INPUT_KEYSTROKE_KEYDOWN;
+        slot->key_buttons |= fbutton;
+        slot->repeat_state = RepeatState::kWaiting;
+        slot->repeat_index = i;
+        slot->repeat_time = guest_now;
+        return X_ERROR_SUCCESS;
+      }
+    }
+  }
+  return X_ERROR_EMPTY;
+}
+
+}  // namespace rex::input::ps4
