+  std::lock_guard<std::mutex> lock(balance.mutex);
+  std::vector<std::pair<uint32_t, uint32_t>> busiest(balance.load.begin(), balance.load.end());
+  std::sort(busiest.begin(), busiest.end(), [](const auto& a, const auto& b) { return a.second > b.second; });
+  std::string out = balance.summary.empty() ? std::string("core loads: no pass yet") : balance.summary;
+  out += "; busiest:";
+  for (size_t i = 0; i < busiest.size() && i < 8 && busiest[i].second >= 30; ++i) {
+    uint8_t core = 0xFF;
+    if (auto it = balance.core.find(busiest[i].first); it != balance.core.end()) {
+      core = it->second;
+    }
+    out += fmt::format(" {:08X} {}.{} %{}", busiest[i].first, busiest[i].second / 10, busiest[i].second % 10,
+                       core != 0xFF ? fmt::format(" (core {})", int(core)) : std::string());
+  }
+  return out;
