+  // Only the passes drawing into one EDRAM base (nfsmw_dk_volcado_pase_base, -1 = any), one in every N of them.
+  const int32_t solo_base = REXCVAR_GET(nfsmw_dk_volcado_pase_base);
+  if (solo_base >= 0) {
+    if (!claves_pase_previo_[0] || int32_t((claves_pase_previo_[0] >> 24) & 0xFFF) != solo_base) return;
