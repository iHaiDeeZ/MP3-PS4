+++ b/include/rex/input/ps4/ps4_input_driver.h
@@ -0,0 +1,71 @@
+/**
+ * @file        rex/input/ps4/ps4_input_driver.h
+ * @brief       Input driver for DualShock 4 pads on the PS4 through libScePad
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <mutex>
+#include <vector>
+
+#include <rex/input/input_driver.h>
+
+namespace rex::input::ps4 {
+
+class PS4InputDriver final : public InputDriver {
+ public:
+  // One pad per signed-in user, as many as the 360 has players.
+  static constexpr size_t kSlotCount = 4;
+
+  explicit PS4InputDriver(rex::ui::Window* window, size_t window_z_order);
+  ~PS4InputDriver() override;
+
+  X_STATUS Setup() override;
+  void EnumerateDevices(std::vector<DeviceInfo>& out) override;
+  X_RESULT GetDeviceState(DeviceId id, X_INPUT_STATE* out_state) override;
+  X_RESULT GetDeviceCapabilities(DeviceId id, uint32_t flags,
+                                 X_INPUT_CAPABILITIES* out_caps) override;
+  X_RESULT SetDeviceVibration(DeviceId id, X_INPUT_VIBRATION* vibration) override;
+  X_RESULT GetDeviceKeystroke(DeviceId id, uint32_t flags,
+                              X_INPUT_KEYSTROKE* out_keystroke) override;
+
+  // L3+R3 pressed together since the last call (any pad): the port's quick menu.
+  static bool TakeMenuCombo();
+
+ private:
+  enum class RepeatState { kIdle, kWaiting, kRepeating };
+
+  struct Slot {
+    int32_t user = -1;
+    int32_t handle = -1;
+    DeviceId id = DeviceId::kInvalid;
+    bool connected = false;
+    X_INPUT_STATE state{};
+    bool state_changed = false;
+    bool is_active = true;
+    uint16_t vibration_left = 0, vibration_right = 0;
+    bool vibration_sent = false;
+    bool combo_held = false;
+    // Keystrokes (XInputGetKeystroke)
+    uint64_t key_buttons = 0;
+    RepeatState repeat_state = RepeatState::kIdle;
+    uint8_t repeat_index = 0;
+    uint32_t repeat_time = 0;
+  };
+
+  void RefreshUsers();
+  void Poll(Slot& slot);
+  Slot* FindSlot(DeviceId id);
+
+  std::mutex mutex_;
+  std::array<Slot, kSlotCount> slots_;
+  uint32_t connection_counter_ = 0;
+  bool initialized_ = false;
+};
+
+}  // namespace rex::input::ps4
