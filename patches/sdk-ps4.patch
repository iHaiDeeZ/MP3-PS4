diff --git a/include/rex/graphics/cp_perf.h b/include/rex/graphics/cp_perf.h
new file mode 100644
index 0000000..6d140c7
--- /dev/null
+++ b/include/rex/graphics/cp_perf.h
@@ -0,0 +1,98 @@
+// mp3-ps4 (v00.15): where the command processor's time goes, for the [cpt] stats line
+// (vulkan/command_processor.cpp CpStatsOnSwap). Time stamp counter ticks since the last line, as relaxed atomics: the
+// command processor thread adds, the stats code reads and resets. rdtsc costs a few cycles, so every draw is timed.
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+
+#if defined(_MSC_VER)
+#include <intrin.h>
+#else
+#include <x86intrin.h>
+#endif
+
+namespace rex::graphics::cp_perf {
+
+inline uint64_t Ticks() { return __rdtsc(); }
+
+inline std::atomic<uint64_t> ring_ticks{0};       // ExecutePrimaryBuffer: the ring's packets, everything below
+inline std::atomic<uint64_t> draw_ticks{0};       // IssueDraw (with its requests, uploads and lock waits)
+inline std::atomic<uint64_t> submit_ticks{0};     // EndSubmission (deferred command buffer execution, vkQueueSubmit)
+inline std::atomic<uint64_t> lock_wait_ticks{0};  // waiting for the global lock in the shared memory
+inline std::atomic<uint64_t> lock_waits{0};
+inline std::atomic<uint64_t> requests{0};         // SharedMemory::RequestRanges calls
+inline std::atomic<uint64_t> requests_fast{0};    // ... answered without the lock (every page valid)
+inline std::atomic<uint64_t> upload_ticks{0};     // the uploads' memcpy
+inline std::atomic<uint64_t> uploads{0};
+inline std::atomic<uint64_t> upload_bytes{0};
+inline std::atomic<uint64_t> arm_ticks{0};        // arming write watches again after uploads (mprotect)
+inline std::atomic<uint64_t> arms{0};
+// v00.20: inside a draw, by part (each its function's whole time), and the waits for the submission thread.
+inline std::atomic<uint64_t> prim_ticks{0};      // PrimitiveProcessor::Process
+inline std::atomic<uint64_t> tex_ticks{0};       // TextureCache::RequestTextures
+inline std::atomic<uint64_t> rt_ticks{0};        // RenderTargetCache::Update
+inline std::atomic<uint64_t> pipe_ticks{0};      // VulkanPipelineCache::ConfigurePipeline
+inline std::atomic<uint64_t> dyn_ticks{0};       // UpdateDynamicState
+inline std::atomic<uint64_t> sysc_ticks{0};      // UpdateSystemConstantValues
+inline std::atomic<uint64_t> bind_ticks{0};      // UpdateBindings
+inline std::atomic<uint64_t> enter_ticks{0};     // SubmitBarriersAndEnterRenderTargetCacheRenderPass
+inline std::atomic<uint64_t> shader_ticks{0};    // VulkanPipelineCache::LoadShader (hashing the guest shader)
+inline std::atomic<uint64_t> shader_loads{0};
+inline std::atomic<uint64_t> await_ticks{0};     // AsyncSubmitAwait, all callers
+inline std::atomic<uint64_t> swap_await_ticks{0};  // ... at the swap
+// v00.21: descriptor sets of the draws.
+inline std::atomic<uint64_t> texture_sets_written{0};
+inline std::atomic<uint64_t> texture_sets_reused{0};  // a set written earlier in the frame, same contents
+inline std::atomic<uint64_t> texture_sets_kept{0};    // ... and already bound
+inline std::atomic<uint64_t> constant_sets_written{0};
+// v00.22: the rest of IssueDraw.
+inline std::atomic<uint64_t> analyze_ticks{0};   // AnalyzeShaderUcode, the pixel shader's need, interpolators
+inline std::atomic<uint64_t> shaders_ticks{0};   // modifications, translations, EnsureShadersTranslated
+inline std::atomic<uint64_t> samplers_ticks{0};  // GetSamplerParameters, UseSampler
+inline std::atomic<uint64_t> viewport_ticks{0};  // GetHostViewportInfo
+inline std::atomic<uint64_t> vertex_ticks{0};    // the vertex buffers' residency
+inline std::atomic<uint64_t> record_ticks{0};    // shared memory use, index buffer, the draw command
+// v00.24: kicks (primary buffer batches) and the hot memory (SharedMemory, gpu_hot_memory).
+inline std::atomic<uint64_t> kicks{0};
+inline std::atomic<uint64_t> hot_regions{0};      // now (a gauge)
+inline std::atomic<uint64_t> hot_made{0};
+inline std::atomic<uint64_t> hot_cooled{0};
+inline std::atomic<uint64_t> hot_uploads{0};      // MakeRangeValid calls for uploads touching hot regions
+inline std::atomic<uint64_t> hot_invalidations{0};
+// v00.25: shader constant dwords written, and those whose values changed (float / fetch).
+inline std::atomic<uint64_t> float_written{0};
+inline std::atomic<uint64_t> float_changed{0};
+inline std::atomic<uint64_t> fetch_written{0};
+inline std::atomic<uint64_t> fetch_changed{0};
+
+inline void Add(std::atomic<uint64_t>& counter, uint64_t value) {
+  counter.fetch_add(value, std::memory_order_relaxed);
+}
+
+struct ScopeTicks {
+  explicit ScopeTicks(std::atomic<uint64_t>& sink) : sink_(sink), start_(Ticks()) {}
+  ~ScopeTicks() { Add(sink_, Ticks() - start_); }
+  ScopeTicks(const ScopeTicks&) = delete;
+  ScopeTicks& operator=(const ScopeTicks&) = delete;
+
+ private:
+  std::atomic<uint64_t>& sink_;
+  uint64_t start_;
+};
+
+// The global lock, with the wait timed when another thread holds it.
+inline std::unique_lock<std::recursive_mutex> AcquireTimed(std::recursive_mutex& mutex) {
+  std::unique_lock<std::recursive_mutex> lock(mutex, std::try_to_lock);
+  if (!lock.owns_lock()) {
+    const uint64_t start = Ticks();
+    lock.lock();
+    Add(lock_wait_ticks, Ticks() - start);
+    Add(lock_waits, 1);
+  }
+  return lock;
+}
+
+}  // namespace rex::graphics::cp_perf
