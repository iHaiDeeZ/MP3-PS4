+    return rows;
+  }
+
+  static bool Selectable(const Row& row) { return row.kind != Row::Kind::kInfo; }
+
+  void MoveSelection(const std::vector<Row>& rows, int step) {
+    if (rows.empty()) return;
+    const int n = int(rows.size());
+    for (int k = 1; k <= n; ++k) {
+      const int i = ((selected_ + step * k) % n + n) % n;
+      if (Selectable(rows[size_t(i)])) {
+        selected_ = i;
+        return;
+      }
+    }
+  }
+
+  void HandleInput(std::vector<Row>& rows) {
+    if (ImGui::IsKeyPressed(ImGuiKey_GamepadR1, false) || ImGui::IsKeyPressed(ImGuiKey_GamepadL1, false)) {
+      tab_ = (tab_ + (ImGui::IsKeyPressed(ImGuiKey_GamepadR1, false) ? 1 : kTabCount - 1)) % kTabCount;
+      selected_ = -1;
+      jump_ = true;
+      rows = BuildRows(tab_);
+    }
+    if (selected_ < 0 || selected_ >= int(rows.size()) || !Selectable(rows[size_t(selected_)])) {
+      selected_ = -1;
+      MoveSelection(rows, 1);
+    }
+    if (ImGui::IsKeyPressed(ImGuiKey_GamepadFaceRight, false)) {
+      Close();
+      return;
+    }
+    if (selected_ < 0) return;
+    if (ImGui::IsKeyPressed(ImGuiKey_GamepadDpadDown, true)) MoveSelection(rows, 1);
+    if (ImGui::IsKeyPressed(ImGuiKey_GamepadDpadUp, true)) MoveSelection(rows, -1);
+    Row& row = rows[size_t(selected_)];
+    const bool left = ImGui::IsKeyPressed(ImGuiKey_GamepadDpadLeft, true);
+    const bool right = ImGui::IsKeyPressed(ImGuiKey_GamepadDpadRight, true);
+    const bool cross = ImGui::IsKeyPressed(ImGuiKey_GamepadFaceDown, false);
+    switch (row.kind) {
+      case Row::Kind::kChoice: {
+        const int n = int(row.options.size());
+        const int step = left ? -1 : (right || cross) ? 1 : 0;
+        if (step && n) {
+          row.set(((row.get() + step) % n + n) % n);
+          nudge_ = float(step);
+          dirty_ = true;
+        }
+        break;
+      }
+      case Row::Kind::kSwitch:
+        if (cross || left || right) {
+          const int v = left ? 0 : right ? 1 : !row.get();
+          if (v != row.get()) {
+            row.set(v);
+            dirty_ = true;
+          }
+        }
+        break;
+      case Row::Kind::kAction:
+        if (cross && row.run) row.run();
+        break;
+      case Row::Kind::kInfo:
+        break;
+    }
+  }
+
+  void DrawMenu(ImGuiIO& io, float dt) {
+    std::vector<Row> rows = BuildRows(tab_);
+    if (phase_ == Phase::kOpen || phase_ == Phase::kOpening) HandleInput(rows);
+
+    // A full-screen window that holds the navigation focus (the game's pad stays neutral) and is drawn into.
+    ImGui::SetNextWindowFocus();
+    ImGui::SetNextWindowPos(ImVec2(0.0f, 0.0f), ImGuiCond_Always);
+    ImGui::SetNextWindowSize(io.DisplaySize, ImGuiCond_Always);
+    ImGui::Begin("##mp3-quick-menu", nullptr,
+                 ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoBackground | ImGuiWindowFlags_NoSavedSettings |
+                     ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoScrollWithMouse);
+    ImDrawList* draw = ImGui::GetWindowDrawList();
+    const float u = io.DisplaySize.y / 720.0f;
+    const float t = EaseOut(open_);
+    const float W = std::min(io.DisplaySize.x * 0.46f, 520.0f * u);
+    const float x0 = -W * (1.0f - t);
+    const float H = io.DisplaySize.y;
+    const float pad = 46.0f * u;
+
+    // The game behind: dimmed, darker towards the panel.
+    draw->AddRectFilled(ImVec2(0, 0), io.DisplaySize, IM_COL32(0, 0, 0, int(110 * t)));
+    draw->AddRectFilledMultiColor(ImVec2(x0 + W, 0), ImVec2(x0 + W + 260.0f * u, H), IM_COL32(0, 0, 0, int(150 * t)),
+                                  IM_COL32(0, 0, 0, 0), IM_COL32(0, 0, 0, 0), IM_COL32(0, 0, 0, int(150 * t)));
+    // The panel and its edge.
+    draw->AddRectFilled(ImVec2(x0, 0), ImVec2(x0 + W, H), WithAlpha(kPanel, std::max(t, 0.6f)));
+    draw->AddRectFilledMultiColor(ImVec2(x0, 0), ImVec2(x0 + W, 220.0f * u), IM_COL32(200, 32, 44, 26),
+                                  IM_COL32(200, 32, 44, 0), IM_COL32(200, 32, 44, 0), IM_COL32(200, 32, 44, 0));
+    draw->AddRectFilled(ImVec2(x0 + W - 2.0f * u, 0), ImVec2(x0 + W, H), kAccent);
+
+    // Title.
+    float y = 44.0f * u;
+    Text(draw, g_fonts.title, ImVec2(x0 + pad, y), kText, "MAX PAYNE 3");
+    y += g_fonts.title->LegacySize * u + 6.0f * u;
+    draw->AddRectFilled(ImVec2(x0 + pad, y), ImVec2(x0 + pad + 54.0f * u, y + 3.0f * u), kAccent);
+    const std::string subtitle = fmt::format("PS4  ·  QUICK MENU  ·  v{}", MP3_VERSION);
+    Text(draw, g_fonts.small, ImVec2(x0 + pad + 66.0f * u, y - 6.0f * u), kDim, subtitle.c_str());
+    y += 34.0f * u;
+
+    // Tabs.
+    const float cap_h = 20.0f * u;
+    float tx = x0 + pad;
+    tx += DrawKeyCap(draw, "L1", ImVec2(tx, y), cap_h, 1.0f) + 14.0f * u;
+    for (int i = 0; i < kTabCount; ++i) {
+      const ImVec2 size = TextSize(g_fonts.tab, kTabs[i]);
+      const float ty = y + (cap_h - size.y) * 0.5f;
+      Text(draw, g_fonts.tab, ImVec2(tx, ty), i == tab_ ? kText : kFaint, kTabs[i]);
+      if (i == tab_) {
+        draw->AddRectFilled(ImVec2(tx, ty + size.y + 5.0f * u), ImVec2(tx + size.x, ty + size.y + 7.5f * u), kAccent);
+      }
+      tx += size.x + 20.0f * u;
+    }
+    DrawKeyCap(draw, "R1", ImVec2(tx - 6.0f * u, y), cap_h, 1.0f);
+    y += cap_h + 26.0f * u;
+    draw->AddLine(ImVec2(x0 + pad, y), ImVec2(x0 + W - pad, y), kLine, 1.0f);
+    y += 10.0f * u;
+
+    // Rows.
+    const float row_h = 54.0f * u;
+    const float rows_top = y;
+    if (selected_ >= 0) {
+      const float target = rows_top + float(selected_) * row_h;
+      highlight_y_ = highlight_y_ < 0.0f || jump_
+                         ? target
+                         : highlight_y_ + (target - highlight_y_) * std::min(1.0f, dt * 18.0f);
+    }
+    jump_ = false;
+    if (selected_ >= 0) {
+      const float hy = highlight_y_;
+      draw->AddRectFilledMultiColor(ImVec2(x0, hy), ImVec2(x0 + W - 2.0f * u, hy + row_h), IM_COL32(200, 32, 44, 70),
+                                    IM_COL32(200, 32, 44, 8), IM_COL32(200, 32, 44, 8), IM_COL32(200, 32, 44, 70));
+      draw->AddRectFilled(ImVec2(x0, hy), ImVec2(x0 + 4.0f * u, hy + row_h), kAccent);
+    }
+    nudge_ *= std::max(0.0f, 1.0f - dt * 12.0f);
+    for (size_t i = 0; i < rows.size(); ++i) {
+      const Row& row = rows[i];
+      const bool sel = int(i) == selected_;
+      const float ry = rows_top + float(i) * row_h;
+      const float mid = ry + row_h * 0.5f;
+      const ImVec2 lsize = TextSize(g_fonts.row, row.label.c_str());
+      Text(draw, g_fonts.row, ImVec2(x0 + pad, mid - lsize.y * 0.5f),
+           sel ? kText : (row.kind == Row::Kind::kInfo ? kDim : IM_COL32(200, 200, 204, 255)), row.label.c_str());
+      if (i + 1 < rows.size()) {
+        draw->AddLine(ImVec2(x0 + pad, ry + row_h), ImVec2(x0 + W - pad, ry + row_h), kLine, 1.0f);
+      }
+      const float right = x0 + W - pad;
+      switch (row.kind) {
+        case Row::Kind::kChoice: {
+          const int v = std::clamp(row.get(), 0, int(row.options.size()) - 1);
+          const char* value = row.options[size_t(v)].c_str();
+          const ImVec2 vs = TextSize(g_fonts.value, value);
+          const float arrow = 5.0f * u;
+          const float shift = sel ? nudge_ * 4.0f * u : 0.0f;
+          const float vx = right - arrow * 2.0f - 12.0f * u - vs.x + shift;
+          Text(draw, g_fonts.value, ImVec2(vx, mid - vs.y * 0.5f), sel ? kText : kDim, value);
+          if (sel) {
+            const ImU32 c = kAccent;
+            const float lx = vx - 12.0f * u - shift;
+            draw->AddTriangleFilled(ImVec2(lx - arrow, mid), ImVec2(lx + arrow * 0.4f, mid - arrow),
+                                    ImVec2(lx + arrow * 0.4f, mid + arrow), c);
+            const float rx = right - arrow;
+            draw->AddTriangleFilled(ImVec2(rx + arrow, mid), ImVec2(rx - arrow * 0.4f, mid + arrow),
+                                    ImVec2(rx - arrow * 0.4f, mid - arrow), c);
+          }
+          // The position among the options: small marks under the value.
+          const float dots_w = float(row.options.size()) * 9.0f * u;
+          float dx = right - arrow * 2.0f - 12.0f * u - dots_w + 3.0f * u;
+          for (size_t k = 0; k < row.options.size(); ++k, dx += 9.0f * u) {
+            draw->AddRectFilled(ImVec2(dx, mid + vs.y * 0.5f + 4.0f * u),
+                                ImVec2(dx + 6.0f * u, mid + vs.y * 0.5f + 6.0f * u),
+                                int(k) == v ? (sel ? kAccent : kDim) : kFaint);
+          }
+          break;
+        }
+        case Row::Kind::kSwitch: {
+          const bool on = row.get() != 0;
+          const float sw = 46.0f * u, sh = 24.0f * u;
+          const ImVec2 a(right - sw, mid - sh * 0.5f), b(right, mid + sh * 0.5f);
+          draw->AddRectFilled(a, b, on ? kAccent : IM_COL32(58, 58, 64, 255), sh * 0.5f);
+          const float kx = on ? b.x - sh * 0.5f : a.x + sh * 0.5f;
+          draw->AddCircleFilled(ImVec2(kx, mid), sh * 0.5f - 3.0f * u, on ? kText : IM_COL32(170, 170, 176, 255), 24);
+          const char* state = on ? "ON" : "OFF";
+          const ImVec2 ss = TextSize(g_fonts.small, state);
+          Text(draw, g_fonts.small, ImVec2(a.x - 10.0f * u - ss.x, mid - ss.y * 0.5f), sel ? kText : kDim, state);
+          break;
+        }
+        case Row::Kind::kAction: {
+          const char* label = "START";
+          const ImVec2 ls = TextSize(g_fonts.small, label);
+          const float bw = ls.x + 40.0f * u, bh = 26.0f * u;
+          const ImVec2 a(right - bw, mid - bh * 0.5f), b(right, mid + bh * 0.5f);
+          if (sel) draw->AddRectFilled(a, b, kAccent, 3.0f * u);
+          draw->AddRect(a, b, sel ? kAccent : kFaint, 3.0f * u, 0, 1.3f);
+          DrawMark(draw, Mark::kCross, ImVec2(a.x + 13.0f * u, mid), 6.5f * u, 1.0f);
+          Text(draw, g_fonts.small, ImVec2(a.x + 25.0f * u, mid - ls.y * 0.5f), kText, label);
+          break;
+        }
+        case Row::Kind::kInfo: {
+          const ImVec2 is = TextSize(g_fonts.body, row.info.c_str());
+          Text(draw, g_fonts.body, ImVec2(right - is.x, mid - is.y * 0.5f), kText, row.info.c_str());
+          break;
+        }
+      }
+    }
+    y = rows_top + float(rows.size()) * row_h + 26.0f * u;
+
+    // The selected row's description.
+    if (selected_ >= 0 && selected_ < int(rows.size())) {
+      const Row& row = rows[size_t(selected_)];
+      if (row.restart) {
+        const char* tag = "NEXT START";
+        const ImVec2 ts = TextSize(g_fonts.small, tag);
+        draw->AddRectFilled(ImVec2(x0 + pad, y), ImVec2(x0 + pad + ts.x + 14.0f * u, y + ts.y + 6.0f * u), kAmber,
+                            3.0f * u);
+        Text(draw, g_fonts.small, ImVec2(x0 + pad + 7.0f * u, y + 3.0f * u), IM_COL32(20, 16, 8, 255), tag);
+        Text(draw, g_fonts.small, ImVec2(x0 + pad + ts.x + 24.0f * u, y + 3.0f * u), kAmber,
+             "applies when the game is started again");
+        y += ts.y + 16.0f * u;
+      }
+      Text(draw, g_fonts.body, ImVec2(x0 + pad, y), kDim, row.help.c_str(), W - pad * 2.0f);
+    } else if (tab_ == 3) {
+      Text(draw, g_fonts.body, ImVec2(x0 + pad, y), kDim,
+           "A port of VasilkovND/mp3-nx done the MGR way: the game's code converted to x86-64 ahead of time, its "
+           "graphics drawn by the Xenos emulation on the PS4's GPU. Your game data stays on your console.",
+           W - pad * 2.0f);
+    }
+
+    // The buttons' hints.
+    const float fy = H - 44.0f * u;
+    draw->AddLine(ImVec2(x0 + pad, fy - 16.0f * u), ImVec2(x0 + W - pad, fy - 16.0f * u), kLine, 1.0f);
+    float hx = x0 + pad;
+    const float r = 8.0f * u;
+    auto hint = [&](Mark mark, const char* label) {
+      hx += DrawMark(draw, mark, ImVec2(hx + r, fy + r), r, 1.0f) + 7.0f * u;
+      const ImVec2 s = TextSize(g_fonts.body, label);
+      Text(draw, g_fonts.body, ImVec2(hx, fy + r - s.y * 0.5f), kDim, label);
+      hx += s.x + 22.0f * u;
+    };
+    if (selected_ >= 0) {
+      hint(Mark::kDpadVertical, "Move");
+      const Row::Kind kind = rows[size_t(selected_)].kind;
+      if (kind == Row::Kind::kChoice) hint(Mark::kDpadHorizontal, "Change");
+      if (kind == Row::Kind::kSwitch) hint(Mark::kCross, "Switch");
+      if (kind == Row::Kind::kAction) hint(Mark::kCross, "Start");
+    }
+    hint(Mark::kCircle, "Close");
+    const char* combo = "L3 + R3";
+    const ImVec2 cs = TextSize(g_fonts.small, combo);
+    Text(draw, g_fonts.small, ImVec2(x0 + W - pad - cs.x, fy + r - cs.y * 0.5f), kFaint, combo);
+
+    ImGui::End();
+  }
+
+  void DrawCounter(ImGuiIO& io, bool menu_visible) {
+    const int32_t mode = REXCVAR_GET(mp3_frame_counter);
+    const bool profiling = ps4_profile_running() != 0;
+    if (mode <= 0 && !profiling) return;
+    const bool right_corner = REXCVAR_GET(mp3_frame_counter_corner) == 1;
+    if (menu_visible && !right_corner) return;  // under the panel
+    ImDrawList* draw = ImGui::GetForegroundDrawList();
+    const float u = io.DisplaySize.y / 720.0f;
+    const FrameStats stats = ReadStats(120);
+    const float margin = 18.0f * u, padx = 12.0f * u, pady = 8.0f * u;
+
+    char fps_text[16];
+    std::snprintf(fps_text, sizeof(fps_text), "%.0f", stats.fps);
+    const ImVec2 fs = TextSize(g_fonts.counter, fps_text);
+    const ImVec2 ls = TextSize(g_fonts.small, "FPS");
+    float w = fs.x + ls.x + padx * 2.0f + 6.0f * u + 14.0f * u;
+    float h = fs.y + pady * 2.0f;
+    std::string detail;
+    const float graph_h = 40.0f * u;
+    if (mode >= 2) {
+      detail = fmt::format("{:.1f} ms  ·  worst {:.1f} ms", stats.frame_ms, stats.worst_ms);
+      w = std::max(w, TextSize(g_fonts.small, detail.c_str()).x + padx * 2.0f);
+      w = std::max(w, 200.0f * u);
+      h += TextSize(g_fonts.small, detail.c_str()).y + 6.0f * u + graph_h + 8.0f * u;
+    }
+    if (profiling) h += 20.0f * u;
+    const float x = right_corner ? io.DisplaySize.x - margin - w : margin;
+    const float y = margin;
+    draw->AddRectFilled(ImVec2(x, y), ImVec2(x + w, y + h), IM_COL32(8, 8, 10, 190), 6.0f * u);
+    draw->AddRectFilled(ImVec2(x, y + 6.0f * u), ImVec2(x + 3.0f * u, y + h - 6.0f * u), FpsColour(stats.fps));
+
+    float cy = y + pady;
+    draw->AddCircleFilled(ImVec2(x + padx + 4.0f * u, cy + fs.y * 0.5f), 4.0f * u, FpsColour(stats.fps), 16);
+    Text(draw, g_fonts.counter, ImVec2(x + padx + 14.0f * u, cy), kText, fps_text);
+    Text(draw, g_fonts.small, ImVec2(x + padx + 14.0f * u + fs.x + 6.0f * u, cy + fs.y - ls.y - 3.0f * u), kDim, "FPS");
+    cy += fs.y + 4.0f * u;
+    if (mode >= 2) {
+      Text(draw, g_fonts.small, ImVec2(x + padx, cy), kDim, detail.c_str());
+      cy += TextSize(g_fonts.small, detail.c_str()).y + 6.0f * u;
+      // The last frames' times, 0..50 ms, with the 60 and 30 fps lines.
+      const ImVec2 g0(x + padx, cy), g1(x + w - padx, cy + graph_h);
+      draw->AddRectFilled(g0, g1, IM_COL32(255, 255, 255, 10), 2.0f * u);
+      auto line_at = [&](float ms) { return g1.y - (g1.y - g0.y) * std::min(ms, 50.0f) / 50.0f; };
+      draw->AddLine(ImVec2(g0.x, line_at(16.7f)), ImVec2(g1.x, line_at(16.7f)), WithAlpha(kGood, 0.35f), 1.0f);
+      draw->AddLine(ImVec2(g0.x, line_at(33.3f)), ImVec2(g1.x, line_at(33.3f)), WithAlpha(kFair, 0.35f), 1.0f);
+      if (stats.history.size() >= 2) {
+        std::vector<ImVec2> points;
+        points.reserve(stats.history.size());
+        const float step = (g1.x - g0.x) / float(120 - 1);
+        float px = g1.x - step * float(stats.history.size() - 1);
+        for (const float ms : stats.history) {
+          points.emplace_back(px, line_at(ms));
+          px += step;
+        }
+        draw->AddPolyline(points.data(), int(points.size()), kText, ImDrawFlags_None, 1.4f * u);
+      }
+      cy += graph_h + 8.0f * u;
+    }
+    if (profiling) {
+      Text(draw, g_fonts.small, ImVec2(x + padx, cy), kAmber, "Recording a CPU profile");
+    }
+  }
+
+  void DrawToast(ImGuiIO& io, float dt) {
+    if (toast_left_ <= 0.0f) return;
+    toast_left_ -= dt;
+    const float alpha = std::clamp(toast_left_ / 0.4f, 0.0f, 1.0f);
+    ImDrawList* draw = ImGui::GetForegroundDrawList();
+    const float u = io.DisplaySize.y / 720.0f;
+    const char* text = "Settings saved";
+    const ImVec2 s = TextSize(g_fonts.body, text);
+    const float w = s.x + 40.0f * u, h = s.y + 18.0f * u;
+    const ImVec2 a(io.DisplaySize.x - 28.0f * u - w, io.DisplaySize.y - 32.0f * u - h);
+    draw->AddRectFilled(a, ImVec2(a.x + w, a.y + h), WithAlpha(IM_COL32(14, 14, 16, 235), alpha), 5.0f * u);
+    draw->AddRectFilled(a, ImVec2(a.x + 3.0f * u, a.y + h), WithAlpha(kAccent, alpha));
+    draw->AddCircleFilled(ImVec2(a.x + 16.0f * u, a.y + h * 0.5f), 3.5f * u, WithAlpha(kGood, alpha), 12);
+    Text(draw, g_fonts.body, ImVec2(a.x + 28.0f * u, a.y + (h - s.y) * 0.5f), WithAlpha(kText, alpha), text);
+  }
+
+  // While the buttons that closed the menu are held: an empty window keeps the navigation focus (so the game's pad
+  // stays neutral) until they are released.
+  void HoldFocus() {
+    ImGui::SetNextWindowPos(ImVec2(-100.0f, -100.0f), ImGuiCond_Always);
+    ImGui::SetNextWindowSize(ImVec2(1.0f, 1.0f), ImGuiCond_Always);
+    ImGui::SetNextWindowFocus();
+    ImGui::Begin("##mp3-menu-release", nullptr,
+                 ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoBackground | ImGuiWindowFlags_NoSavedSettings);
+    ImGui::End();
+  }
+
+  Phase phase_ = Phase::kClosed;
+  float open_ = 0.0f;
+  int tab_ = 0;
+  int selected_ = -1;
+  float highlight_y_ = -1.0f;
+  bool jump_ = true;
+  float nudge_ = 0.0f;
+  bool combo_held_ = false;
+  bool dirty_ = false;
+  bool start_profile_ = false;
+  float toast_left_ = 0.0f;
+};
+
+// UI thread: the dialog for the menu (made when it is first needed).
+QuickMenu& Dialog() {
+  if (!g_state.dialog) g_state.dialog = new QuickMenu(g_state.drawer);
+  return *g_state.dialog;
+}
+
+void Open() {
+  if (!g_state.drawer) return;
+  Dialog().Show();
+  g_animating = true;
+  g_state.drawer->RequestRepaint();
+}
+
+// The dialog cannot delete itself inside its own Draw: after it, on the UI thread.
+void ReleaseLater() {
+  static bool pending = false;
+  if (pending || !g_state.context) return;
+  pending = true;
+  g_state.context->CallInUIThreadDeferred([] {
+    pending = false;
+    if (g_state.dialog && g_state.dialog->Idle()) {
+      delete g_state.dialog;
+      g_state.dialog = nullptr;
+    }
+  });
+}
+
+void StartRepaintTicker() {
+  std::thread([] {
+    for (;;) {
+      if (g_animating.load(std::memory_order_relaxed) && g_state.context) {
+        g_state.context->CallInUIThread([] {
+          if (g_state.drawer && g_state.dialog) g_state.drawer->RequestRepaint();
+        });
+        std::this_thread::sleep_for(std::chrono::microseconds(16667));
+      } else {
+        std::this_thread::sleep_for(std::chrono::milliseconds(30));
+      }
+    }
+  }).detach();
+}
+
+}  // namespace
+
+void AddFonts(ImFontAtlas* atlas) {
+  static const ImWchar kLatin[] = {0x0020, 0x00FF, 0x2013, 0x2014, 0x2022, 0x2022, 0x2026, 0x2026, 0};
+  static const ImWchar kCapitals[] = {0x0020, 0x005A, 0};
+  g_fonts.title = AddLato(atlas, kLatoBlack, sizeof(kLatoBlack), 40.0f, kCapitals);
+  g_fonts.tab = AddLato(atlas, kLatoBlack, sizeof(kLatoBlack), 15.0f, kLatin);
+  g_fonts.row = AddLato(atlas, kLatoRegular, sizeof(kLatoRegular), 18.0f, kLatin);
+  g_fonts.value = AddLato(atlas, kLatoBlack, sizeof(kLatoBlack), 16.0f, kLatin);
+  g_fonts.body = AddLato(atlas, kLatoRegular, sizeof(kLatoRegular), 14.0f, kLatin);
+  g_fonts.counter = AddLato(atlas, kLatoBlack, sizeof(kLatoBlack), 26.0f, kLatin);
+  g_fonts.small = AddLato(atlas, kLatoRegular, sizeof(kLatoRegular), 12.0f, kLatin);
+  if (!g_fonts.title || !g_fonts.tab || !g_fonts.row || !g_fonts.value || !g_fonts.body || !g_fonts.counter ||
+      !g_fonts.small) {
+    REXLOG_ERROR("[menu] the Lato fonts could not be loaded");
+  }
+}
+
+void Attach(rex::ui::WindowedAppContext& context, rex::ui::ImGuiDrawer* drawer, std::filesystem::path config) {
+  g_state.context = &context;
+  g_state.drawer = drawer;
+  g_state.config = std::move(config);
+  if (!g_fonts.row) {
+    REXLOG_WARN("[menu] no fonts: the quick menu is off");
+    g_state.drawer = nullptr;
+    return;
+  }
+  drawer->SetContinuousRepaint(false);
+  StartRepaintTicker();
+  if (REXCVAR_GET(mp3_frame_counter) > 0) Dialog();
+  REXLOG_INFO("[menu] L3+R3 opens the quick menu (settings saved to {})", g_state.config.string());
+}
+
+uint32_t SwapCount() { return g_swaps.load(std::memory_order_acquire); }
+
+std::string StatsText() {
+  const FrameStats stats = ReadStats(0);
+  return fmt::format("{:.1f} fps, {:.1f} ms a frame (worst {:.1f} ms in the last second), {} swaps so far", stats.fps,
+                     stats.frame_ms, stats.worst_ms, SwapCount());
+}
+
+void NoteSwap() {
+  const uint32_t n = g_swaps.load(std::memory_order_relaxed);
+  const uint64_t now = NowNs();
+  g_swap_ns[n % kRing].store(now, std::memory_order_relaxed);
+  g_swaps.store(n + 1, std::memory_order_release);  // one writer: the GPU thread
+  // mp3_auto_profile: seconds in a row under mp3_auto_profile_fps swaps, checked once a second.
+  static uint64_t second_start = 0, slow_since = 0;
+  static uint32_t second_swaps = 0;
+  static bool profiled = false;
+  ++second_swaps;
+  if (!second_start) second_start = now;
+  if (now - second_start >= 1'000'000'000ull) {
+    const bool slow = second_swaps < uint32_t(REXCVAR_GET(mp3_auto_profile_fps));
+    second_swaps = 0;
+    second_start = now;
+    if (!slow) {
+      slow_since = 0;
+    } else if (!slow_since) {
+      slow_since = now;
+    } else if (!profiled && REXCVAR_GET(mp3_auto_profile) &&
+               now - slow_since >= uint64_t(REXCVAR_GET(mp3_auto_profile_s)) * 1'000'000'000ull &&
+               ps4_profile_running() == 0) {
+      profiled = true;
+      ps4_profile_set_enabled(1);
+      static char label[64];
+      snprintf(label, sizeof(label), "auto: under %d fps for %d s", REXCVAR_GET(mp3_auto_profile_fps),
+               REXCVAR_GET(mp3_auto_profile_s));
+      const bool started = ps4_profile_start(kProfileSeconds, label);
+      REXLOG_INFO("[menu] {}: CPU profile of {:.0f} s {}", label + 6, kProfileSeconds,
+                  started ? "started (mp3_auto_profile)" : "not started");
+    }
+  }
+  if (rex::input::ps4::PS4InputDriver::TakeMenuCombo()) {
+    if (g_menu_owns_combo.load() || NowNs() < g_combo_quiet_until_ns.load()) return;
+    if (g_state.context && g_state.drawer) g_state.context->CallInUIThread([] { Open(); });
+  }
+}
+
+}  // namespace mp3::menu
diff --git a/mp3/ps4/mp3_ps4_menu.h b/mp3/ps4/mp3_ps4_menu.h
new file mode 100644
index 0000000..94b68e9
