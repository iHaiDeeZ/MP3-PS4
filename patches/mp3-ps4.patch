--- /dev/null
+++ b/mp3/tools/make_ps4_pch.py
@@ -0,0 +1,100 @@
+#!/usr/bin/env python3
+"""Make the PS4 PCH for the generated code (mp3/ps4/CMakeLists.txt, through prepare_tree.py).
+
+The Switch PCH (make_nx_pch.py) first, for what is not ARM: the per-thread interrupt locks (point 3), the guest stack
+accesses without volatile (6), the check build's report function (7), the include guard (9). Then the PS4's own
+changes, for an x86-64 Jaguar (no FMA unit, total store order) and the PS4's guest memory:
+
+  a. REX_PHYS_HOST_OFFSET: the 0xE0000000 heap sits 4 KiB further in host memory on the PS4 (64 KiB allocation
+     granularity, as on Windows; sdk/src/core/memory_ps4.cpp). ReXGlue v0.10.0's template gives the offset only to
+     Windows and arm64 macOS: without it every access to that heap reads the wrong page (the MGR port's v00.03 crash).
+  b. REX_VMADDFP / REX_VNMSUBFP (patch_vmx_exact.py): a multiply and an add. simde's fmadd is libm's software fma on
+     the Jaguar, a third of an audio thread in the MGR port's first profile.
+  c. tools/patch_barriers.py's macros are not used: the PS4 build runs the codegen with BARRIERS=0 (x86 orders memory
+     by itself, as the codegen assumes), so nothing here.
+  d. REX_FMA for tools/ps4_unfused_fma.py (the codegen's std::fma): a multiply and an add.
+  e. REX_LOAD_U32_B(base_register, displacement) ... for tools/patch_phys_base.py (v00.47): the 0xE0000000 heap's
+     offset taken from the base register, so one check serves every access through the same pointer.
+
+Usage: make_ps4_pch.py <generated/default/mp3_pch.h> <out.h>
+"""
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+src, dst = sys.argv[1], sys.argv[2]
+here = Path(__file__).resolve().parent
+
+with tempfile.TemporaryDirectory() as tmp:
+    nx = Path(tmp) / "mp3_pch.h"
+    subprocess.check_call([sys.executable, "-I", str(here / "make_nx_pch.py"), src, str(nx)],
+                          stdout=subprocess.DEVNULL)
+    text = nx.read_text(encoding="utf-8")
+
+# a. The physical heap's host offset.
+OFFSET = "#if REX_PLATFORM_WIN32 || (REX_PLATFORM_MAC && REX_ARCH_ARM64)\n#define REX_PHYS_HOST_OFFSET"
+if text.count(OFFSET) != 1:
+    sys.exit("REX_PHYS_HOST_OFFSET condition not found exactly once")
+text = text.replace(OFFSET, "#if REX_PLATFORM_WIN32 || REX_PLATFORM_PS4 || (REX_PLATFORM_MAC && REX_ARCH_ARM64)\n"
+                            "#define REX_PHYS_HOST_OFFSET")
+
+# b. vmaddfp / vnmsubfp unfused.
+FUSED = """#include <simde/x86/fma.h>
+#define REX_VMADDFP(a, b, c) simde_mm_fmadd_ps((a), (b), (c))
+#define REX_VNMSUBFP(a, b, c) simde_mm_fnmadd_ps((a), (b), (c))
+"""
+if text.count(FUSED) != 1:
+    sys.exit("REX_VMADDFP block not found exactly once")
+text = text.replace(FUSED, """// PS4 (make_ps4_pch.py, b): the Jaguar has no FMA unit, so a multiply and an add (one rounding more than the console).
+#include <simde/x86/sse.h>
+#define REX_VMADDFP(a, b, c) simde_mm_add_ps(simde_mm_mul_ps((a), (b)), (c))
+#define REX_VNMSUBFP(a, b, c) simde_mm_sub_ps((c), simde_mm_mul_ps((a), (b)))
+""")
+
+# d. REX_FMA (tools/ps4_unfused_fma.py writes it for the codegen's std::fma): a multiply and an add on the Jaguar.
+if "REX_FMA" not in text:
+    text = text.replace("\n#endif  // MP3_NX_PCH_H\n", """
+// PS4 (make_ps4_pch.py, d): the fmadd family (tools/ps4_unfused_fma.py).
+#if defined(__FMA__)
+#define REX_FMA(a, b, c) std::fma((a), (b), (c))
+#else
+#define REX_FMA(a, b, c) ((a) * (b) + (c))
+#endif
+
+#endif  // MP3_NX_PCH_H
+""")
+    if "REX_FMA" not in text:
+        sys.exit("include guard end not found (REX_FMA)")
+
+# e. Register + displacement accesses with the heap offset from the base register (tools/patch_phys_base.py).
+if "REX_LOAD_U32_B" not in text:
+    text = text.replace("\n#endif  // MP3_NX_PCH_H\n", """
+// PS4 (make_ps4_pch.py, e; v00.47): a register + displacement access takes the 0xE0000000 heap's host offset from
+// its base register (tools/patch_phys_base.py), so the compiler checks a pointer once for all its accesses.
+#define REX_LOAD_U8_B(b, d) (*(volatile u8*)(base + (u32)((b) + (d)) + REX_PHYS_HOST_OFFSET(b)))
+#define REX_LOAD_U16_B(b, d) __builtin_bswap16(*(volatile u16*)(base + (u32)((b) + (d)) + REX_PHYS_HOST_OFFSET(b)))
+#define REX_LOAD_U32_B(b, d) __builtin_bswap32(*(volatile u32*)(base + (u32)((b) + (d)) + REX_PHYS_HOST_OFFSET(b)))
+#define REX_LOAD_U64_B(b, d) __builtin_bswap64(*(volatile u64*)(base + (u32)((b) + (d)) + REX_PHYS_HOST_OFFSET(b)))
+#define REX_STORE_U8_B(b, d, y) (*(volatile u8*)(base + (u32)((b) + (d)) + REX_PHYS_HOST_OFFSET(b)) = (y))
+#define REX_STORE_U16_B(b, d, y) \\
+  (*(volatile u16*)(base + (u32)((b) + (d)) + REX_PHYS_HOST_OFFSET(b)) = __builtin_bswap16(y))
+#define REX_STORE_U32_B(b, d, y) \\
+  (*(volatile u32*)(base + (u32)((b) + (d)) + REX_PHYS_HOST_OFFSET(b)) = __builtin_bswap32(y))
+#define REX_STORE_U64_B(b, d, y) \\
+  (*(volatile u64*)(base + (u32)((b) + (d)) + REX_PHYS_HOST_OFFSET(b)) = __builtin_bswap64(y))
+
+#endif  // MP3_NX_PCH_H
+""")
+    if "REX_LOAD_U32_B" not in text:
+        sys.exit("include guard end not found (REX_LOAD_U32_B)")
+
+try:
+    previous = open(dst, encoding="utf-8").read()
+except OSError:
+    previous = None
+if previous == text:
+    print("unchanged", dst)
+else:
+    open(dst, "w", encoding="utf-8").write(text)
+    print("wrote", dst)
