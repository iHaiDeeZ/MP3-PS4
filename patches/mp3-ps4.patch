+  const uint64_t extent = uint64_t(layout.pitch_texels) * layout.height * 4;
+  const u32 width = u32(rect.right - rect.left), height = u32(rect.bottom - rect.top);
+  if (layout.in_tail || !extent || extent > kResolveReadbackBytes || !width || !height)
+    return;
