+  const TextureFetch fetch = TextureFetch::FromHeader(guest->Format);
+  if (!fetch.BasePage() || fetch.Format() != GpuTextureFormat::Fmt32_Float ||
+      fetch.Dimension() != TextureDimension::Tex2D)
+    return;
+  const TextureLevelLayout layout = GetTextureLevelLayout(fetch, 0);
+  const uint64_t extent = uint64_t(layout.pitch_texels) * layout.height * 4;
+  if (layout.in_tail || !extent || extent > kResolveReadbackBytes)
+    return;
