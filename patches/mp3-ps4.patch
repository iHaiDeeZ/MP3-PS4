+        Row freeze;
+        freeze.kind = Row::Kind::kSwitch;
+        freeze.label = "Freeze report";
+        freeze.get = [] { return rex::cvar::Query<bool>("mp3_freeze_report") ? 1 : 0; };
+        freeze.set = [](int v) { SetCvar("mp3_freeze_report", v ? "true" : "false"); };
+        freeze.help = fmt::format(
+            "When the game shows no new frame for 15 s, writes where every thread is to {}/hang.log (again 30 s "
+            "later): what to send after a freeze.",
+            ps4_diag_data_dir());
+        rows.push_back(std::move(freeze));
+
+#if MP3_LIVE_CONSOLE  // v00.51: left out (mp3_ps4_switches.h)
+        Row live;
+        live.kind = Row::Kind::kSwitch;
