+void CompleteResolveReadbacksLocked(uint32_t index) {
+  SlotReadbacks &slot = g_resolve_readbacks[index];
+  if (slot.pending.empty())
+    return;
+  if (const auto *data = slot.buffer ? static_cast<const u8 *>(slot.buffer->map()) : nullptr) {
+    for (const ResolveReadback &r : slot.pending) {
+      u8 *guest = GuestPhysicalPtr<u8>(r.base);
+      if (!guest)
+        continue;
+      const float scale = std::ldexp(1.0f, r.exp);
+      float lo = INFINITY, hi = -INFINITY;  // mp3-ps4 (v00.41): the range and the non-zero texels, for the log
+      u32 nonzero = 0;
