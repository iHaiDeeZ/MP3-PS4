new file mode 100644
index 0000000..a55a93b
--- /dev/null
+++ b/mp3/ps4/mp3_ps4.cpp
@@ -0,0 +1,14 @@
+// mp3-ps4 - Max Payne 3 on the PS4: the port's settings for ps4-kit's runtime.
+//
+// /data/MP3 is the app's folder: mp3.toml (written on the first start), the logs, the caches, the kit's boot trace
+// and crash log, and the game itself (game/ or god/, update/). The SDK's executable and user folders point here
+// (sdk/src/core/filesystem_posix.cpp), because /app0 is read-only.
+
+#include <ps4_kit.h>
+#include <ps4_kit_diag.h>
+
+PS4_DIAG_DATA_DIR("/data/MP3");
+
+extern "C" void ps4_kit_configure_heap(ps4_kit_heap_options* options) {
+  options->log_tag = "mp3";
+}
diff --git a/mp3/ps4/mp3_ps4_app.h b/mp3/ps4/mp3_ps4_app.h
new file mode 100644
index 0000000..351c305
--- /dev/null
+++ b/mp3/ps4/mp3_ps4_app.h
@@ -0,0 +1,230 @@
+// mp3-ps4 - Max Payne 3 (Xbox 360, Title Update 6) on the PS4: the app.
+//
+// The same game folders as the Switch build (src/mp3_app.h), in the app's data folder /data/MP3 (the SDK's
+// executable folder on the PS4, PS4_DIAG_DATA_DIR in mp3_ps4.cpp):
+//   game/     the extracted disc 1 (default.xex, common.rpf, xbox360.rpf, audio*.rpf ...) with TU6's default.xexp, or
+//   god/      disc 1's Games on Demand package as it is on the Xbox 360's drive (src/mp3_god.cpp)
+//   update/   the files of Title Update 6's disc001/ folder (the game's update:)
+// Since v00.51 the package itself can hold game/ and update/ (the one-file package: scripts/build-mp3.sh pkg with
+// MP3_PKG_GAME=1); they are read from /app0 before /data/MP3.
+//
+// What differs from the Switch: no deko3d renderer. The game's command ring goes to the SDK's Xenos emulation, drawn
+// by its Vulkan back end on ps4-kit's RADV (gpu_plugin "xenos"), shaders translated at run time; sound through
+// sceAudioOut, the pad through scePad (the SDK's PS4 back ends).
+
+#pragma once
+
+#include <rex/cvar.h>
+#include <rex/filesystem.h>
+#include <rex/logging.h>
+#include <rex/rex_app.h>
+#include <rex/runtime.h>
+#include <rex/system.h>
+#include <rex/system/gpu_plugin.h>
+
+#include <cstdlib>
+#include <filesystem>
+#include <memory>
+#include <string>
+#include <system_error>
+
+#include "mp3_cpu.h"
+#include "mp3_god.h"
+#include "mp3_ps4_fps.h"
+#include "mp3_ps4_icons.h"
+#include "mp3_ps4_live.h"
+#if defined(__PS4__)  // the PS4's quick menu and freeze report (ps4-kit); the PC build has neither
+#include "mp3_ps4_menu.h"
+#include "mp3_ps4_watchdog.h"
+#endif
+#if MP3_RENUT  // v00.35: Renut, the MGR port's Direct3D-level renderer (mp3/renut)
+#include <functional>
+#include <optional>
+#include "cpu/sa2_enhancements.h"
+#include "renut_engine/gpu/banjo_renut_select.h"
+#include "renut_engine/gpu/overlay/app_integration.h"
+#endif
+
+REXCVAR_DECLARE(std::string, gpu_plugin);
+
+REXCVAR_DEFINE_STRING(mp3_game, "", "MP3", "Game folder (extracted disc 1 + default.xexp). Empty: game/ in /data/MP3.");
+#if !defined(__PS4__)
+REXCVAR_DEFINE_STRING(mp3_gpu_backend, "vulkan", "MP3",
+                      "PC build: the Xenos plugin's back end: vulkan (as the PS4), d3d12 or any (D3D12 first)");
+#endif
+REXCVAR_DEFINE_STRING(mp3_god, "", "MP3",
+                      "Disc 1's Games on Demand package: its header file (beside its .data folder) or the folder "
+                      "holding it. Empty: god/ in /data/MP3.");
+
+class Mp3App : public rex::ReXApp {
+ public:
+  using rex::ReXApp::ReXApp;
+
+  static std::unique_ptr<rex::ui::WindowedApp> Create(rex::ui::WindowedAppContext& ctx) {
+    return std::unique_ptr<Mp3App>(new Mp3App(ctx, "mp3", PPCImageConfig));
+  }
+
+ protected:
+  // The SDK's Xenos GPU (Vulkan back end), linked into the eboot.
+  void OnPreSetup(rex::RuntimeConfig& config) override {
+#if MP3_RENUT
+    // v00.35: Renut draws the game's Direct3D calls itself: no SDK graphics system and no GPU plugin.
+    if (banjo::renut_gpu::Active()) {
+      renut::gpu::ConfigureRuntime(config);
+      return;
+    }
+#endif
+    if (config.gpu_plugin.empty()) config.gpu_plugin = "xenos";
+#if !defined(__PS4__)
+    // The PC build (mp3/win): Vulkan as on the PS4, or the D3D12 back end, to compare (mp3_gpu_backend).
+    if (!config.graphics) {
+      config.graphics = rex::system::LoadGpuPlugin(config.gpu_plugin, REXCVAR_GET(mp3_gpu_backend));
+    }
+#endif
+    mp3::fps::ApplyBeforeGraphics();  // the 60 fps mode's vblank rate, before the GPU starts its vblank thread
+  }
+
+  // game_data_root is the folder with default.xex (ConstructRuntime checks it).
+  void OnConfigurePaths(rex::PathConfig& paths) override {
+    const auto folder = rex::filesystem::GetExecutableFolder();
+    std::error_code ec;
+    // Title Update 6's files for disc 1 (default.xexp, update.rpf ...): the game reads them as update:.
+    if (paths.update_data_root.empty()) {
+      if (const auto packaged = PackagedFolder("update", "default.xexp"); !packaged.empty()) {
+        paths.update_data_root = packaged;
+      } else if (!folder.empty() && std::filesystem::is_directory(folder / "update", ec)) {
+        paths.update_data_root = folder / "update";
+      }
+    }
+    if (!paths.game_data_root.empty()) return;
+    const std::string flag = REXCVAR_GET(mp3_game);
+    if (!flag.empty()) {
+      paths.game_data_root = flag;
+      return;
+    }
+    if (const auto packaged = PackagedFolder("game", "default.xex"); !packaged.empty()) {
+      paths.game_data_root = packaged;
+      packaged_game_ = true;
+      return;
+    }
+    if (folder.empty()) return;
+    if (!GodPackage().empty()) {
+      // A Games on Demand package: its executable is loaded from god_xex/ (mp3_god.cpp fills it).
+      std::filesystem::create_directories(folder / "god_xex", ec);
+      paths.game_data_root = folder / "god_xex";
+      return;
+    }
+    paths.game_data_root = folder / "game";
+  }
+
+  void OnPostInitLogging() override {
+    mp3::cpu::InformarSistema();
+#if MP3_RENUT
+    sa2::enh::Resolve();  // Renut's enhancement masters, before any guest thread
+#endif
+  }
+
+#if MP3_RENUT
+  // v00.35: Renut's plume-backed drawer for the SDK's ImGui (the quick menu), its device and present thread once the
+  // window is there, as the MGR port's app does it.
+  std::unique_ptr<rex::ui::ImmediateDrawer> OnCreateImmediateDrawer() override {
+    if (banjo::renut_gpu::Active()) return renut::gpu::CreateOverlayDrawer();
+    return ReXApp::OnCreateImmediateDrawer();
+  }
+  void OnWindowPixelSizeChanged(uint32_t width, uint32_t height) override {
+    ReXApp::OnWindowPixelSizeChanged(width, height);
+    if (banjo::renut_gpu::Active()) renut::gpu::OnWindowResized();
+  }
+  std::optional<rex::PathConfig> OnFinalizePaths(const rex::PathConfig& defaults,
+                                                 std::function<void(rex::PathConfig)> resume) override {
+    if (banjo::renut_gpu::Active() &&
+        !renut::gpu::StartRenderer(app_context(), [this] { return imgui_drawer(); })) {
+      Fail("Max Payne 3: the native renderer (Renut) could not start its Vulkan device.");
+    }
+    return ReXApp::OnFinalizePaths(defaults, std::move(resume));
+  }
+  void OnShutdown() override {
+    if (banjo::renut_gpu::Active()) renut::gpu::ShutdownRenderer();
+  }
+#endif
+
+#if defined(__PS4__)
+  // The L3+R3 quick menu and the frame counter (mp3_ps4_menu.cpp); its settings go to the file ReXApp loads.
+  void OnConfigureFonts(ImFontAtlas* atlas) override { mp3::menu::AddFonts(atlas); }
+  void OnCreateDialogs(rex::ui::ImGuiDrawer* drawer) override {
+    mp3::menu::Attach(app_context(), drawer, rex::filesystem::GetExecutableFolder() / "mp3.toml");
+  }
+#endif
+
+  void OnLoadXexImage(std::string& xex_image) override {
+    std::error_code ec;
+    const auto root = game_data_root();
+    const auto folder = rex::filesystem::GetExecutableFolder();
+    // TU6's files: the package's (/app0/update) or /data/MP3's (OnConfigurePaths).
+    const auto update = update_data_root().empty() ? folder / "update" : update_data_root();
+    bool god = false;
+    try {
+      god = mp3::god::Montar(*runtime(), packaged_game_ ? std::filesystem::path() : GodPackage(), root, update);
+    } catch (const std::exception& error) {
+      Fail(std::string("Max Payne 3: ") + error.what());
+    }
+    for (const char* name : {"default.xex", "default.xexp"}) {
+      if (!std::filesystem::is_regular_file(root / name, ec)) {
+        Fail(fmt::format("Max Payne 3: {} is missing from {}. Copy your disc 1 (or its Games on Demand package to "
+                         "/data/MP3/god) and Title Update 6's disc001 files (to /data/MP3/update).",
+                         name, root.string()));
+      }
+    }
+    if (!std::filesystem::is_regular_file(update / "update.rpf", ec)) {
+      REXLOG_WARN("mp3: {} has no update.rpf: Title Update 6's data files are missing", update.string());
+    }
+    REXLOG_INFO("mp3: game at {}{}, update at {}; loading {}", root.string(), god ? " and god/" : "",
+                update.string(), xex_image);
+  }
+
+  void OnPreLaunchModule() override {
+    mp3::cpu::Configurar();
+    mp3::god::DespuesDeCargar(*runtime());
+    mp3::fps::Install(*runtime());
+    mp3::icons::Install(runtime());
+#if defined(__PS4__)
+    mp3::watchdog::Start();
+#endif
+    mp3::live::Start(runtime(), rex::filesystem::GetExecutableFolder() / "mp3.toml");
+  }
+
+ private:
+  // v00.51: the game came from the package (/app0/game): no Games on Demand package is mounted over it.
+  bool packaged_game_ = false;
+
+  // v00.51: name/ inside the package when it holds marker (the one-file package), before any copy in /data/MP3.
+  // Empty when the package does not hold it, and on the PC.
+  static std::filesystem::path PackagedFolder(const char* name, const char* marker) {
+#if defined(__PS4__)
+    std::error_code ec;
+    const std::filesystem::path folder = std::filesystem::path("/app0") / name;
+    if (std::filesystem::is_regular_file(folder / marker, ec)) return folder;
+#else
+    (void)name;
+    (void)marker;
+#endif
+    return {};
+  }
+
+  // Disc 1's Games on Demand package: mp3_god, or god/ in /data/MP3; empty when there is none.
+  static std::filesystem::path GodPackage() {
+    std::error_code ec;
+    const std::string flag = REXCVAR_GET(mp3_god);
+    if (!flag.empty()) return std::filesystem::exists(flag, ec) ? std::filesystem::path(flag) : std::filesystem::path();
+    const auto folder = rex::filesystem::GetExecutableFolder();
+    if (!folder.empty() && std::filesystem::is_directory(folder / "god", ec)) return folder / "god";
+    return {};
+  }
+
+  [[noreturn]] static void Fail(const std::string& msg) {
+    REXLOG_ERROR("{}", msg);
+    rex::ShowSimpleMessageBox(rex::SimpleMessageBoxType::Error, msg);
+    rex::FlushLogging();
+    std::_Exit(1);
+  }
+};
diff --git a/mp3/ps4/mp3_ps4_audio.cpp b/mp3/ps4/mp3_ps4_audio.cpp
new file mode 100644
index 0000000..24be237
--- /dev/null
+++ b/mp3/ps4/mp3_ps4_audio.cpp
@@ -0,0 +1,227 @@
+// mp3-ps4 (v00.46) - Max Payne 3's audio in busy scenes.
+//
+// v00.45's busy fight (2026-11-08, 4-17 fps; the live console's `profile 8` and 16 `dump`s): the main thread spent
+// ~30 % of each frame waiting at sub_8221E0B8 for the helper thread that runs the game's per-frame audio update
+// (entry sub_82220320, work sub_8221FB18). In 9 of the 16 dumps that helper was asleep in sub_82C42610, the update's
+// triple buffer: when the audio thread (RAGE's, loop sub_82C27D88) has not taken the last update yet, it waits for it
+// in Sleep(0) steps for up to 1 s; after a 1 s wait it sets the byte at 0x83705DF8 and never waits again
+// (sub_82C425E8 clears it). The audio thread was behind because it waits for XAudio2's engine lock (sub_82FEA618, 14
+// of the 16 dumps), which XAudio2's thread holds through each processing pass and is busy ~90 % of the time.
+// - mp3_audio_no_wait sets that byte before each call: the game's own way of going on without waiting (an update the
+//   audio thread has not taken yet is written over).
+// - mp3_audio_native_mix: the XAudio2 thread's busiest function, sub_82FEE438 (11 % of it), in native SSE code.
+
+#include "mp3_pch.h"
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/system/xmemory.h>
+
+#include <immintrin.h>
+
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+
+REXCVAR_DEFINE_BOOL(mp3_audio_no_wait, true, "MP3",
+                    "The game's per-frame audio update does not wait for the audio thread to take the last one (the "
+                    "game's own flag for this at 0x83705DF8, which it sets itself after a 1 s wait): in busy scenes the "
+                    "main thread waited for it ~30 % of each frame");
+
+REXCVAR_DEFINE_BOOL(mp3_audio_native_mix, true, "MP3",
+                    "XAudio2's mono to 5.1 mixer (sub_82FEE438, the XAudio2 thread's busiest function) in native SSE "
+                    "code instead of the generated code, the same samples bit for bit");
+
+namespace {
+
+// sub_82C42610's flag: non-zero = do not wait for the audio thread.
+constexpr uint32_t kAudioNoWaitFlag = 0x83705DF8;
+std::atomic<bool> g_no_wait_set{false};
+
+inline float LoadBE(const uint8_t* p) {
+  uint32_t u;
+  std::memcpy(&u, p, 4);
+  u = __builtin_bswap32(u);
+  float f;
+  std::memcpy(&f, &u, 4);
+  return f;
+}
+
+inline void StoreBE(uint8_t* p, float f) {
+  uint32_t u;
+  std::memcpy(&u, &f, 4);
+  u = __builtin_bswap32(u);
+  std::memcpy(p, &u, 4);
+}
+
+// Four big-endian guest floats (any alignment) as a vector in element order, and back.
+inline __m128 LoadBE4(const uint8_t* p) {
+  const __m128i swap = _mm_setr_epi8(3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12);
+  return _mm_castsi128_ps(_mm_shuffle_epi8(_mm_loadu_si128(reinterpret_cast<const __m128i*>(p)), swap));
+}
+
+inline void StoreBE4(uint8_t* p, __m128 v) {
+  const __m128i swap = _mm_setr_epi8(3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12);
+  _mm_storeu_si128(reinterpret_cast<__m128i*>(p), _mm_shuffle_epi8(_mm_castps_si128(v), swap));
+}
+
+template <int Lane>
+inline __m128 Splat(__m128 v) {
+  return _mm_shuffle_ps(v, v, _MM_SHUFFLE(Lane, Lane, Lane, Lane));
+}
+
+}  // namespace
+
+REX_EXTERN(__imp__sub_82C42610);
+REX_HOOK_RAW(sub_82C42610) {
+  uint8_t* flag = rex::memory::GuestPtr(base, kAudioNoWaitFlag);
+  if (REXCVAR_GET(mp3_audio_no_wait)) {
+    if (*flag == 0) {
+      *flag = 1;
+      if (!g_no_wait_set.exchange(true, std::memory_order_relaxed)) {
+        REXLOG_INFO("[audio] the game's audio update no longer waits for the audio thread (mp3_audio_no_wait)");
+      }
+    }
+  } else if (g_no_wait_set.exchange(false, std::memory_order_relaxed)) {
+    *flag = 0;  // the game's own behaviour again (it sets the flag itself after a 1 s wait)
+    REXLOG_INFO("[audio] the game's audio update waits for the audio thread again");
+  }
+  __imp__sub_82C42610(ctx, base);
+}
+
+// sub_82FEE438 (mp3-nx's mp3_XAudioMixMonoTo6, sub_8301B028 in 0.0.9.6): one mono voice mixed into a 5.1 bus with a
+// per-channel gain ramp. r3 = a job of guest words: +0 the input (n floats), +4 the output (n frames of 6 interleaved
+// floats), +8 the 6 starting gains, +12 the 6 gain steps per frame or 0, +20 n, +32 non-zero: add to the output.
+// out[f][c] (+)= in[f] * gain_c(f). The guest keeps two frames' gains in three vectors, A = frame 0's channels 0-3,
+// B = its channels 4-5 and frame 1's 0-1, C = frame 1's 2-5, and runs three loops: one frame at a time until the
+// output is 16-byte aligned, four frames at a time (the gains stepped by twice the step after each pair of frames),
+// then one frame at a time. This is the same arithmetic in the same order, so the samples are the same bits: the
+// multiply and the add unfused as the PS4's generated code does them (REX_VMADDFP), the frame-1 gains summed in
+// double and rounded with flush-to-zero off and the vectors with it on (ctx.fpscr, as there). Nothing reads back the
+// registers the guest leaves (r3 points into its own stack frame; the callers reload what they use).
+REX_EXTERN(__imp__sub_82FEE438);
+REX_HOOK_RAW(sub_82FEE438) {
+  const uint32_t job = ctx.r3.u32;
+  uint32_t in_ea = REX_LOAD_U32(job + 0);
+  uint32_t out_ea = REX_LOAD_U32(job + 4);
+  const uint32_t gains_ea = REX_LOAD_U32(job + 8);
+  const uint32_t steps_ea = REX_LOAD_U32(job + 12);
+  uint32_t n = REX_LOAD_U32(job + 20);
+  const bool add = REX_LOAD_U32(job + 32) != 0;
+  // The guest's first loop runs until the output is 16-byte aligned without looking at n: with 24 bytes a frame only
+  // an 8-byte aligned output gets there (in one frame). Anything else is the original's.
+  if (!REXCVAR_GET(mp3_audio_native_mix) || (out_ea & 7) != 0) {
+    __imp__sub_82FEE438(ctx, base);
+    return;
+  }
+
+  ctx.fpscr.disableFlushMode();
+  float g[6], s[6] = {}, g1[6];
+  for (int c = 0; c < 6; ++c) {
+    g[c] = LoadBE(REX_RAW_ADDR(gains_ea + c * 4));
+  }
+  if (steps_ea != 0) {
+    for (int c = 0; c < 6; ++c) {
+      s[c] = LoadBE(REX_RAW_ADDR(steps_ea + c * 4));
+      g1[c] = static_cast<float>(static_cast<double>(g[c]) + static_cast<double>(s[c]));  // fadds
+    }
+  } else {
+    std::memcpy(g1, g, sizeof(g1));  // the steps are the 0.0 at 0x820A66CC
+  }
+  if (n == 0) {
+    return;  // the guest reaches no vector operation: flush-to-zero stays off
+  }
+
+  ctx.fpscr.enableFlushMode();
+  __m128 A = _mm_setr_ps(g[0], g[1], g[2], g[3]);
+  __m128 B = _mm_setr_ps(g[4], g[5], g1[0], g1[1]);
+  __m128 C = _mm_setr_ps(g1[2], g1[3], g1[4], g1[5]);
+  const __m128 sA = _mm_setr_ps(s[0], s[1], s[2], s[3]);
+  const __m128 sB = _mm_setr_ps(s[4], s[5], s[0], s[1]);
+  const __m128 sC = _mm_setr_ps(s[2], s[3], s[4], s[5]);
+
+  // One frame: channels 0-3 from A, 4-5 from B's first two lanes.
+  auto one_frame = [&](bool step_c) {
+    if (step_c) {
+      C = _mm_add_ps(C, sC);
+    }
+    const __m128 x = _mm_set1_ps(LoadBE(REX_RAW_ADDR(in_ea)));
+    uint8_t* out = REX_RAW_ADDR(out_ea);
+    __m128 p = _mm_mul_ps(x, A);
+    A = _mm_add_ps(A, sA);
+    __m128 q = _mm_mul_ps(x, B);
+    B = _mm_add_ps(B, sB);
+    if (add) {
+      q = _mm_add_ps(q, _mm_setr_ps(LoadBE(out + 16), LoadBE(out + 20), 0.0f, 0.0f));
+      p = _mm_add_ps(p, LoadBE4(out));
+    }
+    StoreBE4(out, p);
+    StoreBE(out + 16, _mm_cvtss_f32(q));
+    StoreBE(out + 20, _mm_cvtss_f32(Splat<1>(q)));
+    out_ea += 24;
+    in_ea += 4;
+  };
+
+  if ((out_ea & 0xC) != 0 && n > 3) {
+    do {
+      one_frame(true);
+      --n;
+    } while ((out_ea & 0xC) != 0);
+  }
+
+  if (n > 3) {
+    const __m128 sA2 = _mm_add_ps(sA, sA);
+    const __m128 sB2 = _mm_add_ps(sB, sB);
+    const __m128 sC2 = _mm_add_ps(sC, sC);
+    for (uint32_t groups = n / 4; groups; --groups) {
+      const __m128 x = LoadBE4(REX_RAW_ADDR(in_ea));
+      const __m128 x0 = Splat<0>(x), x1 = Splat<1>(x), x2 = Splat<2>(x), x3 = Splat<3>(x);
+      const __m128 x0011 = _mm_unpacklo_ps(x, x);
+      const __m128 x2233 = _mm_unpackhi_ps(x, x);
+      uint8_t* out = REX_RAW_ADDR(out_ea);
+      __m128 o0, o1, o2, o3, o4, o5;
+      if (add) {
+        const __m128 d0 = LoadBE4(out), d1 = LoadBE4(out + 16), d2 = LoadBE4(out + 32);
+        const __m128 d3 = LoadBE4(out + 48), d4 = LoadBE4(out + 64), d5 = LoadBE4(out + 80);
+        o0 = _mm_add_ps(_mm_mul_ps(x0, A), d0);
+        o1 = _mm_add_ps(_mm_mul_ps(x0011, B), d1);
+        o2 = _mm_add_ps(_mm_mul_ps(x1, C), d2);
+        B = _mm_add_ps(B, sB2);
+        A = _mm_add_ps(A, sA2);
+        C = _mm_add_ps(C, sC2);
+        o4 = _mm_add_ps(_mm_mul_ps(x2233, B), d4);
+        o3 = _mm_add_ps(_mm_mul_ps(x2, A), d3);
+        o5 = _mm_add_ps(_mm_mul_ps(x3, C), d5);
+        A = _mm_add_ps(A, sA2);
+        B = _mm_add_ps(B, sB2);
+        C = _mm_add_ps(C, sC2);
+      } else {
+        const __m128 B2 = _mm_add_ps(B, sB2);
+        const __m128 A2 = _mm_add_ps(A, sA2);
+        const __m128 C2 = _mm_add_ps(C, sC2);
+        o1 = _mm_mul_ps(x0011, B);
+        o0 = _mm_mul_ps(x0, A);
+        o2 = _mm_mul_ps(x1, C);
+        o4 = _mm_mul_ps(x2233, B2);
+        o3 = _mm_mul_ps(x2, A2);
+        o5 = _mm_mul_ps(x3, C2);
+        B = _mm_add_ps(B2, sB2);
+        A = _mm_add_ps(A2, sA2);
+        C = _mm_add_ps(C2, sC2);
+      }
+      StoreBE4(out, o0);
+      StoreBE4(out + 16, o1);
+      StoreBE4(out + 32, o2);
+      StoreBE4(out + 48, o3);
+      StoreBE4(out + 64, o4);
+      StoreBE4(out + 80, o5);
+      out_ea += 96;
+      in_ea += 16;
+    }
+    n &= 3;
+  }
+
+  for (; n; --n) {
+    one_frame(false);
+  }
+}
diff --git a/mp3/ps4/mp3_ps4_fps.cpp b/mp3/ps4/mp3_ps4_fps.cpp
new file mode 100644
index 0000000..4b32816
--- /dev/null
+++ b/mp3/ps4/mp3_ps4_fps.cpp
@@ -0,0 +1,159 @@
+// mp3-ps4 - the 60 fps mode.
+//
+// Max Payne 3 on the Xbox 360 is capped at 30 fps by Direct3D's present interval. What the disassembly of the 0.0.6.6
+// executable shows (tools/dis.py over tools/codegen.sh's image.bin):
+//
+//   0x83058AA4  Direct3D's swap reads the device's PresentInterval (device+0x36B0): 0 or 1 -> 1 vblank, 2 -> 2, else
+//               more; shifts it to bits 8-11, ORs in the front buffer's address (bits 12-31) and a late-frame
+//               threshold in percent (bits 0-7, from device+0x2FFC), and queues a ring callback with that word to
+//   0x83058080  the swap callback (codegen/names.toml: mp3_D3D_SwapCallback). It sets the swap's target vblank to the
+//               previous swap's + the interval (device+0x4240), and queues the flip (device+0x4254, 8 entries)
+//   0x83057F50  that the vblank handler (from Direct3D's interrupt callback 0x83054048, source 0) makes when the vblank
+//               count (device+0x4238) reaches it: the write of the front buffer to D1GRPH (0x7FC86110). The game's
+//               next frames wait for those swaps to retire.
+//
+// The hook turns an interval of 2 into 1 in the callback's word: a swap retires on the next vblank, 60 a second. The
+// guest vblank stays at 60 Hz, so a game timer that counts vblanks keeps its pace; RAGE times its frames with the
+// clock (mftb), as the PC version, which runs at any frame rate.
+//
+// mp3_60fps_mode = "vblank" is the other lever (the SDK's vblank_rate_scale: a 120 Hz guest vblank, Direct3D's
+// interval of 2 then lasts 16.7 ms), for comparison or if the hook ever misses. mp3_patches writes big-endian words to
+// the game's data after load, for constants found later (code cannot be patched that way: it is recompiled ahead of
+// time).
+
+#include "mp3_ps4_fps.h"
+#include "mp3_ps4_menu.h"
+
+#include "mp3_pch.h"
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/memory.h>
+#include <rex/runtime.h>
+#include <rex/system/xmemory.h>
+
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+#include <string>
+#include <string_view>
+
+// vblank_rate_scale belongs to the GPU code (graphics_system.cpp): by name, so this also links where the GPU is a
+// plugin DLL (the PC build).
+
+REXCVAR_DEFINE_BOOL(mp3_60fps, true, "MP3",
+                    "60 fps mode (the game keeps its speed: it times its frames with the clock). false = the Xbox "
+                    "360's 30 fps");
+REXCVAR_DEFINE_STRING(mp3_60fps_mode, "interval", "MP3",
+                      "How the 60 fps mode works: \"interval\" = Direct3D's present interval 2 -> 1 in its swap "
+                      "callback (mp3_D3D_SwapCallback); \"vblank\" = a 120 Hz guest vblank (vblank_rate_scale 2)")
+    .allowed({"interval", "vblank"});
+// v00.04: two of the SDK's GPU emulation features that make the command processor wait for the whole GPU queue. v00.03's
+// gameplay ran at 3-4 fps with them, cutscenes at 32: each of the game's occlusion queries (lights, coronas) ended the
+// submission and waited for it (VulkanCommandProcessor::EndGuestOcclusionQuery), and each draw that memexports (the
+// GPU particle updates, gpuptfx_update.fxc / ptxgpudrop_update.fxc) read its writes back. Off, a query reports
+// query_occlusion_fake_sample_count samples (1000: visible, as mp3-nx's ring thread does) and the memexport writes stay
+// in the GPU's copy of memory, where the draws that use them read them.
+REXCVAR_DEFINE_BOOL(mp3_occlusion_queries, false, "MP3",
+                    "Real occlusion queries for the game's lights (each one waits for the GPU: slow). false = every "
+                    "query reports visible");
+// v00.05: memexport readback back on. v00.04's GPU side stopped as gameplay began without it (the game waits for
+// what its shaders memexport, by the CPU or the command processor). The SDK's fast path (readback_memexport_fast)
+// double-buffers the copy and reads the previous one, so it does not wait for the GPU: the occlusion queries were the
+// 3-4 fps.
+REXCVAR_DEFINE_BOOL(mp3_memexport_readback, true, "MP3",
+                    "Read the GPU's memexport writes (GPU particles) back for the CPU (the SDK's double-buffered fast "
+                    "path). false froze v00.04's gameplay");
+REXCVAR_DEFINE_STRING(mp3_patches, "", "MP3",
+                      "Data patches after load: \"address=value,...\" (hex, big-endian 32-bit words)");
+
+namespace {
+bool IntervalMode() { return REXCVAR_GET(mp3_60fps) && REXCVAR_GET(mp3_60fps_mode) != "vblank"; }
+}  // namespace
+
+#ifdef MP3_TIENE_mp3_D3D_SwapCallback  // the PS4 port's codegen/names.toml names it (CMakeLists.txt)
+REX_EXTERN(__imp__mp3_D3D_SwapCallback);
+REX_EXTERN(mp3_D3D_SwapCallback) {
+  static std::atomic<uint32_t> calls{0};
+  // The mode is fixed for the session (the vblank one is set up before the GPU starts); mp3_60fps is read at each swap,
+  // so the quick menu's switch applies at once.
+  static const bool interval_mode = REXCVAR_GET(mp3_60fps_mode) != "vblank";
+  const bool unlock = interval_mode && REXCVAR_GET(mp3_60fps);
+  mp3::menu::NoteSwap();
+  const uint32_t word = ctx.r3.u32;
+  const uint32_t interval = (word >> 8) & 0xF;
+  const uint32_t n = calls.fetch_add(1, std::memory_order_relaxed);
+  if (n < 3 || ((n & (n - 1)) == 0 && n < 4096)) {
+    REXLOG_INFO("[fps] swap {}: front buffer {:08X}, interval {}{}, late threshold {} %", n + 1, word & 0xFFFFF000u,
+                interval, unlock && interval == 2 ? " -> 1" : "", word & 0xFF);
+  }
+  if (unlock && interval == 2) {
+    ctx.r3.u64 = (word & ~0xF00u) | 0x100u;
+  }
+  __imp__mp3_D3D_SwapCallback(ctx, base);
+}
+#endif  // MP3_TIENE_mp3_D3D_SwapCallback
+
+namespace mp3::fps {
+
+void ApplyBeforeGraphics() {
+  // v00.08: the game's textures with "invalid" fetch constants (type bits 00, e.g. a 1280x720 8888 resolve at
+  // 0x06675000 the lighting reads, DXT1/DXT5 textures) are real ones: refused, the 3D world came out black under
+  // the HUD in v00.03-v00.07 (3,146 warnings in v00.07's gameplay). Xenia binds them with this setting.
+  if (!rex::cvar::HasNonDefaultValue("gpu_allow_invalid_fetch_constants")) {
+    rex::cvar::SetFlagByName("gpu_allow_invalid_fetch_constants", "true");
+  }
+  // v00.09: the exposure. The game reads its small luminance resolves back on the CPU to set the tonemap's constants
+  // (mp3-nx's PORTING.md runs 13-19); Xenia keeps resolves on the GPU unless resolve readback is on, so the world was
+  // one flat colour. Fast readback (the previous frame's copy, no wait) of the resolves of up to 64 KB only.
+  if (!rex::cvar::HasNonDefaultValue("readback_resolve")) {
+    rex::cvar::SetFlagByName("readback_resolve", "fast");
+  }
+  if (!rex::cvar::HasNonDefaultValue("readback_resolve_max_kb")) {
+    rex::cvar::SetFlagByName("readback_resolve_max_kb", "64");
+  }
+  rex::cvar::SetFlagByName("occlusion_query_enable", REXCVAR_GET(mp3_occlusion_queries) ? "true" : "false");
+  rex::cvar::SetFlagByName("readback_memexport", REXCVAR_GET(mp3_memexport_readback) ? "true" : "false");
+  REXLOG_INFO("[gpu] occlusion queries {}, memexport readback {}",
+              REXCVAR_GET(mp3_occlusion_queries) ? "on (waits for the GPU)" : "off (reported visible)",
+              REXCVAR_GET(mp3_memexport_readback) ? "on (waits for the GPU)" : "off");
+  if (REXCVAR_GET(mp3_60fps) && REXCVAR_GET(mp3_60fps_mode) == "vblank") {
+    rex::cvar::SetFlagByName("vblank_rate_scale", "2");
+  }
+#ifndef MP3_TIENE_mp3_D3D_SwapCallback
+  if (IntervalMode()) {
+    REXLOG_WARN("[fps] this build has no mp3_D3D_SwapCallback hook: 60 fps by the 120 Hz guest vblank instead");
+    rex::cvar::SetFlagByName("vblank_rate_scale", "2");
+  }
+#endif
+  REXLOG_INFO("[fps] {}{}, guest vblank x{}", REXCVAR_GET(mp3_60fps) ? "60 fps mode: " : "30 fps (as on the Xbox 360)",
+              REXCVAR_GET(mp3_60fps) ? REXCVAR_GET(mp3_60fps_mode) : std::string(), rex::cvar::GetFlagByName("vblank_rate_scale"));
+}
+
+void Install(rex::Runtime& runtime) {
+  const std::string list = REXCVAR_GET(mp3_patches);
+  std::string_view rest = list;
+  uint32_t applied = 0;
+  while (!rest.empty()) {
+    const size_t comma = rest.find(',');
+    const std::string item(rest.substr(0, comma));
+    rest = comma == std::string_view::npos ? std::string_view() : rest.substr(comma + 1);
+    const size_t eq = item.find('=');
+    if (eq == std::string::npos) {
+      REXLOG_WARN("[fps] mp3_patches: '{}' is not address=value", item);
+      continue;
+    }
+    const uint32_t address = uint32_t(std::strtoul(item.substr(0, eq).c_str(), nullptr, 16));
+    const uint32_t value = uint32_t(std::strtoul(item.substr(eq + 1).c_str(), nullptr, 16));
+    auto* word = runtime.memory()->TranslateVirtual<uint32_t*>(address);
+    const uint32_t old = __builtin_bswap32(*word);
+    *word = __builtin_bswap32(value);
+    REXLOG_INFO("[fps] patch {:08X}: {:08X} -> {:08X}", address, old, value);
+    ++applied;
+  }
+  if (applied) {
+    REXLOG_INFO("[fps] {} data patches applied", applied);
+  }
+}
+
+}  // namespace mp3::fps
