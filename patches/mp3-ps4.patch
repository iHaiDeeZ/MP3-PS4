new file mode 100644
index 0000000..8a7dd32
--- /dev/null
+++ b/mp3/ps4/mp3_ps4_icons.cpp
@@ -0,0 +1,111 @@
+// mp3-ps4 - PlayStation button icons (v00.19).
+//
+// The user, 2026-11-06: "swap the controller buttons within the game with the ps4 controller buttons", "make high
+// quality 3d buttons". The game's button prompts are small DXT5 textures (32x32: A B X Y, Start, Back, RT; 64x32: LB,
+// RB), Xenos-tiled, 8-in-16 byte order, loaded at addresses that change from run to run. When the texture cache is
+// about to upload a texture of that kind (rex::graphics::TextureCache::SetLoadHook), its blocks are hashed (FNV-1a, in
+// row-major block order) and, for a known Xbox icon, the PlayStation icon's blocks are written over it in guest memory
+// - Cross, Circle, Square, Triangle, OPTIONS, the touch pad (the PS4 driver's Back), R2, L1, R1: rendered by
+// tools/ps_icons.py into mp3_ps4_icons.inc, which holds only their blocks and the Xbox icons' hashes. The write goes
+// through the unprotected physical view; the watches on those pages are fired after it, so the GPU's copy of them
+// is uploaded again. mp3_ps_icons turns it off (the Xbox icons stay).
+
+#include "mp3_ps4_icons.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+
+#include <rex/cvar.h>
+#include <rex/graphics/pipeline/texture/cache.h>
+#include <rex/logging.h>
+#include <rex/runtime.h>
+#include <rex/system/xmemory.h>
+#include <rex/thread/mutex.h>
+
+REXCVAR_DEFINE_BOOL(mp3_ps_icons, true, "MP3",
+                    "PlayStation button icons (Cross, Circle, Square, Triangle, OPTIONS, L1, R1, R2, touch pad) in "
+                    "place of the Xbox ones; read when a texture loads");
+
+namespace mp3::icons {
+
+namespace {
+
+struct ReplacementIcon {
+  uint16_t width, height;
+  uint64_t xbox_hash;
+  const uint8_t* blocks;  // DXT5 blocks as the game stores them, row-major block order
+  const char* name;
+};
+
+#include "mp3_ps4_icons.inc"
+
+rex::memory::Memory* g_memory = nullptr;
+
+constexpr uint32_t kDxt45 = 20;     // xenos::TextureFormat::k_DXT4_5
+constexpr uint32_t kEndian8in16 = 1;  // xenos::Endian::k8in16
+constexpr uint32_t kBlockBytes = 16;
+
+// texture_util::GetTiledOffset2D for 16-byte blocks in a texture whose rows are 32 blocks (tools/icons.py).
+uint32_t TiledOffset(uint32_t x, uint32_t y) {
+  constexpr uint32_t pitch = 32, bpb_log2 = 4;
+  const uint32_t macro = ((x >> 5) + (y >> 5) * (pitch >> 5)) << (bpb_log2 + 7);
+  const uint32_t micro = ((x & 7) + ((y & 0xE) << 2)) << bpb_log2;
+  const uint32_t offset = macro + ((micro & ~0xFu) << 1) + (micro & 0xF) + ((y & 1) << 4);
+  return ((offset & ~0x1FFu) << 3) + ((y & 16) << 7) + ((offset & 0x1C0) << 2) +
+         (((((y & 8) >> 2) + (x >> 3)) & 3) << 6) + (offset & 0x3F);
+}
+
+void OnTextureLoad(uint32_t base, uint32_t format, uint32_t width, uint32_t height, bool tiled,
+                   uint32_t endianness) {
+  if (format != kDxt45 || !tiled || endianness != kEndian8in16 || height != 32 || (width != 32 && width != 64)) {
+    return;
+  }
+  if (!g_memory || !REXCVAR_GET(mp3_ps_icons)) {
+    return;
+  }
+  uint8_t* data = g_memory->TranslatePhysical<uint8_t*>(base);
+  const uint32_t blocks_x = width / 4, blocks_y = height / 4;
+  uint64_t hash = 0xCBF29CE484222325ull;
+  uint32_t extent = 0;
+  for (uint32_t by = 0; by < blocks_y; ++by) {
+    for (uint32_t bx = 0; bx < blocks_x; ++bx) {
+      const uint32_t offset = TiledOffset(bx, by);
+      extent = std::max(extent, offset + kBlockBytes);
+      for (uint32_t i = 0; i < kBlockBytes; ++i) {
+        hash = (hash ^ data[offset + i]) * 0x100000001B3ull;
+      }
+    }
+  }
+  for (const ReplacementIcon& icon : kIcons) {
+    if (icon.width != width || icon.height != height || icon.xbox_hash != hash) {
+      continue;
+    }
+    const uint8_t* source = icon.blocks;
+    for (uint32_t by = 0; by < blocks_y; ++by) {
+      for (uint32_t bx = 0; bx < blocks_x; ++bx) {
+        std::memcpy(data + TiledOffset(bx, by), source, kBlockBytes);
+        source += kBlockBytes;
+      }
+    }
+    // The GPU's copy of these pages (and anything else watching them) is out of date now: fire their watches, as a
+    // guest write would (through the 0xA0000000 view of physical memory).
+    g_memory->TriggerPhysicalMemoryCallbacks(rex::thread::global_critical_region::AcquireDirect(),
+                                             0xA0000000u + base, extent, true, false);
+    REXLOG_INFO("[icons] {} in place of the Xbox icon at {:08X} ({}x{})", icon.name, base, width, height);
+    return;
+  }
+}
+
+}  // namespace
+
+void Install(rex::Runtime* runtime) {
+  g_memory = runtime ? runtime->memory() : nullptr;
+#if !MP3_RENUT  // v00.35: Renut's build has no SDK texture cache (its own upload path needs the hook: to do)
+  rex::graphics::TextureCache::SetLoadHook(&OnTextureLoad);
+#endif
+  REXLOG_INFO("[icons] PlayStation button icons {} ({} icons)", REXCVAR_GET(mp3_ps_icons) ? "on" : "off",
+              sizeof(kIcons) / sizeof(kIcons[0]));
+}
+
+}  // namespace mp3::icons
