diff --git a/mp3/win/prepare_tree_win.py b/mp3/win/prepare_tree_win.py
new file mode 100755
index 0000000..ddcb18c
--- /dev/null
+++ b/mp3/win/prepare_tree_win.py
@@ -0,0 +1,33 @@
+#!/usr/bin/env python3
+"""The generated tree for the Windows build: like tools/prepare_tree.py, but hard links / copies (symlinks need
+privileges on Windows), only files that changed, and the PCH replaced by the PS4 one (the x86-64 PCH).
+
+Usage: prepare_tree_win.py <generated/default> <out_dir> <PCH script>
+"""
+import os
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+src, out, pch_tool = Path(sys.argv[1]).resolve(), Path(sys.argv[2]).resolve(), Path(sys.argv[3]).resolve()
+PCH = "mp3_pch.h"
+n = 0
+for root, dirs, files in os.walk(src):
+    rel = Path(root).relative_to(src)
+    (out / rel).mkdir(parents=True, exist_ok=True)
+    for f in files:
+        if rel == Path(".") and f == PCH:
+            continue
+        s, d = Path(root) / f, out / rel / f
+        if d.exists() and d.stat().st_size == s.stat().st_size and d.stat().st_mtime >= s.stat().st_mtime:
+            continue
+        if d.exists():
+            d.unlink()
+        try:
+            os.link(s, d)
+        except OSError:
+            shutil.copy2(s, d)
+        n += 1
+subprocess.check_call([sys.executable, "-I", str(pch_tool), str(src / PCH), str(out / PCH)])
+print(f"{n} files placed in {out}")
