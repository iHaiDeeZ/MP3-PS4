+  if (REXCVAR_GET(mp3_renut_hdr_log) && logged.fetch_add(1, std::memory_order_relaxed) < 16)
+    RGPU_INFO("[hdr] small resolve destination {:08X} ({}x{} k_32_FLOAT at {:08X}) pre-filled with 1.0", texture_va,
+              width, height, fetch.BasePage() << 12);
+}
