+        for (u32 x = 0; x < r.width; ++x) {
+          const u32 gx = r.x + x, gy = r.y + y;
+          const u32 at = r.tiled ? TiledOffset2D(gx, gy, r.pitch_blocks, 2) : (gy * r.pitch_blocks + gx) * 4;
+          if (at + 4 > r.extent)
+            continue;
