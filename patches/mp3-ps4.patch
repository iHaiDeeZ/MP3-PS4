+#include <rex/system/interfaces/graphics.h>
+#include <rex/system/xmemory.h>
+#include <rex/ui/presenter.h>
+
+#include "mp3_ps4_menu.h"
+
+#if MP3_RENUT
+namespace renut::gpu {
+void ArmMp3DrawLog(uint32_t frames);  // renut_engine/gpu/render/draw.cpp (v00.39)
+}  // namespace renut::gpu
+#endif
+namespace rex::system {
+void ReapplyThreadSettings();  // xthread.cpp (mp3-ps4 v00.28)
