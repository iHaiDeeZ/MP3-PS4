+// mp3-ps4 (v00.39): the first resolve into a small k_32_FLOAT destination (one QueueResolveReadbackLocked reads
+// back) writes 1.0 into its guest texels at once, on the game thread at the Resolve call. The CPU can read the
+// destination before that resolve's readback lands (a frame or two later: a fence the game waits for completes when
+// the render thread reaches it, not the GPU), and a 0 there can stay in the game's exposure (its log is -inf):
+// the tonemap divides by gAdaptedLum. 1.0 is a neutral luminance (log 0).
+void PrefillResolveDestination(u32 texture_va) {
+  if (!texture_va || !REXCVAR_GET(mp3_renut_resolve_readback))
+    return;
+  const auto *guest = GuestPtr<const d3d::BaseTexture>(texture_va);
+  if (!guest)
