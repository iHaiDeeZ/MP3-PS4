+// mp3-ps4 - the live console (v00.07; the PC build too since v00.14).
+//
+// The user, 2026-11-06: "you can hook yourself to the game, so we know why things are rough". A TCP port on the
+// console (mp3_live_port, 7340, on every interface: the LAN) takes one-line commands while the game runs, so the PC can
+// read what the game is doing and change settings without a new build or a trip through the menu. One client at a time;
+// each answer ends with a line holding a single ".":
+//
+//   stats              frame rate and frame times, the command processor's last [cp] / [mem] lines, the busy threads
+//   get <setting>      a setting's value
+//   set <setting> <v>  changes it (the same as the quick menu: live where the setting is read live)
+//   save               writes the settings to mp3.toml
+//   dump               every thread's stack to hang.log (PS4)
+//   profile [s]        the burst profiler for s seconds (8) to profiles/ (PS4)
+//   shot               the game's last frame (the presenter's guest output) to shots/shot_N.bmp
+//   census [frames]    what the next frames (30) draw with: render targets, textures, resolves, by kind
+//   dumpres            the next frame's resolves as files in dumps/frame_N (index.txt lists them)
+//   trace <hex> [n]    the next n frames (1): every resolve, and every draw reading a texture at that address
+//   pad <b+b..> [ms]   holds pad buttons for ms (150): a b x y start back lb rb lt rt l3 r3 up down left right
+//   stick <x> <y> [ms] holds the left stick (-1..1) for ms (500); look: the right stick
+//   memdump <a> <n>    n bytes of guest physical memory from a (hex both, up to 64 MB) to dumps/mem_*.bin
+//   help, quit
+//
+// The files go to /data/MP3 on the PS4 and next to mp3.exe on the PC. mp3_live turns it off (the quick menu's
+// Diagnostics > Live console).
+//
+// Left out of the build since v00.51 (MP3_LIVE_CONSOLE in mp3_ps4_switches.h): the release does not listen on the
+// LAN, and Start does nothing.
+
+#include "mp3_ps4_live.h"
+
+#include "mp3_ps4_switches.h"
+
+#if MP3_LIVE_CONSOLE
+
+#if defined(_WIN32)
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#include <windows.h>
+#else
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#endif
+
+#include <algorithm>
