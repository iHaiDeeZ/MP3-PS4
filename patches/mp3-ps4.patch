+// mp3-ps4 (v00.35) - what Renut (the MGR port's Direct3D-level renderer, src/renut_engine) needs from its app, for
+// Max Payne 3.
+//
+// MGR's app (mgr-nx-deko's app/mgr_src, src/cpu, src/sa2_capture.cpp) gives Renut the dispatchers at the three
+// Direct3D functions Renut shares with the app (BANJO_RENUT_HOOK_SHARED: Swap, DrawIndexedVertices, DrawVertices,
+// whose app hook decides what runs around Renut's side), the enhancement masters its tuning reads (sa2::enh) and a
+// few stubs for MGR's test recorder. MP3's versions:
+// - Swap (0x83058EA8; MGR 0x826B3510): Renut's presentation, then the per-frame work the SDK's GPU command processor
+//   did at its swap, which Renut replaces: the frame counter and the auto profile (mp3::menu::NoteSwap; its usual
+//   caller, the swap callback 0x83058080, is queued by SynchronizeToPresentationInterval, which Renut replaces too),
+//   and the game threads' layout (rex::system::ReapplyThreadSettingsIfDue: the 5 s re-apply and the 7-core
+//   balancer).
+// - DrawIndexedVertices (0x8304B418; MGR 0x826BCD40) and DrawVertices (0x8304B000; MGR 0x826BC928): Renut's side.
+// - sa2::enh: the two masters from their keys (sa2_cpu_enhancements, sa2_noncpu_enhancements, both on), latched by
+//   Resolve (Mp3App::OnPostInitLogging); no report thread.
+// With another sa2_renderer than "renut" every hook here runs the game's own function.
+
+#include <rex/cvar.h>
+#include <rex/hook.h>
+#include <rex/logging.h>
+#include <rex/system/xmemory.h>
+
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <functional>
+#include <vector>
+
+#include "cpu/sa2_enhancements.h"
+#include "sa2_capture.h"
+#include "renut_engine/gpu/sa2_renut_yield.h"
+
+namespace mp3::menu {
+void NoteSwap();  // mp3/ps4/mp3_ps4_menu.cpp
+}  // namespace mp3::menu
+namespace rex::system {
+void ReapplyThreadSettingsIfDue();  // sdk/src/system/xthread.cpp (mp3-ps4 v00.31, v00.32)
+}  // namespace rex::system
+
+REXCVAR_DEFINE_BOOL(sa2_cpu_enhancements, true, "Renut", "Master switch of Renut's CPU enhancements")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+REXCVAR_DEFINE_BOOL(sa2_noncpu_enhancements, true, "Renut", "Master switch of Renut's GPU enhancements")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+REXCVAR_DEFINE_BOOL(sa2_cpu_verify, false, "Renut",
+                    "Check every renderer fast path against its original implementation (diagnostic)")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+
+// Frames the game presented (Renut's swap pacing and MGR's recorder read it).
+std::atomic<uint64_t> g_sa2_game_frames{0};
+
+namespace sa2::enh {
+
+namespace {
+std::vector<Enhancement*>& List() {
+  static std::vector<Enhancement*> list;
+  return list;
+}
+bool g_cpu_master = false;
+bool g_noncpu_master = false;
+bool g_resolved = false;
+}  // namespace
+
+bool Register(Enhancement* e) {
+  List().push_back(e);
+  return true;
+}
+
+void Resolve() {
+  if (g_resolved) return;
+  g_resolved = true;
+  g_cpu_master = REXCVAR_GET(sa2_cpu_enhancements);
+  g_noncpu_master = REXCVAR_GET(sa2_noncpu_enhancements);
+  for (Enhancement* e : List()) {
+    e->active = e->own() && (e->group == kCpu ? g_cpu_master : g_noncpu_master);
+  }
+  REXLOG_INFO("[renut] enhancements: CPU {}, GPU {}", g_cpu_master ? "on" : "off", g_noncpu_master ? "on" : "off");
+}
+
+bool CpuMaster() { return g_cpu_master; }
+bool NonCpuMaster() { return g_noncpu_master; }
+void StartReport() {}
+void VerifyCheck(uint64_t) {}
+void VerifyDifference() {}
+bool VerifyMode() { return REXCVAR_GET(sa2_cpu_verify); }
+void CodegenChecksInit() {}
+void CodegenChecksReport(int) {}
+void FormsSelfCheck() {}
+void ApplyGpuBoost() {}
+
+bool GuestCodeMatches(const uint8_t* base, uint32_t address, uint32_t bytes, uint64_t fnv, const char* what) {
+  uint64_t hash = 14695981039346656037ull;  // FNV-1a 64
+  for (uint32_t i = 0; i < bytes; ++i) {
+    hash ^= base[address + i];
+    hash *= 1099511628211ull;
+  }
+  if (hash != fnv) {
+    REXLOG_WARN("[renut] the guest code at {:08X} ({}) is not the one this was written from", address, what);
+    return false;
+  }
+  return true;
+}
+
+}  // namespace sa2::enh
+
+namespace sa2::api {
+void Report() {}  // SA2's native Direct3D layer's report line: not in this build
+}  // namespace sa2::api
+
+// The SDK's static GPU plugin loader (gpu_plugin_loader.cpp) calls the Xenos plugin's two entry points by name. This
+// build links no GPU plugin (Renut draws): they answer "none" (LoadGpuPlugin then returns no graphics system; it is
+// not even called, ConfigureRuntime empties gpu_plugin).
+namespace rex::system {
+class IGraphicsSystem;
+struct GpuCreateInfo;
+}  // namespace rex::system
+extern "C" uint32_t rex_gpu_abi_version(void) { return 0; }
+extern "C" rex::system::IGraphicsSystem* rex_gpu_create(uint32_t, const rex::system::GpuCreateInfo*) {
+  return nullptr;
+}
+
+namespace sa2::capture {
+void Start(std::function<rex::ui::Presenter*()>) {}
+void StartWithSource(std::function<bool(rex::ui::RawImage&)>) {}
+bool RenutLockstepOn() { return false; }
+void RenutLockstepFrame(uint64_t, const rex::ui::RawImage*) {}
+void Stop() {}
+void BeforeFlip() {}
+}  // namespace sa2::capture
+
+// D3DDevice_Swap [0x83058EA8; MGR 0x826B3510]
+REX_EXTERN(__imp__sub_83058EA8);
+REX_HOOK_RAW(sub_83058EA8) {
+  if (::banjo::renut_gpu::Active()) {
+    renut_native_sub_83058EA8(ctx, base);
+    g_sa2_game_frames.fetch_add(1, std::memory_order_relaxed);
+    mp3::menu::NoteSwap();
+    rex::system::ReapplyThreadSettingsIfDue();
+    return;
+  }
+  __imp__sub_83058EA8(ctx, base);
+}
+
+// D3D::CDevice::BlockUntilIdle [0x83055A48]: kicks what is pending, waits for the device's fence (both Renut's hooks:
+// the render thread has drained when it returns), then spins - no call, no yield - until device +11152 is 0. That is
+// Direct3D's deferred-batch flag: sub_83055598 sets it when it starts a batch for Direct3D's worker threads (DPC
+// 0x83065500, thread 0x83066380) and only a reset (sub_83060898) clears it, on the console once the GPU has worked
+// through the batch. Renut has no GPU interrupts, so it never came back to 0 and the game's thread spun forever
+// loading the first level (v00.36). When this is called nothing is in flight any more: the flag is cleared first.
+namespace {
+std::atomic<uint32_t> g_idle_clears{0};
+}  // namespace
+REX_EXTERN(__imp__sub_83055A48);
+REX_HOOK_RAW(sub_83055A48) {
+  if (::banjo::renut_gpu::Active()) {
+    auto* pending = reinterpret_cast<uint32_t*>(base + ctx.r3.u32 + 11152);
+    if (const uint32_t value = __builtin_bswap32(*pending)) {
+      *pending = 0;
+      if (g_idle_clears.fetch_add(1, std::memory_order_relaxed) < 8) {
+        REXLOG_INFO("[renut] BlockUntilIdle: Direct3D's deferred-batch flag was {} (no GPU interrupt clears it): "
+                    "cleared", value);
+      }
+    }
+  }
+  __imp__sub_83055A48(ctx, base);
+}
+
+// D3D::CDevice::GpuLoadShaderConstantF4Pointer [0x8304A068] (device, 0 vertex / 1 pixel, first register, address,
+// count): a LOAD_ALU_CONSTANT packet, the GPU loads those float constants from memory when it reaches it. Max
+// Payne 3's three tonemap paths (sub_823E5688 twice, sub_823E39C8) load gAdaptedLum, pixel c88-c91, this way from
+// the adaptation pass's 1x1 resolve, after clearing that group's dirty bit (m_Pending[1] bit 41) so that Direct3D
+// does not send the CPU's copy over it. Renut's ring is a sink: the packet went nowhere, c88 stayed 0 and the
+// tonemap's clamp(1 / c88) burnt every lit pixel white (v00.37-v00.39). Under Renut the device's copy of those
+// constants is loaded here from guest memory (where Renut writes the small k_32_FLOAT resolves back, a frame or two
+// late: mp3_renut_resolve_readback) and their groups are marked dirty again, so the next draw takes them.
+REXCVAR_DEFINE_BOOL(mp3_renut_gpu_constant_loads, true, "Renut",
+                    "Direct3D's GPU-time constant loads (GpuLoadShaderConstantF4Pointer: the tonemap's adapted "
+                    "luminance) are read from guest memory into the device's constants Renut draws with");
+REXCVAR_DECLARE(bool, mp3_renut_hdr_log);  // renut_engine/gpu/render/draw.cpp
+namespace {
+std::atomic<uint32_t> g_gpu_constant_loads{0};
+}  // namespace
+REX_EXTERN(__imp__sub_8304A068);
+REX_HOOK_RAW(sub_8304A068) {
+  if (::banjo::renut_gpu::Active() && REXCVAR_GET(mp3_renut_gpu_constant_loads)) {
+    const uint32_t device = ctx.r3.u32, pixel = ctx.r4.u32 & 1, first = ctx.r5.u32, address = ctx.r6.u32;
+    const uint32_t count = ctx.r7.u32;
+    if (count && first < 256 && count <= 256 - first) {
+      // The device's float constants: m_Constants at +0x480, VertexShaderF +0x300 / PixelShaderF +0x1300 in it
+      // (big-endian, as the guest's memory holds them).
+      uint8_t* constants = rex::memory::GuestPtr(base, device + 0x480 + (pixel ? 0x1300 : 0x300) + first * 16);
+      // The address is a CPU one, in the 4 KB physical view from 0xE0000000 (E4B81000 for the adaptation's 1x1 at
+      // physical 04B82000), which the PS4 SDK maps 0x1000 higher: GuestPtr adds that, as recompiled code does.
+      // v00.40 read base + address, the page before the data: NaN, and a black frame.
+      std::memcpy(constants, rex::memory::GuestPtr(base, address), size_t(count) * 16);
+      // m_Pending[0] / [1] (big-endian): one bit per four registers, bit 63 - group.
+      auto* pending = rex::memory::GuestPtr<uint64_t*>(base, device + (pixel ? 8 : 0));
+      uint64_t mask = 0;
+      for (uint32_t group = first / 4; group <= (first + count - 1) / 4; ++group)
+        mask |= uint64_t(1) << (63 - group);
+      *pending = __builtin_bswap64(__builtin_bswap64(*pending) | mask);
+      const uint32_t n = g_gpu_constant_loads.fetch_add(1, std::memory_order_relaxed);
+      if (REXCVAR_GET(mp3_renut_hdr_log) && (n < 12 || n % 600 == 0)) {
+        float v[4];
+        for (int i = 0; i < 4; ++i) {
+          uint32_t w;
+          std::memcpy(&w, constants + i * 4, 4);
+          w = __builtin_bswap32(w);
+          std::memcpy(&v[i], &w, 4);
+        }
+        // The address the GPU would read (the packet's): the physical page the readback lines name.
+        const uint32_t gpu = (address & 0x1FFFFFFFu) + ((((address >> 20) & 0xFFFu) + 512u) & 0x1000u);
+        REXLOG_INFO("[gpu-load] {} c{}..c{} from {:08X} (physical {:08X}), load {}: c{} = ({:g} {:g} {:g} {:g})",
+                    pixel ? "pixel" : "vertex", first, first + count - 1, address, gpu, n, first, v[0], v[1], v[2],
+                    v[3]);
+      }
+    }
+  }
+  __imp__sub_8304A068(ctx, base);
+}
+
+// D3DDevice_DrawIndexedVertices [0x8304B418; MGR 0x826BCD40]
+REX_EXTERN(__imp__sub_8304B418);
+REX_HOOK_RAW(sub_8304B418) {
+  SA2_RENUT_YIELD_SHARED(sub_8304B418);
+  __imp__sub_8304B418(ctx, base);
+}
+
+// D3DDevice_DrawVertices [0x8304B000; MGR 0x826BC928]
+REX_EXTERN(__imp__sub_8304B000);
+REX_HOOK_RAW(sub_8304B000) {
+  SA2_RENUT_YIELD_SHARED(sub_8304B000);
+  __imp__sub_8304B000(ctx, base);
+}
