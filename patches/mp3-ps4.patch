@@ -0,0 +1,33 @@
+// mp3-ps4 - the L3+R3 quick menu and the frame counter (mp3_ps4_menu.cpp).
+
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <string>
+
+struct ImFontAtlas;
+
+namespace rex::ui {
+class ImGuiDrawer;
+class WindowedAppContext;
+}  // namespace rex::ui
+
+namespace mp3::menu {
+
+// ReXApp::OnConfigureFonts: the menu's typefaces (Lato), baked at the sizes it draws with.
+void AddFonts(ImFontAtlas* atlas);
+
+// ReXApp::OnCreateDialogs, on the UI thread: from here L3+R3 opens the menu. Its settings are saved to 'config'.
+void Attach(rex::ui::WindowedAppContext& context, rex::ui::ImGuiDrawer* drawer, std::filesystem::path config);
+
+// The game's swap callback (mp3_ps4_fps.cpp), on the GPU thread: a frame for the counter, and L3+R3.
+void NoteSwap();
+
+// The game's swaps so far (any thread).
+uint32_t SwapCount();
+
+// The frame rate and the last second's frame times, as one line (the live console's stats).
+std::string StatsText();
+
+}  // namespace mp3::menu
diff --git a/mp3/ps4/mp3_ps4_shader_capture.cpp b/mp3/ps4/mp3_ps4_shader_capture.cpp
new file mode 100644
index 0000000..e87a3d3
--- /dev/null
+++ b/mp3/ps4/mp3_ps4_shader_capture.cpp
@@ -0,0 +1,153 @@
+// mp3-ps4 - captures the game's shader containers for the native renderer's shader library (v00.34).
+//
+// The native renderer (Renut, the MGR port's Direct3D-level renderer) draws with shaders translated ahead of time on
+// the PC (XenosRecomp -> SPIR-V) and finds them by the XXH3-64 of each shader's container. Max Payne 3 keeps its
+// shaders inside its RPF4 archives and creates every one of them at startup, so the first start with this on writes
+// the whole set. The containers are taken where Renut takes them: after Direct3D's XGRegisterVertexShader /
+// XGRegisterPixelShader (0x83053808 / 0x83052950 in the 0.0.6.6 executable; D3DDevice_Create*Shader calls them too),
+// the virtual part inside the shader object (+0x368 vertex, +0x28 pixel) followed by the physical part (r4) - byte for
+// byte what Renut hashes, so the files' names are the keys its library uses.
+//
+// Each new container is written once to /data/MP3/shader_capture/{vs,ps}_<xxh3>.bin by a writer thread (the game's
+// loading thread does not wait for the disk); a file already there from an earlier start is left as it is.
+// mp3_shader_capture (menu: Diagnostics > Capture shaders) turns it off.
+
+#include "mp3_pch.h"
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/system/kernel_state.h>
+#include <rex/system/xmemory.h>
+
+#define XXH_INLINE_ALL
+#include <xxhash.h>
+
+#include <sys/stat.h>
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdio>
+#include <cstring>
+#include <deque>
+#include <mutex>
+#include <thread>
+#include <unordered_set>
+#include <vector>
+
+REXCVAR_DEFINE_BOOL(mp3_shader_capture, true, "MP3",
+                    "Diagnostic: write each shader container the game creates to /data/MP3/shader_capture once "
+                    "(the native renderer's shader library is built from them)");
+
+namespace {
+
+constexpr const char* kCaptureDir = "/data/MP3/shader_capture";
+// Where Direct3D keeps the container in its shader objects (Renut's kVertexShaderContainer / kPixelShaderContainer).
+constexpr uint32_t kVertexShaderContainer = 0x368;
+constexpr uint32_t kPixelShaderContainer = 0x28;
+
+struct Capture {
+  bool pixel;
+  uint64_t hash;
+  std::vector<uint8_t> bytes;
+};
+
+std::mutex g_mutex;
+std::condition_variable g_wake;
+std::deque<Capture> g_queue;
+std::unordered_set<uint64_t> g_seen;
+bool g_writer_started = false;
+std::atomic<uint32_t> g_written{0};
+std::atomic<uint32_t> g_present{0};
+std::atomic<uint32_t> g_rejected{0};
+
+uint32_t LoadBe32(const uint8_t* p) {
+  uint32_t v;
+  std::memcpy(&v, p, 4);
+  return __builtin_bswap32(v);
+}
+
+void WriterMain() {
+  mkdir(kCaptureDir, 0777);
+  for (;;) {
+    Capture capture;
+    {
+      std::unique_lock<std::mutex> lock(g_mutex);
+      g_wake.wait(lock, [] { return !g_queue.empty(); });
+      capture = std::move(g_queue.front());
+      g_queue.pop_front();
+    }
+    char path[128];
+    std::snprintf(path, sizeof(path), "%s/%s_%016llx.bin", kCaptureDir, capture.pixel ? "ps" : "vs",
+                  static_cast<unsigned long long>(capture.hash));
+    if (FILE* existing = std::fopen(path, "rb")) {
+      std::fclose(existing);  // from an earlier start
+      g_present.fetch_add(1, std::memory_order_relaxed);
+      continue;
+    }
+    FILE* f = std::fopen(path, "wb");
+    if (!f) {
+      if (g_rejected.fetch_add(1) < 4) REXLOG_WARN("[shaders] cannot write {}", path);
+      continue;
+    }
+    std::fwrite(capture.bytes.data(), 1, capture.bytes.size(), f);
+    std::fclose(f);
+    const uint32_t n = g_written.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (n <= 4 || n % 100 == 0) {
+      REXLOG_INFO("[shaders] {} containers captured to {} ({} already there; last {} bytes)", n, kCaptureDir,
+                  g_present.load(std::memory_order_relaxed), capture.bytes.size());
+    }
+  }
+}
+
+// After XGRegister*Shader(shader, physical): the container as Renut assembles it (RegisterGuestShader).
+void CaptureShader(uint32_t shader_va, uint32_t physical_va, bool pixel) {
+  if (!REXCVAR_GET(mp3_shader_capture) || !shader_va || !physical_va) return;
+  auto* memory = rex::system::kernel_memory();
+  if (!memory) return;
+  const uint8_t* header =
+      memory->TranslateVirtual<const uint8_t*>(shader_va + (pixel ? kPixelShaderContainer : kVertexShaderContainer));
+  const uint8_t* physical = physical_va < 0x20000000u ? memory->TranslatePhysical<const uint8_t*>(physical_va)
+                                                      : memory->TranslateVirtual<const uint8_t*>(physical_va);
+  if (!header || !physical) return;
+  const uint32_t flags = LoadBe32(header);
+  const uint32_t virtual_size = LoadBe32(header + 4);
+  const uint32_t physical_size = LoadBe32(header + 8);
+  if ((flags & 0xFFFFFF00u) != 0x102A1100u || ((flags & 1) != 0) == pixel || virtual_size < 0x24 ||
+      virtual_size > 0x10000 || physical_size == 0 || physical_size > 0x100000) {
+    if (g_rejected.fetch_add(1) < 8) {
+      REXLOG_WARN("[shaders] XGRegister{}Shader {:08X}: no shader container (flags {:08X}, sizes {} + {})",
+                  pixel ? "Pixel" : "Vertex", shader_va, flags, virtual_size, physical_size);
+    }
+    return;
+  }
+  std::vector<uint8_t> bytes(size_t(virtual_size) + physical_size);
+  std::memcpy(bytes.data(), header, virtual_size);
+  std::memcpy(bytes.data() + virtual_size, physical, physical_size);
+  const uint64_t hash = XXH3_64bits(bytes.data(), bytes.size());
+  std::lock_guard<std::mutex> lock(g_mutex);
+  if (!g_seen.insert(hash).second) return;
+  if (!g_writer_started) {
+    g_writer_started = true;
+    std::thread(WriterMain).detach();
+  }
+  g_queue.push_back({pixel, hash, std::move(bytes)});
+  g_wake.notify_one();
+}
+
+}  // namespace
+
+// void XGRegisterVertexShader(D3DVertexShader* pShader, void* pPhysicalPart) [0x83053808; MGR 0x826ACD00]
+REX_EXTERN(__imp__sub_83053808);
+extern "C" REX_FUNC(sub_83053808) {
+  const uint32_t shader = ctx.r3.u32, physical = ctx.r4.u32;
+  __imp__sub_83053808(ctx, base);
+  CaptureShader(shader, physical, false);
+}
+
+// void XGRegisterPixelShader(D3DPixelShader* pShader, void* pPhysicalPart) [0x83052950; MGR 0x826AC3D8]
+REX_EXTERN(__imp__sub_83052950);
+extern "C" REX_FUNC(sub_83052950) {
+  const uint32_t shader = ctx.r3.u32, physical = ctx.r4.u32;
+  __imp__sub_83052950(ctx, base);
+  CaptureShader(shader, physical, true);
+}
diff --git a/mp3/ps4/mp3_ps4_switches.h b/mp3/ps4/mp3_ps4_switches.h
new file mode 100644
index 0000000..8735cfd
--- /dev/null
+++ b/mp3/ps4/mp3_ps4_switches.h
@@ -0,0 +1,12 @@
+// mp3-ps4 - parts of the port kept in the source but left out of the build (v00.51). The user, 2026-11-08, for the
+// v00.51 release: "Task/Live console, keep their code commented for future". 1 builds a part again.
+
+#pragma once
+
+// The live console (mp3_ps4_live.cpp, v00.07): a TCP port on the LAN (mp3_live_port, 7340) for the PC's
+// tools/live.py: stats, settings, thread dumps, profiles, pad input. Its quick menu row goes with it.
+#define MP3_LIVE_CONSOLE 0
+
+// RAGE's task hooks (mp3_ps4_tasks.cpp, v00.48): the task workers' priority and the Task wait log. The waits were
+// 2-7 % of the main thread's time and a higher priority changed nothing in fights (DESIGN.md, v00.48's run).
+#define MP3_TASK_HOOKS 0
diff --git a/mp3/ps4/mp3_ps4_tasks.cpp b/mp3/ps4/mp3_ps4_tasks.cpp
new file mode 100644
index 0000000..04742b0
--- /dev/null
+++ b/mp3/ps4/mp3_ps4_tasks.cpp
@@ -0,0 +1,158 @@
+// mp3-ps4 (v00.48) - RAGE's task workers, and the waits for them.
+//
+// v00.47's fight at the 30 fps cap (40 live dumps, 2026-11-08): the main thread spent 30 % of its time in the physics
+// (sub_822160C0), half of it blocked, either in RAGE's wait for its tasks (sub_82C995E0: WaitForMultipleObjects on
+// each task's completion event, the time added to a per-thread counter at r13+2288) or in the physics' own loop gated
+// by a semaphore (sub_82F8EEC8), with the task workers mostly idle in the snapshots. A task worker (sub_82C99180, a
+// thread's whole life: wait on the queue's semaphore, take a task from its ring of 256, run it, set its event) runs
+// at the game's normal priority (700), as most game threads do, and the PS4 does not time-slice equal priorities: a
+// woken worker can wait for the thread on its core to block before it starts the task the main thread waits for.
+// - mp3_task_worker_priority: the workers' PS4 priority (XThread::SetHostPriorityOverride, kept by the SDK's 5 s
+//   re-apply), live.
+// - mp3_task_wait_log (Diagnostics): how long each thread waited for tasks, every 10 s and at each change of the
+//   setting above (an A/B state gets its own line).
+// Left out of the build since v00.51 (MP3_TASK_HOOKS in mp3_ps4_switches.h): no fps gain (DESIGN.md, v00.48's run).
+
+#include "mp3_pch.h"
+
+#include "mp3_ps4_switches.h"
+
+#if MP3_TASK_HOOKS
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/system/xthread.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <vector>
+
+REXCVAR_DEFINE_INT32(mp3_task_worker_priority, 0, "MP3",
+                     "PS4 priority of RAGE's task workers (the physics hands them its jobs and the main thread waits "
+                     "for them): 0 = the game's (700, as most game threads); 641-699 = above the other game threads, "
+                     "below the main thread (640)")
+    .range(0, 767);
+
+REXCVAR_DEFINE_BOOL(mp3_task_wait_log, false, "MP3",
+                    "How long each thread waited for RAGE's tasks (sub_82C995E0), in the log every 10 s and at each "
+                    "change of mp3_task_worker_priority");
+
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+std::mutex g_workers_mutex;
+std::vector<rex::system::XThread*> g_workers;  // (they live as long as the game)
+std::atomic<int32_t> g_applied{0};
+
+struct WaitStats {
+  uint32_t thread_id;
+  uint64_t count;
+  uint64_t ns;
+  uint64_t max_ns;
+};
+std::mutex g_stats_mutex;
+std::vector<WaitStats> g_stats;
+Clock::time_point g_since{};
+int32_t g_stats_priority = 0;
+
+// With g_stats_mutex held.
+void FlushStats(Clock::time_point now) {
+  if (g_since != Clock::time_point{}) {
+    const double seconds = std::chrono::duration<double>(now - g_since).count();
+    for (const WaitStats& s : g_stats) {
+      REXLOG_INFO("[tasks] {:.1f} s: thread {:08X} waited for tasks {} times, {:.1f} ms ({:.1f} ms a second), "
+                  "longest {:.2f} ms (task workers at {})",
+                  seconds, s.thread_id, s.count, double(s.ns) / 1e6, double(s.ns) / 1e6 / std::max(seconds, 0.001),
+                  double(s.max_ns) / 1e6,
+                  g_stats_priority >= 256 ? std::to_string(g_stats_priority) : std::string("the game's priority"));
+    }
+  }
+  g_stats.clear();
+  g_since = now;
+}
+
+// The setting followed at each task wait (a compare); the workers that start later take it themselves.
+void FollowWorkerPriority() {
+  const int32_t want = REXCVAR_GET(mp3_task_worker_priority);
+  if (g_applied.load(std::memory_order_relaxed) == want || g_applied.exchange(want) == want) {
+    return;
+  }
+  size_t workers = 0;
+  {
+    std::lock_guard<std::mutex> lock(g_workers_mutex);
+    for (rex::system::XThread* worker : g_workers) {
+      worker->SetHostPriorityOverride(want >= 256 ? want : 0);
+    }
+    workers = g_workers.size();
+  }
+  REXLOG_INFO("[tasks] RAGE's {} task workers at {}", workers,
+              want >= 256 ? fmt::format("priority {}", want) : std::string("the game's priority"));
+  std::lock_guard<std::mutex> lock(g_stats_mutex);
+  FlushStats(Clock::now());
+  g_stats_priority = want;
+}
+
+}  // namespace
+
+// The task worker's whole life (it returns only when the game shuts its task manager down).
+REX_EXTERN(__imp__sub_82C99180);
+REX_HOOK_RAW(sub_82C99180) {
+  if (rex::system::XThread* thread = rex::system::XThread::GetCurrentThread()) {
+    {
+      std::lock_guard<std::mutex> lock(g_workers_mutex);
+      g_workers.push_back(thread);
+    }
+    const int32_t want = g_applied.load();
+    if (want >= 256) {
+      thread->SetHostPriorityOverride(want);
+    }
+    REXLOG_INFO("[tasks] RAGE task worker {:08X} started{}", thread->thread_id(),
+                want >= 256 ? fmt::format(" at priority {}", want) : std::string());
+  }
+  __imp__sub_82C99180(ctx, base);
+}
+
+// RAGE's wait for tasks (r3 tasks at r4, r5 all of them, r6 the timeout).
+REX_EXTERN(__imp__sub_82C995E0);
+REX_HOOK_RAW(sub_82C995E0) {
+  FollowWorkerPriority();
+  if (!REXCVAR_GET(mp3_task_wait_log)) {
+    __imp__sub_82C995E0(ctx, base);
+    return;
+  }
+  const Clock::time_point start = Clock::now();
+  __imp__sub_82C995E0(ctx, base);
+  const Clock::time_point end = Clock::now();
+  const uint64_t ns = uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(end - start).count());
+  rex::system::XThread* thread = rex::system::XThread::GetCurrentThread();
+  const uint32_t id = thread ? thread->thread_id() : 0;
+  std::lock_guard<std::mutex> lock(g_stats_mutex);
+  if (g_since == Clock::time_point{}) {
+    g_since = start;
+    g_stats_priority = g_applied.load();
+  }
+  WaitStats* stats = nullptr;
+  for (WaitStats& s : g_stats) {
+    if (s.thread_id == id) {
+      stats = &s;
+      break;
+    }
+  }
+  if (!stats) {
+    g_stats.push_back({id, 0, 0, 0});
+    stats = &g_stats.back();
+  }
+  ++stats->count;
+  stats->ns += ns;
+  stats->max_ns = std::max(stats->max_ns, ns);
+  if (end - g_since >= std::chrono::seconds(10)) {
+    FlushStats(end);
+  }
+}
+
+#endif  // MP3_TASK_HOOKS
diff --git a/mp3/ps4/mp3_ps4_watchdog.cpp b/mp3/ps4/mp3_ps4_watchdog.cpp
new file mode 100644
index 0000000..b278925
--- /dev/null
+++ b/mp3/ps4/mp3_ps4_watchdog.cpp
@@ -0,0 +1,65 @@
+// mp3-ps4 - the freeze report (v00.06).
+//
+// v00.04 and v00.05 froze, the second time in the main menu after 10 minutes: the game stopped swapping, its main
+// thread waited on a semaphore and its job threads went idle, while the audio and the file threads ran on. The log
+// cannot say which thread holds the rest up. When the game has shown no new frame for 15 s (after it has shown at
+// least 60), this writes the stack of every thread (ps4-kit's thread dump: host return addresses relative to .text,
+// for llvm-symbolizer --obj=<the build's ELF in ~/mp3-build/oelf>; the recompiled guest functions are named sub_XXXXXXXX
+// there) to /data/MP3/hang.log, and once more 30 s later, to see what moved. mp3_freeze_report turns it off.
+
+#include "mp3_ps4_watchdog.h"
+
+#include <chrono>
+#include <cstdint>
+#include <string>
+#include <thread>
+
+#include <ps4_kit_diag.h>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+#include "mp3_ps4_menu.h"
+
+REXCVAR_DEFINE_BOOL(mp3_freeze_report, true, "MP3",
+                    "Diagnostic: when the game shows no new frame for 15 s, the stacks of every thread to "
+                    "/data/MP3/hang.log (again 30 s later)");
+
+namespace mp3::watchdog {
+
+void Start() {
+  std::thread([] {
+    ps4_watch_thread("mp3 freeze watch");
+    const std::string path = std::string(ps4_diag_data_dir()) + "/hang.log";
+    uint32_t last = mp3::menu::SwapCount();
+    auto last_change = std::chrono::steady_clock::now();
+    int dumps = 0;
+    for (;;) {
+      std::this_thread::sleep_for(std::chrono::seconds(1));
+      const uint32_t now_count = mp3::menu::SwapCount();
+      const auto now = std::chrono::steady_clock::now();
+      const double stalled = std::chrono::duration<double>(now - last_change).count();
+      if (now_count != last) {
+        if (dumps) REXLOG_WARN("[freeze] frames again after {:.0f} s ({} thread dumps in {})", stalled, dumps, path);
+        last = now_count;
+        last_change = now;
+        dumps = 0;
+        continue;
+      }
+      if (now_count < 60 || !REXCVAR_GET(mp3_freeze_report)) continue;
+      if ((dumps == 0 && stalled >= 15.0) || (dumps == 1 && stalled >= 45.0)) {
+        ++dumps;
+        const std::string reason =
+            "mp3 freeze report " + std::to_string(dumps) + ": no new frame for " +
+            std::to_string(int(stalled)) + " s after " + std::to_string(now_count) + " frames";
+        REXLOG_WARN("[freeze] no new frame for {:.0f} s: the stacks of every thread to {}", stalled, path);
+        rex::FlushLogging();
+        ps4_dump_thread_stacks(path.c_str(), reason.c_str());
+        REXLOG_WARN("[freeze] thread dump {} written", dumps);
+        rex::FlushLogging();
+      }
+    }
+  }).detach();
+}
+
+}  // namespace mp3::watchdog
diff --git a/mp3/ps4/mp3_ps4_watchdog.h b/mp3/ps4/mp3_ps4_watchdog.h
new file mode 100644
index 0000000..e06c708
--- /dev/null
+++ b/mp3/ps4/mp3_ps4_watchdog.h
@@ -0,0 +1,11 @@
+// mp3-ps4 - the freeze report (mp3_ps4_watchdog.cpp).
+
+#pragma once
+
+namespace mp3::watchdog {
+
+// Once the game is running: a thread that writes every thread's stack to /data/MP3/hang.log when the game stops
+// showing frames.
+void Start();
+
+}  // namespace mp3::watchdog
diff --git a/mp3/renut/cmake/collect_captured_shaders.cmake b/mp3/renut/cmake/collect_captured_shaders.cmake
new file mode 100644
index 0000000..77b772b
--- /dev/null
+++ b/mp3/renut/cmake/collect_captured_shaders.cmake
@@ -0,0 +1,14 @@
+# cmake -DCAPTURE_DIR=<dir> -DDUMP_DIR=<dir> -P collect_captured_shaders.cmake
+# Copies the shader containers reNut captured at runtime (shaders its cache
+# lacked: the game compiles a few itself, which no dump of its files has)
+# into the shader dump directory, each one it does not have yet, so
+# XenosRecomp recompiles them with the rest.
+file(MAKE_DIRECTORY "${DUMP_DIR}")
+file(GLOB captured "${CAPTURE_DIR}/*.bin")
+foreach(source IN LISTS captured)
+    get_filename_component(name "${source}" NAME)
+    if(NOT EXISTS "${DUMP_DIR}/${name}")
+        file(COPY "${source}" DESTINATION "${DUMP_DIR}")
+        message(STATUS "Added captured shader ${name} to ${DUMP_DIR}")
+    endif()
+endforeach()
diff --git a/mp3/renut/mp3_renut.cmake b/mp3/renut/mp3_renut.cmake
new file mode 100644
index 0000000..5f44a55
--- /dev/null
+++ b/mp3/renut/mp3_renut.cmake
@@ -0,0 +1,69 @@
+# mp3-ps4 (v00.35): Renut, the MGR port's Direct3D-level renderer (src/renut_engine: github.com/masterspike52/reNut as
+# banjo-nx, sa2-nx and mgr-nx-deko carry it), for Max Payne 3. From mgr-nx-deko's app/cmake/mgr_renut_gpu.cmake:
+# Renut's gpu.cmake with this folder as its app folder (RENUT_APP_DIR: thirdparty/plume, thirdparty/reblue-XenosRecomp,
+# thirdparty/imgui = a link to the SDK's, src/ = Renut and the glue it includes), the shader cache made on the PC from
+# the containers the console captured (BANJO_RENUT_SHADER_CACHE_CPP, from scripts/build-mp3.sh), and an OBJECT library:
+# its hooks replace the generated code's weak sub_X definitions, which a static archive's members would not.
+#
+# Included by mp3/ps4/CMakeLists.txt when MP3_RENUT is on; links into `mp3`.
+
+set(RENUT_APP_DIR "${CMAKE_CURRENT_LIST_DIR}")
+
+set(BANJO_RENUT_SHADER_CACHE_CPP "" CACHE FILEPATH "Renut's shader cache (XenosRecomp's shader_cache.cpp)")
+if(NOT EXISTS "${BANJO_RENUT_SHADER_CACHE_CPP}")
+    message(FATAL_ERROR "MP3_RENUT: no shader cache at '${BANJO_RENUT_SHADER_CACHE_CPP}' (translate the captured "
+                        "containers with XenosRecomp first)")
+endif()
+# XenosRecomp is a host tool: the cache comes ready, as MGR's PS4 build does it.
+function(banjo_renut_shader_cache_override TARGET)
+    target_sources(${TARGET} PRIVATE "${BANJO_RENUT_SHADER_CACHE_CPP}")
+    set_source_files_properties("${BANJO_RENUT_SHADER_CACHE_CPP}" PROPERTIES GENERATED TRUE SKIP_PRECOMPILE_HEADERS ON)
+endfunction()
+set(RENUT_SHADER_DUMP_DIR "$ENV{HOME}/mp3-build/shaders/containers" CACHE PATH "MP3's captured shader containers")
+set(RENUT_ASSETS_DIR "${RENUT_APP_DIR}/assets" CACHE PATH "Unused: no shader dump step in this build")
+
+# Renut's SDK exports o1heap as rex::o1heap.
+if(TARGET o1heap AND NOT TARGET rex::o1heap)
+    add_library(rex::o1heap ALIAS o1heap)
+endif()
+if(NOT Python3_EXECUTABLE)
+    find_package(Python3 COMPONENTS Interpreter REQUIRED)
+endif()
+if(NOT PYTHON_EXECUTABLE)
+    set(PYTHON_EXECUTABLE "${Python3_EXECUTABLE}")
+endif()
+
+include("${RENUT_APP_DIR}/src/renut_engine/gpu/gpu.cmake")
+
+add_library(mp3_renut_gpu OBJECT
+    "${RENUT_APP_DIR}/src/renut_engine/gpu/banjo_renut_select.cpp"
+    "${RENUT_APP_DIR}/src/renut_engine/gpu/banjo_renut_tuning.cpp"
+    "${RENUT_APP_DIR}/src/renut_engine/gpu/banjo_renut_checks.cpp"
+    "${RENUT_APP_DIR}/src/renut_engine/gpu/banjo_renut_record.cpp"
+    "${RENUT_APP_DIR}/src/renut_engine/display_sync.cpp"
+    "${RENUT_APP_DIR}/src/renut_engine/perf/frame_stats.cpp"
+    "${RENUT_APP_DIR}/src/renut_engine/sa2_compat/frame_latency.cpp"
+    "${RENUT_APP_DIR}/src/renut_engine/sa2_compat/sa2_compat.cpp"
+    "${RENUT_APP_DIR}/src/renut_engine/gpu/sa2_renut_pacing.cpp"
+    # MGR's app pieces Renut includes: the render resolution per mode (portable), and MP3's glue.
+    "${RENUT_APP_DIR}/src/me/sa2_render_mode.cpp"
+    "${RENUT_APP_DIR}/src/mp3_renut_glue.cpp")
+target_include_directories(mp3_renut_gpu PRIVATE
+    "${RENUT_APP_DIR}"
+    "${RENUT_APP_DIR}/src"
+    "${RENUT_APP_DIR}/src/renut_engine/sa2_compat"
+    "${MP3_TREE}"
+    "${REXSDK_DIR}/src/core")
+target_link_libraries(mp3_renut_gpu PRIVATE rex::runtime)
+if(COMMAND rexglue_apply_target_settings)
+    rexglue_apply_target_settings(mp3_renut_gpu)
+endif()
+renut_gpu_setup(mp3_renut_gpu)
+target_compile_definitions(mp3_renut_gpu PRIVATE MGR_RENUT_RENDERER=1 SA2_RENUT_RENDERER=1)
+target_compile_options(mp3_renut_gpu PRIVATE -ffp-contract=off -fno-strict-aliasing)
+# plume's PS4 path includes ps4-kit's WSI header (ps4_vk_wsi.h).
+target_include_directories(plume PUBLIC "${PS4_KIT_DIR}/gpu")
+
+target_link_libraries(mp3 PRIVATE mp3_renut_gpu)
