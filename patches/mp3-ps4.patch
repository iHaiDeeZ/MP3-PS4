+        info("Build", fmt::format("v{}  ·  {}", MP3_VERSION, MP3_COMMIT));
+        info("Game", "Xbox 360, Title Update 6 (0.0.6.6)");
+        info("CPU", "PowerPC recompiled to x86-64");
+#if MP3_RENUT
+        info("GPU", "Direct3D-level renderer (Renut) on Vulkan (RADV)");
