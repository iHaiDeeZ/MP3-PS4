+// mp3-ps4 (v00.38): small colour resolves back to guest memory, for the CPU. A resolve writes host textures only, so
+// the CPU read what the memory held before (0). Max Payne 3's CPU reads its luminance chain (k_32_FLOAT resolves, 64x64
+// down to 8x1, and the adapted luminance) and sets the tonemap's exposure constants from it (mp3-nx PORTING.md runs
+// 13-20; on the SDK path readback_resolve fast, v00.09). Each k_32_FLOAT resolve of up to kResolveReadbackBytes is
+// copied to the slot's readback buffer and written to guest memory when the slot's fence is waited
+// (CompleteMemExportsLocked), a frame or two late: tiled and in the destination's endian as the console's copy writes
+// it, with the copy's exponents (HostTexture::resolve_exp).
+namespace {
+
+constexpr uint64_t kResolveReadbackBytes = 64u << 10;
+constexpr uint64_t kResolveReadbackBuffer = 4u << 20;
+
+struct ResolveReadback {
+  u32 base = 0;    // physical address of the destination's base level
+  u32 extent = 0;  // its bytes
+  u32 offset = 0;  // in the slot's readback buffer
+  u32 x = 0, y = 0, width = 0, height = 0;
+  u32 pitch_blocks = 0;
+  bool tiled = false;
+  u32 endian = 0;
+  int exp = 0;
+};
+
+struct SlotReadbacks {
+  std::unique_ptr<plume::RenderBuffer> buffer;
+  uint64_t capacity = 0;
+  uint64_t used = 0;
+  std::vector<ResolveReadback> pending;
+};
