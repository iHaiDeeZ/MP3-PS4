+// mp3-ps4 - the L3+R3 quick menu and the frame counter (the user, 2026-11-06: "add quick menu similar to mgr but
+// recreate it with better looking menu").
+//
+// MGR's menu (mgr_ps4_menu.cpp) is an ImGui window of radio buttons in the SDK's font. This one keeps its behaviour
+// (L3+R3 opens and closes it, Circle closes it, the settings are saved to the configuration file on close, the game
+// gets a neutral pad until the closing buttons are released, the burst profiler starts after it closes) and draws its
+// own console-style panel with ImGui's draw lists:
+//
+//   - a side panel that slides in from the left over the dimmed game, in Lato (OFL, fonts/), baked at the sizes it is
+//     drawn at with the TV's density (the SDK's ImGui canvas is 1280x720 on a 1920x1080 output, and its renderer
+//     keeps a fixed font atlas, so a scaled font would be blurry);
+//   - tabs (L1/R1), rows of settings moved through with the D-pad: a choice changes with left/right, a switch and an
+//     action with Cross; the selected row's description below, with a "next start" tag for the settings that only
+//     apply on a restart; the buttons' hints at the bottom;
+//   - the frame counter in a corner: the game's frames a second (its swaps, mp3_D3D_SwapCallback), with the frame
+//     times and a graph of the last 120 in the detailed mode.
+//
+// The dialog exists only while the menu is open, the counter is on, or the "saved" note shows: with no dialog the
+// presenter paints from the game's thread at once, with one it paints on the UI thread (presenter.cpp's paint modes).
+// The L3+R3 press comes from the pad driver (PS4InputDriver::TakeMenuCombo), checked at each of the game's frames.
+
+#include "mp3_ps4_menu.h"
+#include "mp3_ps4_switches.h"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <functional>
+#include <memory>
+#include <string>
+#include <thread>
+#include <utility>
+#include <vector>
+
+#include <imgui.h>
+
+#include <ps4_kit_diag.h>
+
+#include <rex/cvar.h>
+#include <rex/input/ps4/ps4_input_driver.h>
+#include <rex/logging.h>
+#include <rex/ui/imgui_dialog.h>
+#include <rex/ui/imgui_drawer.h>
+#include <rex/ui/windowed_app_context.h>
+
+#ifndef MP3_VERSION
+#define MP3_VERSION "ps4"
+#endif
+#ifndef MP3_COMMIT
+#define MP3_COMMIT "unknown"
+#endif
+
+REXCVAR_DEFINE_INT32(mp3_frame_counter, 0, "MP3",
+                     "PS4: the frame counter: 0 = off, 1 = frames a second, 2 = with the frame times and a graph")
+    .range(0, 2);
+REXCVAR_DEFINE_INT32(mp3_frame_counter_corner, 0, "MP3", "PS4: the frame counter's corner: 0 = top left, 1 = top right")
+    .range(0, 1);
+REXCVAR_DEFINE_BOOL(mp3_auto_profile, true, "MP3",
+                    "Diagnostic: once a session, the first time the game stays under mp3_auto_profile_fps for "
+                    "mp3_auto_profile_s seconds, record an 8 s CPU profile of every thread (/data/MP3/profiles)");
+// v00.32: 6 for 10 s (it was 15 for 20 s, the command processor's own limit in fights: the deep stretches went unseen).
+REXCVAR_DEFINE_INT32(mp3_auto_profile_fps, 6, "MP3", "Diagnostic, mp3_auto_profile: under this many frames a second")
+    .range(1, 60);
+REXCVAR_DEFINE_INT32(mp3_auto_profile_s, 10, "MP3", "Diagnostic, mp3_auto_profile: for this many seconds in a row")
+    .range(1, 600);
+
+namespace mp3::menu {
+
+namespace {
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Fonts.
+
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wc23-extensions"
+const unsigned char kLatoRegular[] = {
+#embed "fonts/Lato-Regular.ttf"
+};
+const unsigned char kLatoBlack[] = {
+#embed "fonts/Lato-Black.ttf"
+};
+#pragma clang diagnostic pop
+
+// The sizes on the 720-line canvas.
+struct Fonts {
+  ImFont* title = nullptr;    // Black 40, capitals and digits only
+  ImFont* tab = nullptr;      // Black 15
+  ImFont* row = nullptr;      // Regular 18
+  ImFont* value = nullptr;    // Black 16
+  ImFont* body = nullptr;     // Regular 14
+  ImFont* counter = nullptr;  // Black 26
+  ImFont* small = nullptr;    // Regular 12
+};
+Fonts g_fonts;
+
+// The canvas's pixels on the TV (FisicoALogico in imgui_drawer.cpp: 720 logical lines on 1080).
+constexpr float kDensity = 1080.0f / 720.0f;
+
+ImFont* AddLato(ImFontAtlas* atlas, const unsigned char* data, size_t size, float pixels, const ImWchar* ranges) {
+  ImFontConfig config;
+  config.FontDataOwnedByAtlas = false;
+  config.RasterizerDensity = kDensity;
+  config.OversampleH = 2;
+  config.OversampleV = 1;
+  return atlas->AddFontFromMemoryTTF(const_cast<unsigned char*>(data), int(size), pixels, &config, ranges);
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Frame times: the game's swaps, written on the GPU thread, read on the UI thread.
+
+constexpr uint32_t kRing = 256;
+std::array<std::atomic<uint64_t>, kRing> g_swap_ns{};
+std::atomic<uint32_t> g_swaps{0};
+
+uint64_t NowNs() {
+  return uint64_t(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch())
+          .count());
+}
+
+struct FrameStats {
+  float fps = 0.0f;
+  float frame_ms = 0.0f;
+  float worst_ms = 0.0f;
+  std::vector<float> history;  // the last frames' times, oldest first
+};
+
+FrameStats ReadStats(size_t history) {
+  FrameStats stats;
+  const uint32_t count = g_swaps.load(std::memory_order_acquire);
+  const uint32_t have = std::min(count, kRing);
+  if (have < 2) return stats;
+  std::vector<uint64_t> times(have);
+  for (uint32_t i = 0; i < have; ++i) {
+    times[i] = g_swap_ns[(count - have + i) % kRing].load(std::memory_order_relaxed);
+  }
+  const uint64_t now = NowNs();
+  // Frames in the last second (none if the game has not swapped for a second: a load or a stall).
+  uint32_t in_second = 0;
+  double sum_ms = 0.0;
+  float worst = 0.0f;
+  for (uint32_t i = have - 1; i > 0; --i) {
+    if (times[i] < times[i - 1] || now - times[i] > 1'000'000'000ull) break;
+    const float ms = float(double(times[i] - times[i - 1]) / 1e6);
+    ++in_second;
+    sum_ms += ms;
+    worst = std::max(worst, ms);
+  }
+  if (in_second) {
+    stats.frame_ms = float(sum_ms / in_second);
+    stats.fps = stats.frame_ms > 0.0f ? 1000.0f / stats.frame_ms : 0.0f;
+    stats.worst_ms = worst;
+  }
+  const size_t n = std::min<size_t>(history, have - 1);
+  stats.history.reserve(n);
+  for (size_t i = have - n; i < have; ++i) {
+    stats.history.push_back(times[i] >= times[i - 1] ? float(double(times[i] - times[i - 1]) / 1e6) : 0.0f);
+  }
+  return stats;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Look.
+
+constexpr ImU32 kPanel = IM_COL32(11, 11, 13, 246);
+constexpr ImU32 kAccent = IM_COL32(200, 32, 44, 255);
+constexpr ImU32 kText = IM_COL32(238, 238, 240, 255);
+constexpr ImU32 kDim = IM_COL32(146, 146, 152, 255);
+constexpr ImU32 kFaint = IM_COL32(78, 78, 84, 255);
+constexpr ImU32 kLine = IM_COL32(255, 255, 255, 22);
+constexpr ImU32 kAmber = IM_COL32(232, 168, 56, 255);
+constexpr ImU32 kGood = IM_COL32(110, 226, 120, 255);
+constexpr ImU32 kFair = IM_COL32(240, 206, 90, 255);
+constexpr ImU32 kBad = IM_COL32(240, 104, 96, 255);
+
+ImU32 WithAlpha(ImU32 colour, float alpha) {
+  const uint32_t a = uint32_t(std::clamp(alpha, 0.0f, 1.0f) * float((colour >> IM_COL32_A_SHIFT) & 0xFF) + 0.5f);
+  return (colour & ~IM_COL32_A_MASK) | (a << IM_COL32_A_SHIFT);
+}
+
+ImU32 FpsColour(float fps) { return fps >= 57.0f ? kGood : fps >= 28.0f ? kFair : kBad; }
+
+float EaseOut(float t) {
+  t = std::clamp(t, 0.0f, 1.0f);
+  return 1.0f - (1.0f - t) * (1.0f - t) * (1.0f - t);
+}
+
+ImVec2 TextSize(ImFont* font, const char* text) { return font->CalcTextSizeA(font->LegacySize, FLT_MAX, 0.0f, text); }
+
+void Text(ImDrawList* draw, ImFont* font, ImVec2 pos, ImU32 colour, const char* text, float wrap = 0.0f) {
+  draw->AddText(font, font->LegacySize, pos, colour, text, nullptr, wrap);
+}
+
+// The DualShock 4's button marks for the hints, drawn (no glyphs needed).
+enum class Mark { kCross, kCircle, kDpadVertical, kDpadHorizontal };
+
+float DrawMark(ImDrawList* draw, Mark mark, ImVec2 centre, float r, float alpha) {
+  const ImU32 ring = WithAlpha(kDim, alpha);
+  switch (mark) {
+    case Mark::kCross: {
+      draw->AddCircle(centre, r, ring, 24, 1.4f);
+      const float k = r * 0.42f;
+      const ImU32 c = WithAlpha(IM_COL32(124, 166, 232, 255), alpha);
+      draw->AddLine(ImVec2(centre.x - k, centre.y - k), ImVec2(centre.x + k, centre.y + k), c, 1.8f);
+      draw->AddLine(ImVec2(centre.x - k, centre.y + k), ImVec2(centre.x + k, centre.y - k), c, 1.8f);
+      break;
+    }
+    case Mark::kCircle:
+      draw->AddCircle(centre, r, ring, 24, 1.4f);
+      draw->AddCircle(centre, r * 0.46f, WithAlpha(IM_COL32(236, 104, 104, 255), alpha), 20, 1.8f);
+      break;
+    case Mark::kDpadVertical:
+    case Mark::kDpadHorizontal: {
+      draw->AddCircle(centre, r, ring, 24, 1.4f);
+      const float a = r * 0.36f, b = r * 0.62f;
+      const ImU32 c = WithAlpha(kText, alpha);
+      if (mark == Mark::kDpadVertical) {
+        draw->AddTriangleFilled(ImVec2(centre.x, centre.y - b), ImVec2(centre.x - a, centre.y - b + a),
+                                ImVec2(centre.x + a, centre.y - b + a), c);
+        draw->AddTriangleFilled(ImVec2(centre.x, centre.y + b), ImVec2(centre.x + a, centre.y + b - a),
+                                ImVec2(centre.x - a, centre.y + b - a), c);
+      } else {
+        draw->AddTriangleFilled(ImVec2(centre.x - b, centre.y), ImVec2(centre.x - b + a, centre.y + a),
+                                ImVec2(centre.x - b + a, centre.y - a), c);
+        draw->AddTriangleFilled(ImVec2(centre.x + b, centre.y), ImVec2(centre.x + b - a, centre.y - a),
+                                ImVec2(centre.x + b - a, centre.y + a), c);
+      }
+      break;
+    }
+  }
+  return r * 2.0f;
+}
+
+// A shoulder button's label in a rounded box ("L1"); returns its width.
+float DrawKeyCap(ImDrawList* draw, const char* label, ImVec2 pos, float height, float alpha) {
+  ImFont* font = g_fonts.small;
+  const ImVec2 size = TextSize(font, label);
+  const float w = std::max(height * 1.5f, size.x + height * 0.7f);
+  draw->AddRect(pos, ImVec2(pos.x + w, pos.y + height), WithAlpha(kDim, alpha), height * 0.3f, 0, 1.3f);
+  Text(draw, font, ImVec2(pos.x + (w - size.x) * 0.5f, pos.y + (height - size.y) * 0.5f), WithAlpha(kText, alpha),
+       label);
+  return w;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// The settings.
+
+void SetCvar(const char* name, const std::string& value) {
+  if (!rex::cvar::SetFlagByName(name, value)) REXLOG_WARN("[menu] could not set {} = {}", name, value);
+}
+
+struct Row {
+  enum class Kind { kChoice, kSwitch, kAction, kInfo };
+  Kind kind = Kind::kInfo;
+  std::string label;
+  std::string help;
+  bool restart = false;                // takes effect on the next start
+  std::vector<std::string> options;    // kChoice
+  std::function<int()> get;            // kChoice: the option; kSwitch: 0/1
+  std::function<void(int)> set;
+  std::function<void()> run;           // kAction
+  std::string info;                    // kInfo: the value shown
+};
+
+constexpr double kProfileSeconds = 8.0;
+constexpr const char* kTabs[] = {"VIDEO", "OVERLAY", "DIAGNOSTICS", "ABOUT"};
+constexpr int kTabCount = 4;
+
+// The pad buttons that, held when the menu closes, would reach the game as a press.
+constexpr ImGuiKey kHeldKeys[] = {
+    ImGuiKey_GamepadFaceDown, ImGuiKey_GamepadFaceRight, ImGuiKey_GamepadFaceUp,   ImGuiKey_GamepadFaceLeft,
+    ImGuiKey_GamepadDpadUp,   ImGuiKey_GamepadDpadDown,  ImGuiKey_GamepadDpadLeft, ImGuiKey_GamepadDpadRight,
+    ImGuiKey_GamepadL1,       ImGuiKey_GamepadR1,        ImGuiKey_GamepadL3,       ImGuiKey_GamepadR3,
+    ImGuiKey_GamepadStart,    ImGuiKey_GamepadBack,
+};
+
+bool AnyButtonDown() {
+  for (const ImGuiKey key : kHeldKeys) {
+    if (ImGui::IsKeyDown(key)) return true;
+  }
+  return false;
+}
+
+// The menu's own repaints (ImGuiDrawer::SetContinuousRepaint(false)): 60 a second while it animates or has the pad,
+// from a ticker thread that asks the UI thread; otherwise the overlay is repainted with the game's frames.
+std::atomic<bool> g_animating{false};
+
+void StartRepaintTicker();
+
+// L3+R3 presses the pad driver reports while the menu is open, or as it closes, are the menu's own.
+std::atomic<bool> g_menu_owns_combo{false};
+std::atomic<uint64_t> g_combo_quiet_until_ns{0};
+
+class QuickMenu;
+
+struct State {
+  rex::ui::WindowedAppContext* context = nullptr;
+  rex::ui::ImGuiDrawer* drawer = nullptr;
+  std::filesystem::path config;
+  QuickMenu* dialog = nullptr;  // UI thread only (made in Dialog, deleted in ReleaseLater)
+};
+State g_state;
+
+void Open();
+void ReleaseLater();
+
+class QuickMenu final : public rex::ui::ImGuiDialog {
+ public:
+  explicit QuickMenu(rex::ui::ImGuiDrawer* drawer) : ImGuiDialog(drawer) {}
+
+  void Show() {
+    if (phase_ == Phase::kOpen || phase_ == Phase::kOpening) return;
+    phase_ = Phase::kOpening;
+    combo_held_ = true;  // the L3+R3 that opened it is still down
+    jump_ = true;
+    dirty_ = false;
+    g_menu_owns_combo = true;
+    REXLOG_INFO("[menu] opened (L3+R3)");
+  }
+
+  // Nothing left to draw: the dialog can go.
+  bool Idle() const {
+    return phase_ == Phase::kClosed && REXCVAR_GET(mp3_frame_counter) <= 0 && toast_left_ <= 0.0f &&
+           !start_profile_ && ps4_profile_running() == 0;
+  }
+
+ protected:
+  void OnDraw(ImGuiIO& io) override {
+    const float dt = std::clamp(io.DeltaTime, 0.0f, 0.1f);
+    const bool combo = ImGui::IsKeyDown(ImGuiKey_GamepadL3) && ImGui::IsKeyDown(ImGuiKey_GamepadR3);
+    if (combo && !combo_held_ && (phase_ == Phase::kOpen || phase_ == Phase::kOpening)) Close();
+    combo_held_ = combo;
+
+    // The slide: 0.2 s in, 0.14 s out.
+    if (phase_ == Phase::kOpening) {
+      open_ = std::min(1.0f, open_ + dt / 0.20f);
+      if (open_ >= 1.0f) phase_ = Phase::kOpen;
+    } else if (phase_ == Phase::kClosing) {
+      open_ = std::max(0.0f, open_ - dt / 0.14f);
+      if (open_ <= 0.0f) phase_ = AnyButtonDown() ? Phase::kReleasing : Phase::kClosed;
+    } else if (phase_ == Phase::kReleasing && !AnyButtonDown()) {
+      phase_ = Phase::kClosed;
+    }
+    if (phase_ == Phase::kClosed && g_menu_owns_combo.exchange(false)) {
+      g_combo_quiet_until_ns = NowNs() + 400'000'000ull;
+    }
+    if (start_profile_ && phase_ == Phase::kClosed) {
+      start_profile_ = false;
+      ps4_profile_set_enabled(1);
+      const bool started = ps4_profile_start(kProfileSeconds, "quick menu");
+      REXLOG_INFO("[menu] CPU profile of {:.0f} s {}", kProfileSeconds, started ? "started" : "not started");
+    }
+
+    const bool visible = phase_ == Phase::kOpening || phase_ == Phase::kOpen || phase_ == Phase::kClosing;
+    if (visible) {
+      DrawMenu(io, dt);
+    } else if (phase_ == Phase::kReleasing) {
+      HoldFocus();
+    }
+    DrawCounter(io, visible);
+    DrawToast(io, dt);
+    g_animating.store(phase_ != Phase::kClosed || toast_left_ > 0.0f, std::memory_order_relaxed);
+    if (Idle()) ReleaseLater();
+  }
+
+ private:
+  enum class Phase { kClosed, kOpening, kOpen, kClosing, kReleasing };
+
+  void Close() {
+    if (phase_ != Phase::kOpen && phase_ != Phase::kOpening) return;
+    phase_ = Phase::kClosing;
+    rex::cvar::SaveConfig(g_state.config);
+    if (dirty_) toast_left_ = 2.2f;
+    REXLOG_INFO("[menu] closed{}: 60 fps {} ({}), frame counter {}, long-wait log {}", dirty_ ? ", settings saved" : "",
+                rex::cvar::Query<bool>("mp3_60fps"), rex::cvar::Query<std::string>("mp3_60fps_mode"),
+                REXCVAR_GET(mp3_frame_counter), rex::cvar::Query<bool>("kernel_wait_report"));
+  }
+
+  std::vector<Row> BuildRows(int tab) {
+    std::vector<Row> rows;
+    const bool vblank_mode = rex::cvar::Query<std::string>("mp3_60fps_mode") == "vblank";
+    switch (tab) {
+      case 0: {
+        Row fps;
+        fps.kind = Row::Kind::kChoice;
+        fps.label = "Frame rate";
+        fps.options = {"30 FPS  (Xbox 360)", "60 FPS"};
+        fps.get = [] { return rex::cvar::Query<bool>("mp3_60fps") ? 1 : 0; };
+        fps.set = [](int v) { SetCvar("mp3_60fps", v ? "true" : "false"); };
+        fps.restart = vblank_mode;
+        fps.help =
+            "60 FPS lets Direct3D show each frame on the next refresh instead of every second one. The game times "
+            "its frames with the clock, so it keeps its speed.";
+        rows.push_back(std::move(fps));
+
+        Row method;
+        method.kind = Row::Kind::kChoice;
+        method.label = "60 FPS method";
+        method.options = {"Present interval", "120 Hz vblank"};
+        method.get = [] { return rex::cvar::Query<std::string>("mp3_60fps_mode") == "vblank" ? 1 : 0; };
+        method.set = [](int v) { SetCvar("mp3_60fps_mode", v ? "vblank" : "interval"); };
+        method.restart = true;
+        method.help =
+            "Present interval changes the wait in the game's swap callback (the default). 120 Hz vblank doubles "
+            "the console's vertical blank instead: the other way, for comparison.";
+        rows.push_back(std::move(method));
+
+        Row occlusion;
+        occlusion.kind = Row::Kind::kChoice;
+        occlusion.label = "Light occlusion";
+        occlusion.options = {"Fixed  (fast)", "GPU queries  (slow)"};
+        occlusion.get = [] { return rex::cvar::Query<bool>("mp3_occlusion_queries") ? 1 : 0; };
+        occlusion.set = [](int v) { SetCvar("mp3_occlusion_queries", v ? "true" : "false"); };
+        occlusion.restart = true;
+        occlusion.help =
+            "The game asks the GPU whether lights and coronas are hidden. Answering for real waits for the whole "
+            "GPU at every question (3-4 FPS in v00.03); Fixed answers \"visible\" at once.";
+        rows.push_back(std::move(occlusion));
+
+        Row memexport;
+        memexport.kind = Row::Kind::kChoice;
+        memexport.label = "GPU particle readback";
+        memexport.options = {"Off  (may freeze)", "On"};
+        memexport.get = [] { return rex::cvar::Query<bool>("mp3_memexport_readback") ? 1 : 0; };
+        memexport.set = [](int v) { SetCvar("mp3_memexport_readback", v ? "true" : "false"); };
+        memexport.restart = true;
+        memexport.help =
+            "Copies what the game's GPU shaders write to memory back to the CPU, from the previous frame so nothing "
+            "waits. Off froze v00.04 as gameplay began.";
+        rows.push_back(std::move(memexport));
+        break;
+      }
+      case 1: {
+        Row counter;
+        counter.kind = Row::Kind::kChoice;
+        counter.label = "Frame counter";
+        counter.options = {"Off", "FPS", "Detailed"};
+        counter.get = [] { return int(REXCVAR_GET(mp3_frame_counter)); };
+        counter.set = [](int v) { SetCvar("mp3_frame_counter", std::to_string(v)); };
+        counter.help =
+            "The game's frames a second, counted at its swaps. Detailed adds the average and worst frame time of "
+            "the last second, and a graph of the last 120 frames.";
+        rows.push_back(std::move(counter));
+
+        Row corner;
+        corner.kind = Row::Kind::kChoice;
+        corner.label = "Position";
+        corner.options = {"Top left", "Top right"};
+        corner.get = [] { return int(REXCVAR_GET(mp3_frame_counter_corner)); };
+        corner.set = [](int v) { SetCvar("mp3_frame_counter_corner", std::to_string(v)); };
+        corner.help = "Where the frame counter sits on the screen.";
+        rows.push_back(std::move(corner));
+        break;
+      }
+      case 2: {
+        Row waits;
+        waits.kind = Row::Kind::kSwitch;
+        waits.label = "Long-wait log";
+        waits.get = [] { return rex::cvar::Query<bool>("kernel_wait_report") ? 1 : 0; };
+        waits.set = [](int v) { SetCvar("kernel_wait_report", v ? "true" : "false"); };
+        waits.help = fmt::format(
+            "Every {} s, writes the game threads that have waited 2 s or more to the log in {}/logs: what to send "
+            "when the game stops.",
+            rex::cvar::Query<int32_t>("kernel_wait_report_s"), ps4_diag_data_dir());
+        rows.push_back(std::move(waits));
+
+        Row profile;
+        profile.kind = Row::Kind::kAction;
+        profile.label = "Record a CPU profile";
+        profile.run = [this] {
+          start_profile_ = true;
+          Close();
+        };
+        profile.help = fmt::format(
+            "Closes the menu, then samples every thread for {:.0f} s of play and writes the result to {}/profiles.",
+            kProfileSeconds, ps4_diag_data_dir());
+        rows.push_back(std::move(profile));
+
+        Row autop;
+        autop.kind = Row::Kind::kSwitch;
+        autop.label = "Profile slow gameplay";
+        autop.get = [] { return REXCVAR_GET(mp3_auto_profile) ? 1 : 0; };
+        autop.set = [](int v) { SetCvar("mp3_auto_profile", v ? "true" : "false"); };
+        autop.help = fmt::format(
+            "Once a session, the first time the game stays under {} FPS for {} s, records an {:.0f} s CPU profile "
+            "to {}/profiles on its own.",
+            REXCVAR_GET(mp3_auto_profile_fps), REXCVAR_GET(mp3_auto_profile_s), kProfileSeconds,
+            ps4_diag_data_dir());
+        rows.push_back(std::move(autop));
+
+        // v00.34: the native renderer's shader library is built from these (mp3_ps4_shader_capture.cpp).
+        Row capture;
+        capture.kind = Row::Kind::kSwitch;
+        capture.label = "Capture shaders";
+        capture.get = [] { return rex::cvar::Query<bool>("mp3_shader_capture") ? 1 : 0; };
+        capture.set = [](int v) { SetCvar("mp3_shader_capture", v ? "true" : "false"); };
+        capture.help = fmt::format(
+            "Writes each shader the game creates to {}/shader_capture, once (the game makes them all at startup): "
+            "the native renderer's shader library is built from them.",
+            ps4_diag_data_dir());
+        rows.push_back(std::move(capture));
