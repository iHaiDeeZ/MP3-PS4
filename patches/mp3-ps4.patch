+extern "C" size_t rex_gpu_census_text(char* out, size_t size);
+#endif
+
+REXCVAR_DEFINE_BOOL(mp3_live, true, "MP3",
+                    "Diagnostic: the live console, a TCP port on the console for the PC (stats, settings, thread dumps, "
+                    "profiles while the game runs)");
+REXCVAR_DEFINE_INT32(mp3_live_port, 7340, "MP3", "Diagnostic: the live console's TCP port").range(1024, 65535);
+
+namespace mp3::live {
+
+namespace {
+
+#if defined(_WIN32)
+using Socket = SOCKET;
+constexpr Socket kNoSocket = INVALID_SOCKET;
+void CloseSocket(Socket s) { closesocket(s); }
+int SocketError() { return WSAGetLastError(); }
+#else
+using Socket = int;
+constexpr Socket kNoSocket = -1;
+void CloseSocket(Socket s) { close(s); }
+int SocketError() { return errno; }
+#endif
+
+std::filesystem::path g_config;
+rex::Runtime* g_runtime = nullptr;
+
+// Where the files go: /data/MP3 on the PS4, the executable's folder on the PC.
+std::filesystem::path DataDir() {
+#if defined(__PS4__)
+  return ps4_diag_data_dir();
+#else
+  return rex::filesystem::GetExecutableFolder();
+#endif
+}
+
+// The GPU plugin's diagnostics: linked in on the PS4; on Windows the plugin is a DLL, found by name.
+struct GpuDiag {
+  size_t (*stats_text)(char*, size_t) = nullptr;
+  void (*census_start)(uint32_t) = nullptr;
+  size_t (*census_text)(char*, size_t) = nullptr;
+  void (*resdump_start)(const char*) = nullptr;
+  int (*resdump_done)() = nullptr;
+  void (*trace_start)(uint32_t, uint32_t) = nullptr;
+  size_t (*trace_text)(char*, size_t) = nullptr;
+};
+
+const GpuDiag& Gpu() {
+  static GpuDiag diag;
+  static bool found = false;
+  if (found) return diag;
+#if defined(_WIN32)
+  HMODULE module = nullptr;
+  for (const char* name : {"rexgpu-xenosrd.dll", "rexgpu-xenos.dll", "rexgpu-xenosd.dll"}) {
+    if ((module = GetModuleHandleA(name))) break;
+  }
+  if (!module) return diag;  // not loaded yet: look again next time
+  auto get = [module](auto& fn, const char* name) {
+    fn = reinterpret_cast<std::remove_reference_t<decltype(fn)>>(reinterpret_cast<void*>(GetProcAddress(module, name)));
+  };
+  get(diag.stats_text, "rex_gpu_stats_text");
+  get(diag.census_start, "rex_gpu_census_start");
+  get(diag.census_text, "rex_gpu_census_text");
+  get(diag.resdump_start, "rex_gpu_resdump_start");
+  get(diag.resdump_done, "rex_gpu_resdump_done");
+  get(diag.trace_start, "rex_gpu_trace_start");
+  get(diag.trace_text, "rex_gpu_trace_text");
+#elif MP3_RENUT
+  // v00.35: Renut's build has no SDK GPU: none of its diagnostics.
+  diag = {};
+#else
+  diag = {rex_gpu_stats_text, rex_gpu_census_start, rex_gpu_census_text, rex_gpu_resdump_start,
+          rex_gpu_resdump_done, rex_gpu_trace_start, rex_gpu_trace_text};
+#endif
+  found = true;
+  return diag;
+}
+
+// The game's last frame as a 24-bit BMP (bottom-up BGR rows): what is on the screen under the overlay.
+std::string Shot() {
+  auto* graphics = g_runtime ? g_runtime->graphics_system() : nullptr;
+  rex::ui::Presenter* presenter = graphics ? graphics->presenter() : nullptr;
+  if (!presenter) return "no presenter\n";
+  rex::ui::RawImage image;
+  if (!presenter->CaptureGuestOutput(image) || !image.width || !image.height) {
+    return "no frame captured (no guest output yet)\n";
+  }
+  const std::filesystem::path dir = DataDir() / "shots";
+  std::error_code ec;
+  std::filesystem::create_directories(dir, ec);
+  static int counter = 0;
+  std::filesystem::path path;
+  do {
+    path = dir / ("shot_" + std::to_string(++counter) + ".bmp");
+  } while (std::filesystem::exists(path, ec) && counter < 100000);
+  const uint32_t w = image.width, h = image.height;
+  const uint32_t row = (w * 3 + 3) & ~3u;
+  const uint32_t data_size = row * h, file_size = 54 + data_size;
+  uint8_t header[54] = {'B', 'M'};
+  auto put32 = [&](int at, uint32_t v) {
+    for (int i = 0; i < 4; ++i) header[at + i] = uint8_t(v >> (8 * i));
+  };
+  put32(2, file_size);
+  put32(10, 54);
+  put32(14, 40);
+  put32(18, w);
+  put32(22, h);
+  header[26] = 1;
+  header[28] = 24;
+  put32(34, data_size);
+  FILE* f = std::fopen(path.string().c_str(), "wb");
+  if (!f) return "cannot write " + path.string() + "\n";
+  std::fwrite(header, 1, sizeof(header), f);
+  std::string line(row, '\0');
+  for (uint32_t y = 0; y < h; ++y) {
+    const uint8_t* src = image.data.data() + size_t(h - 1 - y) * image.stride;  // R8 G8 B8 X8
+    for (uint32_t x = 0; x < w; ++x) {
+      line[x * 3 + 0] = char(src[x * 4 + 2]);
+      line[x * 3 + 1] = char(src[x * 4 + 1]);
+      line[x * 3 + 2] = char(src[x * 4 + 0]);
+    }
+    std::fwrite(line.data(), 1, row, f);
+  }
+  std::fclose(f);
+  REXLOG_INFO("[live] frame {}x{} to {}", w, h, path.string());
+  return path.string() + " (" + std::to_string(w) + "x" + std::to_string(h) + ")\n";
+}
+
+void Send(Socket fd, const std::string& text) {
+  size_t done = 0;
+  while (done < text.size()) {
+    const int n = int(send(fd, text.data() + done, int(std::min<size_t>(text.size() - done, 1 << 20)), 0));
+    if (n <= 0) return;
+    done += size_t(n);
+  }
+}
+
+std::string Stats() {
+  std::string out = mp3::menu::StatsText() + "\n";
+  char gpu[1024] = {};
+  if (Gpu().stats_text) Gpu().stats_text(gpu, sizeof(gpu));
+  out += gpu[0] ? std::string(gpu) : std::string("[cp] no figures yet (gpu_stats_log, every gpu_stats_log_s seconds)");
+  out += "\n";
+#if defined(__PS4__)
+  // v00.33: the core balancer's figures (the kit's busy report never saw these threads).
+  out += "[cores] " + rex::system::CoreLoadsText() + "\n";
+#endif
+  return out;
+}
+
+// "a+start" -> the XINPUT_GAMEPAD button bits (and the triggers, which are axes).
+bool ParseButtons(const std::string& names, uint16_t* buttons, uint8_t* lt, uint8_t* rt) {
+  static const std::pair<const char*, uint16_t> kNames[] = {
+      {"up", 0x0001},    {"down", 0x0002},  {"left", 0x0004}, {"right", 0x0008}, {"start", 0x0010},
+      {"back", 0x0020},  {"l3", 0x0040},    {"r3", 0x0080},   {"lb", 0x0100},    {"rb", 0x0200},
+      {"guide", 0x0400}, {"a", 0x1000},     {"b", 0x2000},    {"x", 0x4000},     {"y", 0x8000}};
+  *buttons = 0;
+  *lt = *rt = 0;
+  size_t at = 0;
+  while (at <= names.size()) {
+    const size_t plus = std::min(names.find('+', at), names.size());
+    const std::string name = names.substr(at, plus - at);
+    at = plus + 1;
+    if (name.empty()) continue;
+    if (name == "lt") {
+      *lt = 0xFF;
+      continue;
+    }
+    if (name == "rt") {
+      *rt = 0xFF;
+      continue;
+    }
+    bool known = false;
+    for (const auto& [n, bit] : kNames) {
+      if (name == n) {
+        *buttons |= bit;
+        known = true;
+      }
+    }
+    if (!known) return false;
+  }
+  return true;
+}
+
+// Holds a pad state for ms, then lets go.
+void Hold(const rex::input::X_INPUT_GAMEPAD& pad, int ms) {
+  rex::input::SetInjectedGamepad(pad);
+  std::this_thread::sleep_for(std::chrono::milliseconds(std::clamp(ms, 1, 60000)));
+  rex::input::SetInjectedGamepad(rex::input::X_INPUT_GAMEPAD{});
+}
+
+int16_t Axis(double v) { return int16_t(std::lround(std::clamp(v, -1.0, 1.0) * 32767.0)); }
+
+std::string Run(const std::string& line, bool* quit) {
+  std::string cmd = line, rest;
+  const size_t sp = line.find(' ');
+  if (sp != std::string::npos) {
+    cmd = line.substr(0, sp);
+    rest = line.substr(sp + 1);
+  }
+  if (cmd == "help") {
+    return "stats | get <setting> | set <setting> <value> | save | dump | profile [s] | shot | census [frames] | "
+           "dumpres | trace <hex address> [frames] | pad <a+b..> [ms] | stick <x> <y> [ms] | look <x> <y> [ms] | "
+           "memdump <hex address> <hex length> | threads | waits [ms] | drawlog [frames] (Renut) | "
+           "quit\n";
+  }
+  if (cmd == "stats") return Stats();
+  if (cmd == "get") return rest + " = " + rex::cvar::GetFlagByName(rest) + "\n";
+  if (cmd == "set") {
+    const size_t sp2 = rest.find(' ');
+    if (sp2 == std::string::npos) return "set <setting> <value>\n";
+    const std::string name = rest.substr(0, sp2), value = rest.substr(sp2 + 1);
+    const bool ok = rex::cvar::SetFlagByName(name, value);
+    REXLOG_INFO("[live] set {} = {}{}", name, value, ok ? "" : " (refused)");
+    if (ok && (name == "ignore_thread_priorities" || name == "ignore_thread_affinities" ||
+               name == "ps4_game_cores" || name == "ps4_service_thread_priority")) {
+      rex::system::ReapplyThreadSettings();  // to the running threads
+    }
+    return ok ? name + " = " + rex::cvar::GetFlagByName(name) + "\n" : "refused: " + name + "\n";
+  }
+  if (cmd == "save") {
+    rex::cvar::SaveConfig(g_config);
+    return "saved to " + g_config.string() + "\n";
+  }
+#if defined(__PS4__)
+  if (cmd == "dump") {
+    const std::string path = std::string(ps4_diag_data_dir()) + "/hang.log";
+    REXLOG_INFO("[live] thread dump to {}", path);
+    ps4_dump_thread_stacks(path.c_str(), "mp3 live console: dump");
+    return "written to " + path + "\n";
+  }
+  if (cmd == "profile") {
+    const double seconds = rest.empty() ? 8.0 : std::atof(rest.c_str());
+    ps4_profile_set_enabled(1);
+    const bool started = ps4_profile_start(seconds > 0 ? seconds : 8.0, "live console");
+    REXLOG_INFO("[live] CPU profile of {:.0f} s {}", seconds, started ? "started" : "not started");
+    return started ? std::string("profile started: ") + ps4_diag_data_dir() + "/profiles\n"
+                   : "not started (one is running)\n";
+  }
+#else
+  if (cmd == "dump" || cmd == "profile") return cmd + ": PS4 only (use a debugger / profiler on the PC)\n";
+#endif
+  if (cmd == "pad") {
+    std::string names = rest;
+    int ms = 150;
+    if (const size_t sp2 = rest.find(' '); sp2 != std::string::npos) {
+      names = rest.substr(0, sp2);
+      ms = std::atoi(rest.c_str() + sp2 + 1);
+    }
+    rex::input::X_INPUT_GAMEPAD pad{};
+    uint16_t buttons;
+    uint8_t lt, rt;
+    if (!ParseButtons(names, &buttons, &lt, &rt)) return "pad: unknown button in '" + names + "'\n";
+    pad.buttons = buttons;
+    pad.left_trigger = lt;
+    pad.right_trigger = rt;
+    Hold(pad, ms);
+    return "pad " + names + " " + std::to_string(ms) + " ms\n";
+  }
+  if (cmd == "stick" || cmd == "look") {
+    double x = 0, y = 0;
+    int ms = 500;
+    if (std::sscanf(rest.c_str(), "%lf %lf %d", &x, &y, &ms) < 2) return cmd + " <x> <y> [ms]\n";
+    rex::input::X_INPUT_GAMEPAD pad{};
+    if (cmd == "stick") {
+      pad.thumb_lx = Axis(x);
+      pad.thumb_ly = Axis(y);
+    } else {
+      pad.thumb_rx = Axis(x);
+      pad.thumb_ry = Axis(y);
+    }
+    Hold(pad, ms);
+    return cmd + " " + std::to_string(x) + " " + std::to_string(y) + " " + std::to_string(ms) + " ms\n";
+  }
+  if (cmd == "memdump") {
+    // The guest's physical memory as it is now (a texture's data, read on the PC with the fetch constant's layout).
+    // Only ranges the game uses: an uncommitted page would fault.
+    unsigned address = 0, length = 0;
+    if (std::sscanf(rest.c_str(), "%x %x", &address, &length) != 2 || !length || length > (64u << 20) ||
+        uint64_t(address) + length > (512ull << 20)) {
+      return "memdump <hex physical address> <hex length> (up to 64 MB, below 512 MB)\n";
+    }
+    rex::memory::Memory* memory = g_runtime ? g_runtime->memory() : nullptr;
+    if (!memory) return "no guest memory\n";
+    const std::filesystem::path dir = DataDir() / "dumps";
+    std::error_code ec;
+    std::filesystem::create_directories(dir, ec);
+    char name[64];
+    std::snprintf(name, sizeof(name), "mem_%08X_%X.bin", address, length);
+    const std::filesystem::path path = dir / name;
+    FILE* f = std::fopen(path.string().c_str(), "wb");
+    if (!f) return "cannot write " + path.string() + "\n";
+    std::fwrite(memory->TranslatePhysical<const uint8_t*>(address), 1, length, f);
+    std::fclose(f);
+    REXLOG_INFO("[live] {:X} bytes of guest memory at {:08X} to {}", length, address, path.string());
+    return path.string() + "\n";
+  }
+  if (cmd == "shot") return Shot();
+  if (cmd == "threads") return rex::system::ThreadsText();
+#if MP3_RENUT
+  if (cmd == "drawlog") {
+    const unsigned frames = std::clamp(rest.empty() ? 1u : unsigned(std::strtoul(rest.c_str(), nullptr, 10)), 1u, 4u);
+    renut::gpu::ArmMp3DrawLog(frames);
+    return "drawlog: every draw of the next " + std::to_string(frames) + " frame(s) goes to the log ([mp3draw])\n";
+  }
+#endif
+  if (cmd == "waits") return rex::system::wait_report::ReportText(rest.empty() ? 0 : strtoull(rest.c_str(), nullptr, 10));
+  if (cmd == "trace") {
+    if (!Gpu().trace_start || !Gpu().trace_text) return "trace: not in this GPU backend\n";
+    const uint32_t address = uint32_t(std::strtoul(rest.c_str(), nullptr, 16));
+    const size_t sp2 = rest.find(' ');
+    const int frames = sp2 == std::string::npos ? 1 : std::max(1, std::atoi(rest.c_str() + sp2 + 1));
+    Gpu().trace_start(address, uint32_t(frames));
+    std::string text(1024 * 1024, '\0');
+    for (int i = 0; i < 600; ++i) {  // up to 60 s
+      std::this_thread::sleep_for(std::chrono::milliseconds(100));
+      const size_t n = Gpu().trace_text(text.data(), text.size());
+      if (n) {
+        text.resize(std::min(n, text.size() - 1));
+        return text;
+      }
+    }
+    return "trace: no frames in 60 s\n";
+  }
+  if (cmd == "dumpres") {
+    if (!Gpu().resdump_start || !Gpu().resdump_done) return "dumpres: not in this GPU backend\n";
+    static int dump_counter = 0;
+    std::error_code ec;
+    std::filesystem::path dir;
+    do {
+      dir = DataDir() / "dumps" / ("frame_" + std::to_string(++dump_counter));
+    } while (std::filesystem::exists(dir, ec) && dump_counter < 100000);
+    std::filesystem::create_directories(dir, ec);
+    Gpu().resdump_start(dir.string().c_str());
+    for (int i = 0; i < 600; ++i) {  // up to 60 s
+      std::this_thread::sleep_for(std::chrono::milliseconds(100));
+      if (i > 2 && Gpu().resdump_done()) return "resolves of one frame in " + dir.string() + "\n";
+    }
+    return "dumpres: not finished in 60 s\n";
+  }
+  if (cmd == "census") {
+    if (!Gpu().census_start || !Gpu().census_text) return "census: not in this GPU backend\n";
+    const int frames = rest.empty() ? 30 : std::max(1, std::atoi(rest.c_str()));
+    Gpu().census_start(uint32_t(frames));
+    std::string text(256 * 1024, '\0');
+    for (int i = 0; i < 600; ++i) {  // up to 60 s
+      std::this_thread::sleep_for(std::chrono::milliseconds(100));
+      const size_t n = Gpu().census_text(text.data(), text.size());
+      if (n) {
+        text.resize(std::min(n, text.size() - 1));
+        return text;
+      }
+    }
+    return "census: no frames in 60 s\n";
+  }
+  if (cmd == "quit") {
+    *quit = true;
+    return "bye\n";
+  }
+  return "unknown: " + cmd + " (help)\n";
+}
+
+void Serve(Socket client) {
+  Send(client, "mp3-ps4 live console (help)\n.\n");
+  std::string buffer;
+  char chunk[512];
+  for (;;) {
+    const int n = int(recv(client, chunk, int(sizeof(chunk)), 0));
+    if (n <= 0) return;
+    buffer.append(chunk, size_t(n));
+    size_t eol;
+    while ((eol = buffer.find('\n')) != std::string::npos) {
+      std::string line = buffer.substr(0, eol);
+      buffer.erase(0, eol + 1);
+      while (!line.empty() && (line.back() == '\r' || line.back() == ' ')) line.pop_back();
+      if (line.empty()) continue;
+      bool quit = false;
+      Send(client, Run(line, &quit) + ".\n");
+      if (quit) return;
+    }
+    if (buffer.size() > 4096) return;
+  }
+}
+
+}  // namespace
+
+void Start(rex::Runtime* runtime, std::filesystem::path config) {
+  g_runtime = runtime;
+  g_config = std::move(config);
+  if (!REXCVAR_GET(mp3_live)) {
+    REXLOG_INFO("[live] the live console is off (mp3_live)");
+    return;
+  }
+  std::thread([] {
+#if defined(__PS4__)
+    ps4_watch_thread("mp3 live console");
+#endif
+#if defined(_WIN32)
+    WSADATA wsa;
+    if (WSAStartup(MAKEWORD(2, 2), &wsa) != 0) {
+      REXLOG_WARN("[live] WSAStartup failed");
+      return;
+    }
+#endif
+    const int port = REXCVAR_GET(mp3_live_port);
+    const Socket server = socket(AF_INET, SOCK_STREAM, 0);
+    if (server == kNoSocket) {
+      REXLOG_WARN("[live] socket failed ({})", SocketError());
+      return;
+    }
+    const int one = 1;
+    setsockopt(server, SOL_SOCKET, SO_REUSEADDR, reinterpret_cast<const char*>(&one), sizeof(one));
+    sockaddr_in address{};
+    address.sin_family = AF_INET;
+    address.sin_port = htons(uint16_t(port));
+#if defined(__PS4__)
+    address.sin_addr.s_addr = htonl(INADDR_ANY);  // the LAN: the PC connects to the console
+#else
+    address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);  // the PC build: this PC only
+#endif
+    if (bind(server, reinterpret_cast<sockaddr*>(&address), sizeof(address)) != 0 || listen(server, 1) != 0) {
+      REXLOG_WARN("[live] port {} not opened ({})", port, SocketError());
+      CloseSocket(server);
+      return;
+    }
+    REXLOG_INFO("[live] the live console listens on port {}", port);
+    for (;;) {
+      sockaddr_in peer{};
+      socklen_t peer_size = sizeof(peer);
+      const Socket client = accept(server, reinterpret_cast<sockaddr*>(&peer), &peer_size);
+      if (client == kNoSocket) {
+        std::this_thread::sleep_for(std::chrono::seconds(1));
+        continue;
+      }
+      char who[32] = "?";
+      inet_ntop(AF_INET, &peer.sin_addr, who, sizeof(who));
+      REXLOG_INFO("[live] {} connected", who);
+      Serve(client);
+      CloseSocket(client);
+      REXLOG_INFO("[live] {} left", who);
+    }
+  }).detach();
+}
+
+}  // namespace mp3::live
+
+#else  // !MP3_LIVE_CONSOLE
+
+namespace mp3::live {
+
+void Start(rex::Runtime*, std::filesystem::path) {}
+
+}  // namespace mp3::live
+
+#endif  // MP3_LIVE_CONSOLE
