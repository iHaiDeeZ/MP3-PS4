@@ -0,0 +1,33 @@
+#!/usr/bin/env python3
+"""mp3-ps4 (v00.47): the guest's register + displacement accesses take the 0xE0000000 heap's host offset from the
+base register: REX_LOAD_U32_B(L_r31.u32, 448) for REX_LOAD_U32(L_r31.u32 + 448), so the compiler checks a pointer
+once for every access through it instead of once per access.
+
+On the PS4 the 0xE0000000 heap sits 4 KiB further in host memory (REX_PHYS_HOST_OFFSET, make_ps4_pch.py a), and the
+check was four x86 instructions on every guest load and store (xor, cmp, setae, shl: ~13 % of the converted code,
+and registers spilled to hold the offsets): the register + displacement form is ~707,000 of the game's ~805,000
+accesses (the stack's, r1, are already REX_SLOAD/REX_SSTORE without it: patch_stack_access.py). A base register and
+the address it reaches lie on the same side of 0xE0000000 unless an object straddles two of the console's views,
+which its memory map does not allow (the 0xC0000000 view ends there; the 0xE0000000 one starts at physical 0x1000);
+the one constant 0xE0000000 in the game (lis r8,-8192 in sub_823A2F28) only takes part in a comparison. Indexed
+(register + register) accesses keep the check on the whole address. The macros: make_ps4_pch.py e.
+
+Run after patch_local_regs.py (it reads the generated text). Idempotent. Usage: patch_phys_base.py <generated .cpp>
+"""
+import re
+import sys
+
+PATTERN = re.compile(r"REX_(LOAD|STORE)_U(8|16|32|64)\((L_r\d+\.u32) \+ (-?\d+)([,)])")
+
+files = sites = 0
+for path in sys.argv[1:]:
+    text = open(path, encoding="utf-8").read()
+    new, n = PATTERN.subn(lambda m: f"REX_{m.group(1)}_U{m.group(2)}_B({m.group(3)}, {m.group(4)}{m.group(5)}", text)
+    if not n:
+        continue
+    with open(path, "w", encoding="utf-8", newline="\n") as f:
+        f.write(new)
+    files += 1
+    sites += n
+print(f"patch_phys_base: {sites} register + displacement accesses take the heap offset from their base register "
+      f"in {files} files")
