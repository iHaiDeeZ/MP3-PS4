+#if MP3_RENUT
+        // v00.40: the native renderer's HDR log (v00.37-v00.39's white frames).
+        Row hdr;
+        hdr.kind = Row::Kind::kSwitch;
+        hdr.label = "Renderer HDR log";
+        hdr.get = [] { return rex::cvar::Query<bool>("mp3_renut_hdr_log") ? 1 : 0; };
+        hdr.set = [](int v) { SetCvar("mp3_renut_hdr_log", v ? "true" : "false"); };
+        hdr.help = fmt::format(
+            "Writes what the native renderer's tonemap and luminance passes read to the log in {}/logs: what to "
+            "send when the picture is too bright or too dark.",
+            ps4_diag_data_dir());
+        rows.push_back(std::move(hdr));
+#endif
+
+#if MP3_TASK_HOOKS  // v00.51: left out (mp3_ps4_switches.h)
+        // v00.48: the threads' waits for RAGE's tasks (mp3_ps4_tasks.cpp).
+        Row tasks;
+        tasks.kind = Row::Kind::kSwitch;
+        tasks.label = "Task wait log";
+        tasks.get = [] { return rex::cvar::Query<bool>("mp3_task_wait_log") ? 1 : 0; };
+        tasks.set = [](int v) { SetCvar("mp3_task_wait_log", v ? "true" : "false"); };
+        tasks.help = fmt::format(
+            "Writes to the log in {}/logs, every 10 seconds, how long the game's threads waited for its "
+            "background tasks (the physics' jobs): what to send when busy scenes are slow.",
+            ps4_diag_data_dir());
+        rows.push_back(std::move(tasks));
