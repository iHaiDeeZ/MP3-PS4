+HostSurface *MultisampleTwinLocked(const HostSurface *surface) {
+  if (!surface || surface->depth || surface->samples != plume::RenderSampleCount::COUNT_4)
+    return nullptr;
+  uint64_t own = 0;
+  bool found = false;
+  for (const auto &[key, target] : g_targets) {
+    if (target.get() == surface) {
+      own = key;
+      found = true;
+      break;
+    }
+  }
+  if (!found)
+    return nullptr;
+  // TargetKey: EDRAM base 0-11, pitch 12-25, msaa 26-27 (0 = 1x), depth 28, scale 29-31, host format above.
+  const uint64_t pitch = (own >> 12) & 0x3FFF;
+  const uint64_t rest = own & ~((uint64_t(0x3FFF) << 12) | (uint64_t(3) << 26));
+  for (const uint64_t twin_pitch : {pitch * 2, pitch}) {
+    if (twin_pitch > 0x3FFF)
+      continue;
+    const auto it = g_targets.find(rest | (twin_pitch << 12));
+    if (it != g_targets.end() && it->second && it->second->texture && !it->second->depth &&
+        it->second->samples == plume::RenderSampleCount::COUNT_1 && it->second->width >= surface->width * 2 &&
+        it->second->height >= surface->height * 2)
+      return it->second.get();
+  }
+  return nullptr;
+}
